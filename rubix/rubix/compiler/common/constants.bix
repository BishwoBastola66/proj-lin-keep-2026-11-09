# constants.bix - target architecture IDs, ELF machine types, and compiler sentinels

# Target architecture identifiers
let TARGET_X86_64    = 1;
let TARGET_ARM64     = 2;
let TARGET_RISCV64   = 3;
let TARGET_WINDOWS   = 5;
let TARGET_MACOS     = 6;
let TARGET_WASM      = 7;
let TARGET_POLYGLOT  = 8;
let TARGET_SYNTHETIC = 99;

# ISA Identifiers
let ISA_X86_64    = 1;
let ISA_AARCH64   = 2;
let ISA_RISCV64   = 3;
let ISA_WASM32    = 4;
let ISA_SYNTHETIC = 99;

# Hardware Vendor Identifiers
let VENDOR_UNKNOWN = 0;
