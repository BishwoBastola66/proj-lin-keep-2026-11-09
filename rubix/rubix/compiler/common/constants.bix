# EIA In-Memory Displacement Hole Relocation Table
let TBL_EIA_HOLE_COUNT_QWORD_IDX  = 2000000; # slot at 16,000,000 bytes
let TBL_EIA_HOLE_BASE_OFFSET      = 16000008;
let TBL_EIA_HOLE_ENTRY_SIZE       = 32; # 4 qwords: patch_pos, struct_id, field_hash, resolved_offset
let TBL_EIA_HOLE_MAX_CAPACITY     = 65536;

# EIA Runtime Boot & Relocation Global State Page (0x70000000)
let EIA_STATE_PAGE = 1879048192; # 0x70000000

fn eia_state_init() {
    let p = sys_mmap(EIA_STATE_PAGE, 4096, 3, 34, -1, 0);
    if p != EIA_STATE_PAGE {
        sys_munmap(p, 4096);
    }
}

fn eia_publish_tbl(tbl: i64) {
    eia_state_init();
    set_qword(EIA_STATE_PAGE, 1, tbl);
    set_qword(EIA_STATE_PAGE, 2, 1);
}

fn eia_get_tbl(): i64 {
    eia_state_init();
    return get_qword(EIA_STATE_PAGE, 1);
}

fn eia_get_tbl_valid(): i64 {
    eia_state_init();
    let v = get_qword(EIA_STATE_PAGE, 2);
    if v != 0 { return 1; }
    if get_qword(EIA_STATE_PAGE, 1) != 0 { return 1; }
    return 1; # EIA displacement hole emission is active by default
}

fn eia_set_target_layout(path: i64) {
    eia_state_init();
    set_qword(EIA_STATE_PAGE, 3, path);
}

fn eia_get_target_layout(): i64 {
    eia_state_init();
    return get_qword(EIA_STATE_PAGE, 3);
}

fn eia_set_emit_schema(v: i64) {
    eia_state_init();
    set_qword(EIA_STATE_PAGE, 4, v);
}

fn eia_get_emit_schema(): i64 {
    eia_state_init();
    return get_qword(EIA_STATE_PAGE, 4);
}

fn eia_set_mode(v: i64) {
    eia_state_init();
    set_qword(EIA_STATE_PAGE, 5, v);
}

fn eia_get_mode(): i64 {
    eia_state_init();
    return get_qword(EIA_STATE_PAGE, 5);
}


