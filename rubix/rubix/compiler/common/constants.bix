let ABI_WASI           = 6;

# Environment / Libc Flavors
let ENV_NONE = 0;
let ENV_GNU  = 1;
let ENV_MUSL = 2;
let ENV_MSVC = 3;

# Object Container Formats
let FORMAT_ELF64    = 1;
