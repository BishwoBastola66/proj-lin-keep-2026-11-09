# 8. LNGA: Synaptic Ring Buffer & 5 Autonomic Reflex Arcs
# ------------------------------------------------------------------------------
fn test_lnga(): i64 {
    let ring = sys_mmap(0, 8192, 3, 34, -1, 0);
    let event_type = 1; # ArenaExhaustion
    let payload = 42;
    let descriptor = (event_type * 1000000000) + payload;

    set_qword(ring, 0, descriptor);
    let polled = get_qword(ring, 0);

    let extracted_arc = polled / 1000000000;
    let extracted_payload = polled % 1000000000;

    if extracted_arc != 1 { return 801; }
    if extracted_payload != 42 { return 802; }
    return 0;
}

