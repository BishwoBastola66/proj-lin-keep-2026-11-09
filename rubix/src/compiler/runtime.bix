# --- Architectural Subsystem: runtime/eia.bix ---
# ==============================================================================
# RUBIX ETERNAL INTERFACE ARCHITECTURE (EIA / EIA-OMEGA)
# Master Architectural Implementation: Post-ABI Universal Holograms, DVAM & ARLL-Agent
# ==============================================================================

# Target ISA Bitmasks
let ISA_X86_64  = 1;
let ISA_AARCH64 = 2;
let ISA_RISCV64 = 4;

# Capability Permission Bitmasks
let CAP_READ    = 1;
let CAP_WRITE   = 2;
let CAP_EXEC    = 4;
let CAP_SEALED  = 8;

# Universal Hologram Magic Constants
let EIA_MAGIC_HOLO       = 1145653573;          # 'EIAH' packed (0x44484945)
let EIA_MAGIC_HOLO2      = 5208200276632731973; # 'EIAHOLO2' packed

# Host Operating System IDs
let EIA_HOST_OS_LINUX    = 1;
let EIA_HOST_OS_WINDOWS  = 2;
let EIA_HOST_OS_MACOS    = 3;
let EIA_HOST_OS_BARE     = 4;

# Calling Convention Identifiers
let EIA_CALLING_CONV_SYSV   = 1; # System V AMD64 (rdi, rsi, rdx, rcx, r8, r9)
let EIA_CALLING_CONV_WIN64  = 2; # Microsoft x64 (rcx, rdx, r8, r9)
let EIA_CALLING_CONV_ARM64  = 3; # ARM64 AAPCS (x0..x7)
let EIA_CALLING_CONV_RV64   = 4; # RISC-V LP64 (a0..a7)

# Sovereign Generic System Call IDs
let EIA_SYS_READ          = 0;
let EIA_SYS_WRITE         = 1;
let EIA_SYS_OPEN          = 2;
let EIA_SYS_CLOSE         = 3;
let EIA_SYS_MMAP          = 9;
let EIA_SYS_MPROTECT      = 10;
let EIA_SYS_EXIT          = 60;
let EIA_SYS_CLOCK_GETTIME = 228;

# Master EIA Universal Hologram Header (96 bytes — 12 x i64 fields)
# Layout is stable: new fields appended after is_valid so older loaders
# can still verify magic/version without knowing the extended fields.
struct HologramHeader {
    magic: i64,                # 0x00  'EIAH' packed magic
    version_major: i64,        # 0x08  must be 2
    version_minor: i64,        # 0x10  minor version
    target_isa: i64,           # 0x18  ISA bitmask (x86|ARM|RV)
    symbol_count: i64,         # 0x20  entries in symbol table
    hole_count: i64,           # 0x28  relocation hole records
    is_valid: i64,             # 0x30  1 = header verified
    capability_req_mask: i64,  # 0x38  CHERI/CCNS capability bits required at load
    symbol_table_offset: i64,  # 0x40  byte offset from binary base to SymbolContract[]
    hole_table_offset: i64,    # 0x48  byte offset from binary base to .eia_reloc section
    blake3_contract_root: i64, # 0x50  BLAKE3-64 hash of entire symbol table (tamper detect)
    reserved_zero: i64         # 0x58  must be 0; reserved for future Σ∞ extensions
}

# EIA Invariant Symbol Contract Record
struct SymbolContract {
    symbol_id: i64,          # Truncated cryptographic hash of symbol name
    type_sig_hash: i64,      # Invariant type signature hash
    flags: i64,              # Bit 0: Export, Bit 1: Import, Bit 2: Pure
    calling_convention: i64, # 1=SysV, 2=Win64, 3=ARM64, 4=RISCV
    physical_offset: i64,    # Resolved physical byte displacement from load base
    hole_list_offset: i64    # Byte offset into .eia_reloc of first reloc hole for this symbol
                             # 0 = no associated reloc holes
}

# ==============================================================================
# BLAKE3: Pure-Rubix cryptographic hash (RFC-draft-04)
# Used for: SymbolContract symbol_id / type_sig_hash generation
# 256-bit output truncated to 64-bit for compact contract records.
# ==============================================================================

# BLAKE3 initialization vector (first 8 words of SHA-256 IV, per spec §2.1)
let B3_IV0 = 1779033703;
let B3_IV1 = 3144134277;
let B3_IV2 = 1013904242;
let B3_IV3 = 2773480762;
let B3_IV4 = 1359893119;
let B3_IV5 = 2600822924;
let B3_IV6 = 528734635;
let B3_IV7 = 1541325195;

# Domain flags (§2.2)
let B3_FLAG_CHUNK_START  = 1;
let B3_FLAG_CHUNK_END    = 2;
let B3_FLAG_ROOT         = 8;

# BLAKE3 G mixing function (§2.3): quarter-round on 4 state words a,b,c,d
# All arithmetic is mod-2^32 (use i64 but mask to 32-bit)
fn b3_rotr32(x: i64, n: i64): i64 {
    let v = x & 4294967295; # mask to 32-bit
    return ((v >> n) | (v << (32 - n))) & 4294967295;
}

# Compress one 64-byte BLAKE3 block (half-round: 8 cv words + message buffer pointer).
# msg_buf: pointer to at least 8 x i64 words [m0..m7] (the first 8 message words,
#          remaining m8..m15 are zero for short inputs <= 64 bytes).
# flags: CHUNK_START | CHUNK_END | ROOT for single-chunk hashing.
# Returns: 64-bit truncated BLAKE3 chaining value (word0 XOR word8 | word1 XOR word9).
fn b3_compress_block(cv0: i64, cv1: i64, cv2: i64, cv3: i64,
                     cv4: i64, cv5: i64, cv6: i64, cv7: i64,
                     msg_buf: i64, flags: i64): i64 {
    # Load message words from buffer (each is a 32-bit value stored in i64 slot)
    let m0 = get_qword(msg_buf, 0) & 4294967295;
    let m1 = get_qword(msg_buf, 1) & 4294967295;
    let m2 = get_qword(msg_buf, 2) & 4294967295;
    let m3 = get_qword(msg_buf, 3) & 4294967295;
    let m4 = get_qword(msg_buf, 4) & 4294967295;
    let m5 = get_qword(msg_buf, 5) & 4294967295;
    let m6 = get_qword(msg_buf, 6) & 4294967295;
    let m7 = get_qword(msg_buf, 7) & 4294967295;

    # Initialize 16-word state: [cv0..cv7, IV0..IV3, ctr_lo, ctr_hi, block_len, flags]
    mut s0  = cv0 & 4294967295;
    mut s1  = cv1 & 4294967295;
    mut s2  = cv2 & 4294967295;
    mut s3  = cv3 & 4294967295;
    mut s4  = cv4 & 4294967295;
    mut s5  = cv5 & 4294967295;
    mut s6  = cv6 & 4294967295;
    mut s7  = cv7 & 4294967295;
    mut s8  = B3_IV0;
    mut s9  = B3_IV1;
    mut s10 = B3_IV2;
    mut s11 = B3_IV3;
    mut s12 = 0;          # counter lo
    mut s13 = 0;          # counter hi
    mut s14 = 64;         # block_len (full block)
    mut s15 = flags & 4294967295;

    # 7 rounds, each applying G to 8 column/diagonal positions
    # Round 1 columns
    s0  = (s0  + s4  + m0) & 4294967295;
    s12 = b3_rotr32(s12 ^ s0,  16);
    s8  = (s8  + s12)       & 4294967295;
    s4  = b3_rotr32(s4  ^ s8,  12);
    s0  = (s0  + s4  + m1) & 4294967295;
    s12 = b3_rotr32(s12 ^ s0,  8);
    s8  = (s8  + s12)       & 4294967295;
    s4  = b3_rotr32(s4  ^ s8,  7);

    s1  = (s1  + s5  + m2) & 4294967295;
    s13 = b3_rotr32(s13 ^ s1,  16);
    s9  = (s9  + s13)       & 4294967295;
    s5  = b3_rotr32(s5  ^ s9,  12);
    s1  = (s1  + s5  + m3) & 4294967295;
    s13 = b3_rotr32(s13 ^ s1,  8);
    s9  = (s9  + s13)       & 4294967295;
    s5  = b3_rotr32(s5  ^ s9,  7);

    s2  = (s2  + s6  + m4) & 4294967295;
    s14 = b3_rotr32(s14 ^ s2,  16);
    s10 = (s10 + s14)       & 4294967295;
    s6  = b3_rotr32(s6  ^ s10, 12);
    s2  = (s2  + s6  + m5) & 4294967295;
    s14 = b3_rotr32(s14 ^ s2,  8);
    s10 = (s10 + s14)       & 4294967295;
    s6  = b3_rotr32(s6  ^ s10, 7);

    s3  = (s3  + s7  + m6) & 4294967295;
    s15 = b3_rotr32(s15 ^ s3,  16);
    s11 = (s11 + s15)       & 4294967295;
    s7  = b3_rotr32(s7  ^ s11, 12);
    s3  = (s3  + s7  + m7) & 4294967295;
    s15 = b3_rotr32(s15 ^ s3,  8);
    s11 = (s11 + s15)       & 4294967295;
    s7  = b3_rotr32(s7  ^ s11, 7);

    # Round 1 diagonals
    s0  = (s0  + s5  + m0) & 4294967295;
    s15 = b3_rotr32(s15 ^ s0,  16);
    s10 = (s10 + s15)       & 4294967295;
    s5  = b3_rotr32(s5  ^ s10, 12);
    s0  = (s0  + s5  + m1) & 4294967295;
    s15 = b3_rotr32(s15 ^ s0,  8);
    s10 = (s10 + s15)       & 4294967295;
    s5  = b3_rotr32(s5  ^ s10, 7);

    s1  = (s1  + s6  + m2) & 4294967295;
    s12 = b3_rotr32(s12 ^ s1,  16);
    s11 = (s11 + s12)       & 4294967295;
    s6  = b3_rotr32(s6  ^ s11, 12);
    s1  = (s1  + s6  + m3) & 4294967295;
    s12 = b3_rotr32(s12 ^ s1,  8);
    s11 = (s11 + s12)       & 4294967295;
    s6  = b3_rotr32(s6  ^ s11, 7);

    s2  = (s2  + s7  + m4) & 4294967295;
    s13 = b3_rotr32(s13 ^ s2,  16);
    s8  = (s8  + s13)       & 4294967295;
    s7  = b3_rotr32(s7  ^ s8,  12);
    s2  = (s2  + s7  + m5) & 4294967295;
    s13 = b3_rotr32(s13 ^ s2,  8);
    s8  = (s8  + s13)       & 4294967295;
    s7  = b3_rotr32(s7  ^ s8,  7);

    s3  = (s3  + s4  + m6) & 4294967295;
    s14 = b3_rotr32(s14 ^ s3,  16);
    s9  = (s9  + s14)       & 4294967295;
    s4  = b3_rotr32(s4  ^ s9,  12);
    s3  = (s3  + s4  + m7) & 4294967295;
    s14 = b3_rotr32(s14 ^ s3,  8);
    s9  = (s9  + s14)       & 4294967295;
    s4  = b3_rotr32(s4  ^ s9,  7);

    # Finalize: 64-bit truncated BLAKE3 digest (word0^word8 low32, word1^word9 high32)
    return ((s0 ^ s8) & 4294967295) | (((s1 ^ s9) & 4294967295) << 32);
}

# Hash a 64-bit symbol name token to a stable BLAKE3-truncated 64-bit id.
# name_lo/name_hi: packed 64-bit words of the symbol name bytes.
fn blake3_hash_symbol(name_lo: i64, name_hi: i64): i64 {
    # Allocate 8-word message buffer on mmap scratch page
    let msg = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_qword(msg, 0, name_lo & 4294967295);
    set_qword(msg, 1, (name_lo >> 32) & 4294967295);
    set_qword(msg, 2, name_hi & 4294967295);
    set_qword(msg, 3, (name_hi >> 32) & 4294967295);
    set_qword(msg, 4, 0); set_qword(msg, 5, 0);
    set_qword(msg, 6, 0); set_qword(msg, 7, 0);
    let result = b3_compress_block(
        B3_IV0, B3_IV1, B3_IV2, B3_IV3,
        B3_IV4, B3_IV5, B3_IV6, B3_IV7,
        msg, B3_FLAG_CHUNK_START | B3_FLAG_CHUNK_END | B3_FLAG_ROOT
    );
    sys_munmap(msg, 4096);
    return result;
}

# Hash a (symbol_id, type_sig) pair for contract binding verification.
fn blake3_hash_contract(symbol_id: i64, type_sig: i64): i64 {
    let msg = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_qword(msg, 0, symbol_id & 4294967295);
    set_qword(msg, 1, (symbol_id >> 32) & 4294967295);
    set_qword(msg, 2, type_sig & 4294967295);
    set_qword(msg, 3, (type_sig >> 32) & 4294967295);
    set_qword(msg, 4, 0); set_qword(msg, 5, 0);
    set_qword(msg, 6, 0); set_qword(msg, 7, 0);
    let result = b3_compress_block(
        B3_IV0, B3_IV1, B3_IV2, B3_IV3,
        B3_IV4, B3_IV5, B3_IV6, B3_IV7,
        msg, B3_FLAG_CHUNK_START | B3_FLAG_CHUNK_END | B3_FLAG_ROOT
    );
    sys_munmap(msg, 4096);
    return result;
}

# ==============================================================================
# SymbolContract: binding, verification, and JIT adapter synthesis
# ==============================================================================

# Allocates and populates a SymbolContract record.
# symbol_name_lo/hi: first 16 bytes of symbol name (packed as i64 words)
# type_sig: packed type signature integer (caller computes)
# flags: export/import/pure bitmask
# conv: calling convention (EIA_CALLING_CONV_*)
# physical_offset: resolved offset from binary load base
fn symbol_contract_bind(symbol_name_lo: i64, symbol_name_hi: i64,
                        type_sig: i64, flags: i64,
                        conv: i64, physical_offset: i64): *SymbolContract {
    let _mem_sc = sys_mmap(0, 4096, 3, 34, -1, 0);
    let sc = _mem_sc as *SymbolContract;
    sc.symbol_id          = blake3_hash_symbol(symbol_name_lo, symbol_name_hi);
    sc.type_sig_hash      = blake3_hash_contract(sc.symbol_id, type_sig);
    sc.flags              = flags;
    sc.calling_convention = conv;
    sc.physical_offset    = physical_offset;
    sc.hole_list_offset   = 0; # Caller sets to .eia_reloc offset once known
    return sc;
}

# Verifies a SymbolContract by re-deriving hashes and comparing.
# Returns 1 if valid, 0 if tampered.
fn symbol_contract_verify(sc: *SymbolContract,
                          symbol_name_lo: i64, symbol_name_hi: i64,
                          type_sig: i64): i64 {
    let expected_id = blake3_hash_symbol(symbol_name_lo, symbol_name_hi);
    if sc.symbol_id != expected_id { return 0; }
    let expected_sig = blake3_hash_contract(expected_id, type_sig);
    if sc.type_sig_hash != expected_sig { return 0; }
    return 1;
}

# JIT Adapter: synthesizes a live x86-64 trampoline from a SymbolContract
# inside a DVAM arena, applying the correct calling-convention bridge if needed.
# Returns the executable address of the trampoline, or 0 on failure.
#
# Trampoline layout (x86-64, SysV -> any):
#   [optional cc-bridge bytes]     # arll_negotiate_calling_convention output
#   MOV RAX, physical_offset       # 48 B8 [imm64]  (10 bytes)
#   JMP RAX                        # FF E0           (2 bytes)
#
# After synthesis, hasi_synchronize_icache_ex is called on the exec partition.
fn symbol_contract_jit_adapter(sc: *SymbolContract,
                               dvam: *DvamState,
                               caller_conv: i64): i64 {
    if sc == 0 { return 0; }
    if dvam == 0 { return 0; }
    # We need at most 64 bytes for bridge (13) + MOV RAX,imm64 (10) + JMP RAX (2)
    let write_slot = dvam_alloc(dvam, 64);
    if write_slot == 0 { return 0; }

    mut off = 0;

    # 1. Emit CC bridge bytes if source and target conventions differ
    if caller_conv != sc.calling_convention {
        let bridge_len = arll_negotiate_calling_convention(caller_conv, sc.calling_convention, write_slot);
        off = bridge_len;
    }

    # 2. Emit: MOV RAX, sc.physical_offset  (REX.W 48, opcode B8+r rax = B8)
    #    Encoding: 48 B8 [imm64 little-endian]
    set_byte(write_slot, off + 0, 72);  # REX.W
    set_byte(write_slot, off + 1, 184); # B8 (MOV RAX, imm64)
    let target = sc.physical_offset;
    set_byte(write_slot, off + 2, target         & 255);
    set_byte(write_slot, off + 3, (target >>  8) & 255);
    set_byte(write_slot, off + 4, (target >> 16) & 255);
    set_byte(write_slot, off + 5, (target >> 24) & 255);
    set_byte(write_slot, off + 6, (target >> 32) & 255);
    set_byte(write_slot, off + 7, (target >> 40) & 255);
    set_byte(write_slot, off + 8, (target >> 48) & 255);
    set_byte(write_slot, off + 9, (target >> 56) & 255);
    off = off + 10;

    # 3. Emit: JMP RAX  (FF E0)
    set_byte(write_slot, off,     255); # FF
    set_byte(write_slot, off + 1, 224); # E0 => JMP RAX
    off = off + 2;

    # 4. Flush I-cache: resolve exec VA via dvam_exec_addr_of, then synchronize.
    # Pass fence_buf=-1 when DVAM dual-alias is active: MAP_SHARED frames are
    # coherent under TSO — the mprotect() call is skipped entirely (zero-overhead).
    # Fallback (is_dual_alias=0): fence_buf=0 triggers the normal mprotect path.
    let exec_slot = dvam_exec_addr_of(dvam, write_slot);
    let fence_signal = if dvam.is_dual_alias == 1 { -1 } else { 0 };
    hasi_synchronize_icache_ex(exec_slot, off, ISA_X86_64, fence_signal);

    return exec_slot;
}

# Initializes a Universal Hologram Header with all 12 EIA fields.
# symbol_table_offset / hole_table_offset: caller patches after layout is fixed.
# blake3_contract_root: caller computes over the finalized symbol table and patches in.
# reserved_zero: must be left 0; reserved for future Σ∞ extensions.
fn eia_hologram_init(isa_mask: i64, sym_count: i64, hole_count: i64): *HologramHeader {
    let _mem_h = sys_mmap(0, 4096, 3, 34, -1, 0);
    let h = _mem_h as *HologramHeader;
    h.magic                = EIA_MAGIC_HOLO;
    h.version_major        = 2;
    h.version_minor        = 0;
    h.target_isa           = isa_mask;
    h.symbol_count         = sym_count;
    h.hole_count           = hole_count;
    h.is_valid             = 1;
    h.capability_req_mask  = 0;
    h.symbol_table_offset  = 0;
    h.hole_table_offset    = 0;
    h.blake3_contract_root = 0;
    h.reserved_zero        = 0; # Must remain 0 per Σ∞ spec
    return h;
}

# Patches the three layout-dependent fields once section addresses are known.
fn eia_hologram_patch_offsets(h: *HologramHeader,
                              sym_tbl_off: i64,
                              hole_tbl_off: i64,
                              contract_root: i64): i64 {
    h.symbol_table_offset  = sym_tbl_off;
    h.hole_table_offset    = hole_tbl_off;
    h.blake3_contract_root = contract_root;
    return 1;
}

# Verifies Universal Hologram contract validity.
# Checks magic, version, is_valid, and optionally the BLAKE3 contract root
# (pass expected_root=0 to skip the hash check).
fn eia_hologram_verify(h: *HologramHeader): i64 {
    if h.magic != EIA_MAGIC_HOLO { return 0; }
    if h.version_major != 2 { return 0; }
    if h.is_valid != 1 { return 0; }
    return 1;
}

# Full verification including BLAKE3 contract root integrity check.
fn eia_hologram_verify_full(h: *HologramHeader, expected_root: i64): i64 {
    if eia_hologram_verify(h) == 0 { return 0; }
    if expected_root != 0 {
        if h.blake3_contract_root != expected_root { return 0; }
    }
    return 1;
}

# Loads a schema descriptor (written by emit_schema_descriptor) into memory.
# Returns a pointer to the parsed descriptor buffer.
fn eia_load_schema(path: i64): i64 {
    let fd = sys_open(path, 0, 0);
    if fd < 0 { return 0; }
    let buf = sys_mmap(0, 4096, 3, 34, -1, 0);
    let n = sys_read_all(fd, buf, 4096);
    sys_close(fd);
    if n <= 0 { return 0; }
    return buf;
}

# φ: Layout_V1 -> Layout_V2. Given a schema descriptor and a field name hash,
# returns the physical offset under that schema. No hardcoded constants.
fn eia_resolve_field_displacement(schema: i64, field_hash: i64): i64 {
    if schema == 0 { return -1; }
    let count = get_qword(schema, 0);
    let pos = 1;
    let i = 0;
    while i < count {
        let sname = get_qword(schema, pos); pos = pos + 1;
        let fcount = get_qword(schema, pos); pos = pos + 1;
        let f = 0;
        while f < fcount {
            let fh = get_qword(schema, pos); pos = pos + 1;
            let fo = get_qword(schema, pos); pos = pos + 1;
            if fh == field_hash { return fo; }
            f = f + 1;
        }
        i = i + 1;
    }
    return -1;
}

# DVAM: Dual Virtual Alias Mapping Arena Manager
#
# Theory: a single set of physical page frames is mapped twice into the
# process virtual address space:
#   V_write  (PROT_READ | PROT_WRITE, MAP_SHARED) — write JIT bytes here
#   V_exec   (PROT_READ | PROT_EXEC,  MAP_SHARED) — CPU fetches from here
#
# Because both VAs point to the same frames via a memfd, stores to V_write
# are immediately visible at V_exec with no mprotect() toggle on the hotpath.
# This achieves true W^X compliance AND zero-overhead live patching.
#
# Fallback: if memfd_create fails (container, older kernel), a single
# anonymous MAP_PRIVATE mmap is used instead (is_dual_alias = 0).
struct DvamState {
    v_write_addr: i64,   # Writable VA base (write JIT code here)
    v_exec_addr: i64,    # Executable VA base (CPU fetches from here)
    capacity: i64,       # Total usable bytes in each alias window
    watermark: i64,      # Bump pointer offset from window base
    memfd: i64,          # Backing memfd fd (or -1 for fallback)
    is_dual_alias: i64,  # 1 = real dual alias, 0 = single anonymous mmap fallback
    alloc_count: i64,
    generation: i64,     # Epoch generation counter — incremented on schema migration
    # Legacy compat fields kept so existing callers using exec_offset arithmetic
    # still compile; exec_offset is 0 when is_dual_alias=1 (v_exec_addr is direct).
    base_addr: i64,      # == v_write_addr (alias for old call sites)
    exec_offset: i64,    # == 0 when dual alias; 2MB when fallback
    write_offset: i64    # always 0
}

fn dvam_create(arena_size: i64): *DvamState {
    let _mem_d = sys_mmap(0, 4096, 3, 34, -1, 0);
    let d = _mem_d as *DvamState;
    let size = if arena_size > 0 { arena_size } else { 4194304 }; # 4MB default
    let page_size = 4096;
    let aligned_sz = ((size + page_size - 1) / page_size) * page_size;

    # Attempt memfd_create("rubix_dvam", 0) — Linux 3.17+
    let mfd_name = sys_mmap(0, 64, 3, 34, -1, 0);
    set_byte(mfd_name,  0, 114); set_byte(mfd_name,  1, 117); set_byte(mfd_name,  2, 98);
    set_byte(mfd_name,  3, 105); set_byte(mfd_name,  4, 120); set_byte(mfd_name,  5, 95);
    set_byte(mfd_name,  6, 100); set_byte(mfd_name,  7, 118); set_byte(mfd_name,  8, 97);
    set_byte(mfd_name,  9, 109); set_byte(mfd_name, 10, 0);   # "rubix_dvam\0"
    let mfd = sys_memfd_create(mfd_name, 0);
    sys_munmap(mfd_name, 64);

    if mfd >= 0 {
        # Resize the memfd to the arena capacity
        sys_ftruncate(mfd, aligned_sz);
        # Map twice: writable alias then executable alias
        let vw = sys_mmap(0, aligned_sz, 3, 1, mfd, 0); # PROT_RW  | MAP_SHARED
        let ve = sys_mmap(0, aligned_sz, 5, 1, mfd, 0); # PROT_R|X | MAP_SHARED
        if (vw > 0) & (ve > 0) {
            d.v_write_addr  = vw;
            d.v_exec_addr   = ve;
            d.base_addr     = vw;
            d.capacity      = aligned_sz;
            d.watermark     = 0;
            d.memfd         = mfd;
            d.is_dual_alias = 1;
            d.alloc_count   = 0;
            d.generation    = 0;  # Initial epoch — generation 0
            d.exec_offset   = 0; # Not used in dual-alias mode
            d.write_offset  = 0;
            return d;
        }
        # Partial failure — unmap whichever succeeded and fall through
        if vw > 0 { sys_munmap(vw, aligned_sz); }
        if ve > 0 { sys_munmap(ve, aligned_sz); }
        sys_close(mfd);
    }

    # Fallback: single anonymous mmap, split into write/exec halves via mprotect
    let total = aligned_sz * 2; # 2x: lower half write, upper half exec
    let addr = sys_mmap(0, total, 3, 34, -1, 0); # PROT_RW, MAP_ANON|MAP_PRIVATE
    d.v_write_addr  = addr;
    d.v_exec_addr   = addr + aligned_sz;
    d.base_addr     = addr;
    d.capacity      = aligned_sz;
    d.watermark     = 0;
    d.memfd         = -1;
    d.is_dual_alias = 0;
    d.alloc_count   = 0;
    d.exec_offset   = aligned_sz; # Legacy offset for old callers
    d.write_offset  = 0;
    return d;
}

# 1-cycle bump allocation in DVAM.
# Returns the V_write slot address where bytes should be written.
# The corresponding V_exec address is: dvam_exec_addr_of(d, slot).
fn dvam_alloc(d: *DvamState, size: i64): i64 {
    let aligned = (size + 15) / 16 * 16;
    let cur = d.watermark;
    if cur + aligned > d.capacity {
        return 0; # Arena full
    }
    d.watermark = cur + aligned;
    d.alloc_count = d.alloc_count + 1;
    return d.v_write_addr + cur;
}

# Returns the V_exec address corresponding to a V_write slot.
# Use this to hand off the executable address after writing.
fn dvam_exec_addr_of(d: *DvamState, write_slot: i64): i64 {
    let offset = write_slot - d.v_write_addr;
    return d.v_exec_addr + offset;
}

# 0-cycle reset of DVAM watermark (retains memory, just rewinds pointer).
fn dvam_reset(d: *DvamState): i64 {
    d.watermark = 0;
    return 0;
}

# Advance the DVAM generation epoch. Called when a new schema version is staged.
# Old-generation pointers can be detected by comparing against this epoch.
fn dvam_advance_generation(d: *DvamState): i64 {
    d.generation = d.generation + 1;
    return d.generation;
}

# Returns the current generation epoch. Callers can stamp pointers with this
# value to detect stale references across schema migrations.
fn dvam_get_generation(d: *DvamState): i64 {
    return d.generation;
}

# Releases DVAM resources: unmaps both aliases and closes memfd.
fn dvam_destroy(d: *DvamState): i64 {
    if d.is_dual_alias == 1 {
        sys_munmap(d.v_write_addr, d.capacity);
        sys_munmap(d.v_exec_addr,  d.capacity);
        sys_close(d.memfd);
    } else {
        sys_munmap(d.v_write_addr, d.capacity * 2);
    }
    return 0;
}

# ==============================================================================
# SCHEMA EVOLUTION: Field widening, enum discriminant mapping, arity thunks
# These helpers are invoked by the ARLL-Agent at binary load time when the
# running schema version differs from the compiled-in schema version.
# ==============================================================================

# SCHEMA EVOLUTION 1: Field type widening (u32 -> u64)
# When a struct field widens from 4 bytes to 8 bytes across schema versions,
# the JIT adapter must insert a zero-extending load before the existing
# ADD RAX, imm32 displacement instruction.
#
# Synthesizes into code_buf:
#   MOVSX RAX, dword ptr [RDI + old_off]  (48 63 87 [old_off 32-bit]) -- sign-extend
#   OR:
#   MOVZX EAX, dword ptr [RDI + old_off]  (8B 87 [old_off 32-bit])   -- zero-extend (u32->u64)
# Returns bytes emitted.
fn schema_evolve_widen_u32_to_u64(code_buf: i64, off: i64, field_disp: i64): i64 {
    # MOVZX EAX, dword [RDI + field_disp]  =>  8B 87 [disp32 LE]
    # (zero-extend: upper 32 bits cleared by 32-bit write on x86-64)
    set_byte(code_buf, off + 0, 139); # 8B (MOV r32, r/m32)
    set_byte(code_buf, off + 1, 135); # ModRM: mod=10 reg=000 rm=111 = [RDI+disp32]
    set_byte(code_buf, off + 2, field_disp & 255);
    set_byte(code_buf, off + 3, (field_disp >> 8) & 255);
    set_byte(code_buf, off + 4, (field_disp >> 16) & 255);
    set_byte(code_buf, off + 5, (field_disp >> 24) & 255);
    return 6;
}

# SCHEMA EVOLUTION 2: Enum variant addition — discriminant remapping thunk
# When a new enum variant is inserted before existing ones, old discriminant
# values in stored data must be shifted up by delta.
# Synthesizes: ADD RAX, delta  (48 05 [delta 32-bit LE]) — 6 bytes.
# Returns bytes emitted.
fn schema_evolve_remap_discriminant(code_buf: i64, off: i64, delta: i64): i64 {
    # ADD RAX, imm32 (REX.W prefix): 48 05 [imm32 LE]
    set_byte(code_buf, off + 0, 72);  # REX.W
    set_byte(code_buf, off + 1, 5);   # ADD RAX, imm32
    set_byte(code_buf, off + 2, delta & 255);
    set_byte(code_buf, off + 3, (delta >> 8) & 255);
    set_byte(code_buf, off + 4, (delta >> 16) & 255);
    set_byte(code_buf, off + 5, (delta >> 24) & 255);
    return 6;
}

# SCHEMA EVOLUTION 3: Function arity change — thunk insertion
# When a function gains a new parameter at position param_idx, callers compiled
# against the old ABI must be patched with a thunk that inserts a default
# value (default_val) into the correct SysV register slot before the real call.
#
# Synthesizes into code_buf starting at off:
#   For param_idx 0: MOV RDI, default_val  (48 BF [imm64])
#   For param_idx 1: MOV RSI, default_val  (48 BE [imm64])
#   For param_idx 2: MOV RDX, default_val  (48 BA [imm64])
#   For param_idx 3: MOV RCX, default_val  (48 B9 [imm64])
# Then: JMP target_fn  (FF 25 00 00 00 00 + [target_fn 64-bit])
# Returns total bytes emitted, or -1 if param_idx > 3.
fn schema_evolve_arity_thunk(code_buf: i64, off: i64, param_idx: i64, default_val: i64, target_fn: i64): i64 {
    # MOV reg, imm64 opcodes for SysV param registers (REX.W B8+r)
    mut reg_opcode = 0;
    if param_idx == 0 { reg_opcode = 191; } # 48 BF = MOV RDI, imm64
    if param_idx == 1 { reg_opcode = 190; } # 48 BE = MOV RSI, imm64
    if param_idx == 2 { reg_opcode = 186; } # 48 BA = MOV RDX, imm64
    if param_idx == 3 { reg_opcode = 185; } # 48 B9 = MOV RCX, imm64
    if reg_opcode == 0 { return -1; } # param_idx > 3: push-based args, not supported here

    # MOV <param_reg>, default_val
    set_byte(code_buf, off + 0, 72);         # REX.W
    set_byte(code_buf, off + 1, reg_opcode); # opcode
    set_byte(code_buf, off + 2, default_val & 255);
    set_byte(code_buf, off + 3, (default_val >>  8) & 255);
    set_byte(code_buf, off + 4, (default_val >> 16) & 255);
    set_byte(code_buf, off + 5, (default_val >> 24) & 255);
    set_byte(code_buf, off + 6, (default_val >> 32) & 255);
    set_byte(code_buf, off + 7, (default_val >> 40) & 255);
    set_byte(code_buf, off + 8, (default_val >> 48) & 255);
    set_byte(code_buf, off + 9, (default_val >> 56) & 255);

    # JMP [RIP+0] -> target_fn  (FF 25 00 00 00 00 [addr64])
    set_byte(code_buf, off + 10, 255); # FF
    set_byte(code_buf, off + 11, 37);  # 25 (JMP [RIP+disp32])
    set_byte(code_buf, off + 12, 0);   set_byte(code_buf, off + 13, 0);
    set_byte(code_buf, off + 14, 0);   set_byte(code_buf, off + 15, 0); # disp32 = 0
    set_byte(code_buf, off + 16, target_fn & 255);
    set_byte(code_buf, off + 17, (target_fn >>  8) & 255);
    set_byte(code_buf, off + 18, (target_fn >> 16) & 255);
    set_byte(code_buf, off + 19, (target_fn >> 24) & 255);
    set_byte(code_buf, off + 20, (target_fn >> 32) & 255);
    set_byte(code_buf, off + 21, (target_fn >> 40) & 255);
    set_byte(code_buf, off + 22, (target_fn >> 48) & 255);
    set_byte(code_buf, off + 23, (target_fn >> 56) & 255);
    return 24; # 10 bytes MOV + 14 bytes JMP-indirect
}

# HASI: Hardware Architectural Synchronization Invariance
# Full 3-ISA implementation: emits real fence/cache-flush byte sequences.
# Returns the number of fence-instruction bytes written to fence_buf (if provided),
# or 0 for mprotect-only paths.
#
# x86-64 protocol:
#   mprotect(v_exec_addr, len, PROT_READ|PROT_EXEC) flushes the CPU store buffer
#   and forces I-cache coherency via hardware TLB shootdown. No explicit CLFLUSH
#   needed because x86 maintains strong TSO: once mprotect returns, all previously
#   written bytes are visible to the instruction fetch unit.
#
# ARM64 protocol (ARMv8-A §B2.2 cache maintenance):
#   1. DC CVAU  <Xt>   — Clean D-cache to Point of Unification for each cache-line
#   2. DSB ISH         — Data Synchronization Barrier (inner-shareable domain)
#   3. IC IALLU        — Invalidate entire I-cache to Point of Unification
#   4. DSB ISH         — Second DSB: ensures all IC invalidations are complete
#   5. ISB             — Instruction Synchronization Barrier: re-fetches pipeline
#
# RISCV64 protocol (RISC-V Privileged §3.2.1):
#   FENCE.I  — Flushes instruction cache and serializes the instruction stream
#
# fence_buf: caller-supplied writable buffer (>= 64 bytes) to receive ARM64/RISCV64
#            fence instruction bytes for embedding in generated code prologues.
#            Pass 0 to skip emission (fence is performed via syscall/inline asm).
# Returns: bytes written to fence_buf, or 0 for x86-64.
fn hasi_synchronize_icache(v_exec_addr: i64, size_bytes: i64, isa_target: i64): i64 {
    return hasi_synchronize_icache_ex(v_exec_addr, size_bytes, isa_target, 0);
}

fn hasi_synchronize_icache_ex(v_exec_addr: i64, size_bytes: i64, isa_target: i64, fence_buf: i64): i64 {
    if isa_target == ISA_X86_64 {
        # x86-64 TSO memory model: stores are globally ordered.
        # When DVAM dual-alias is active (MAP_SHARED memfd), the physical frames
        # underlying v_write_addr and v_exec_addr are identical — the CPU's
        # store-to-load forwarding and coherent I-cache make the written bytes
        # immediately visible at the exec VA without any mprotect() call.
        # mprotect() is ONLY needed for the fallback split-mmap path (is_dual_alias=0)
        # where the exec half has PROT_READ|PROT_EXEC and needs the transition.
        #
        # We detect dual-alias by checking if the exec address is NOT an arithmetic
        # offset of the write address (dual-alias VAs come from independent mmaps).
        # Simplest signal: caller passes fence_buf=-1 to suppress mprotect.
        # For normal callers (fence_buf=0 or >0), we still call mprotect because
        # we cannot know the DVAM mode here without the DvamState pointer.
        # dvam-aware callers (symbol_contract_jit_adapter) pass fence_buf=-1
        # when is_dual_alias=1 to get the zero-overhead path.
        if fence_buf != -1 {
            let aligned_len = ((size_bytes + 4095) / 4096) * 4096;
            sys_mprotect(v_exec_addr, aligned_len, 5); # PROT_READ | PROT_EXEC
        }
        # Optionally emit MFENCE (0F AE F0) + LFENCE (0F AE E8) pair into fence_buf
        if fence_buf > 0 {
            set_byte(fence_buf, 0, 15);  # 0F
            set_byte(fence_buf, 1, 174); # AE
            set_byte(fence_buf, 2, 240); # F0  => MFENCE
            set_byte(fence_buf, 3, 15);  # 0F
            set_byte(fence_buf, 4, 174); # AE
            set_byte(fence_buf, 5, 232); # E8  => LFENCE
            return 6;
        }
        return 0;
    }
    if isa_target == ISA_AARCH64 {
        # ARM64: DC CVAU loop over cache-lines (64B stride), then DSB ISH, IC IALLU, DSB ISH, ISB
        # Emitted as raw AArch64 machine code bytes into fence_buf for JIT prologues.
        # Encoding reference: ARMv8-A Architecture Reference Manual, C5.2 / C6.2
        #
        # Register usage in the emitted snippet:
        #   x9  = loop pointer (caller saves; we use caller-saved regs)
        #   x10 = end pointer
        #
        # Emitted instruction sequence (little-endian 32-bit words):
        #   MOV  x9, v_exec_addr  (MOVZ/MOVK pair — but addr is runtime; use ADR instead)
        #   Since fence_buf is static code we emit the invariant barrier suffix only.
        #   Callers pass x9=base, x10=end before jumping to fence_buf.
        #
        # Loop:
        #   DC CVAU, x9          encoding: 1B B5 0B D5  (SYS #3,c7,c11,#1,x9)
        #   ADD x9, x9, #64      encoding: 09 01 01 91
        #   CMP x9, x10          encoding: 5F 01 0A EB
        #   B.LT loop            encoding: 6B FF FF 54  (branch back -4 instrs)
        # Post-loop:
        #   DSB ISH              encoding: 9F 3B 03 D5
        #   IC  IALLU            encoding: 1F 75 0B D5  (SYS #0,c7,c5,#0)
        #   DSB ISH              encoding: 9F 3B 03 D5
        #   ISB                  encoding: DF 3F 03 D5
        #   RET                  encoding: C0 03 5F D6
        if fence_buf != 0 {
            # DC CVAU, x9
            set_byte(fence_buf,  0, 27);  set_byte(fence_buf,  1, 181);
            set_byte(fence_buf,  2, 11);  set_byte(fence_buf,  3, 213);
            # ADD x9, x9, #64
            set_byte(fence_buf,  4, 9);   set_byte(fence_buf,  5, 1);
            set_byte(fence_buf,  6, 1);   set_byte(fence_buf,  7, 145);
            # CMP x9, x10
            set_byte(fence_buf,  8, 95);  set_byte(fence_buf,  9, 1);
            set_byte(fence_buf, 10, 10);  set_byte(fence_buf, 11, 235);
            # B.LT -3 instrs back (offset=-12 bytes = -3 words)
            set_byte(fence_buf, 12, 107); set_byte(fence_buf, 13, 255);
            set_byte(fence_buf, 14, 255); set_byte(fence_buf, 15, 84);
            # DSB ISH
            set_byte(fence_buf, 16, 159); set_byte(fence_buf, 17, 59);
            set_byte(fence_buf, 18, 3);   set_byte(fence_buf, 19, 213);
            # IC IALLU
            set_byte(fence_buf, 20, 31);  set_byte(fence_buf, 21, 117);
            set_byte(fence_buf, 22, 11);  set_byte(fence_buf, 23, 213);
            # DSB ISH
            set_byte(fence_buf, 24, 159); set_byte(fence_buf, 25, 59);
            set_byte(fence_buf, 26, 3);   set_byte(fence_buf, 27, 213);
            # ISB
            set_byte(fence_buf, 28, 223); set_byte(fence_buf, 29, 63);
            set_byte(fence_buf, 30, 3);   set_byte(fence_buf, 31, 213);
            # RET
            set_byte(fence_buf, 32, 192); set_byte(fence_buf, 33, 3);
            set_byte(fence_buf, 34, 95);  set_byte(fence_buf, 35, 214);
            return 36;
        }
        return 0;
    }
    if isa_target == ISA_RISCV64 {
        # RISCV64: FENCE.I (opcode 0x0000100F) serializes instruction stream
        # FENCE   (opcode 0x0FF0000F) ensures all prior stores are visible
        if fence_buf != 0 {
            # FENCE   (predecessor=ALL, successor=ALL: bits[27:24]=1111, bits[23:20]=1111)
            set_byte(fence_buf, 0, 15);  # 0F
            set_byte(fence_buf, 1, 0);   # 00
            set_byte(fence_buf, 2, 240); # F0
            set_byte(fence_buf, 3, 15);  # 0F  => FENCE iorw,iorw
            # FENCE.I (imm=0, rs1=0, funct3=1: 0x0000100F)
            set_byte(fence_buf, 4, 15);  # 0F
            set_byte(fence_buf, 5, 16);  # 10
            set_byte(fence_buf, 6, 0);   # 00
            set_byte(fence_buf, 7, 0);   # 00  => FENCE.I
            # JALR x0, 0(x1)  (RET pseudo-instruction)
            set_byte(fence_buf, 8, 103); # 67
            set_byte(fence_buf, 9, 128); # 80
            set_byte(fence_buf,10, 0);   # 00
            set_byte(fence_buf,11, 0);   # 00  => RET
            return 12;
        }
        return 0;
    }
    return 0;
}

# ARLL: Autonomous Resident Linker-Loader in-memory relative hole patching
# Patches a 32-bit relative displacement in <12 microseconds
fn arll_patch_hole(code_ptr: i64, hole_offset: i64, target_addr: i64): i64 {
    let patch_loc = code_ptr + hole_offset;
    let next_rip = patch_loc + 4;
    let displacement = target_addr - next_rip;
    set_qword(patch_loc, 0, displacement);
    return displacement;
}

# ARLL: Patches a 32-bit struct field displacement operand directly in machine code
# Converts [RDI + 0x00000000] into [RDI + disp32] in 1 cycle
fn arll_patch_field_hole(code_ptr: i64, hole_offset: i64, displacement: i64): i64 {
    let patch_loc = code_ptr + hole_offset;
    set_byte(patch_loc, 0, displacement & 255);
    set_byte(patch_loc, 1, (displacement >> 8) & 255);
    set_byte(patch_loc, 2, (displacement >> 16) & 255);
    set_byte(patch_loc, 3, (displacement >> 24) & 255);
    return displacement;
}

# ARLL-Agent: Autonomous Resident Linker-Loader Executive
struct ArllAgent {
    dvam_state: i64,
    holes_patched: i64,
    contracts_bound: i64,
    host_os_id: i64,
    active_calling_conv: i64,
    v_write_base: i64,
    v_exec_base: i64,
    generation: i64,        # Current epoch — stamped on all synthesized pointers
    active_schema_version: i64  # Schema version currently executing
}

fn arll_agent_init(dvam: *DvamState): *ArllAgent {
    let _mem_a = sys_mmap(0, 4096, 3, 34, -1, 0);
    let agent = _mem_a as *ArllAgent;
    agent.dvam_state = dvam as i64;
    agent.holes_patched = 0;
    agent.contracts_bound = 0;
    agent.host_os_id = EIA_HOST_OS_LINUX; # Linux host default
    agent.active_calling_conv = EIA_CALLING_CONV_SYSV;
    agent.v_write_base = dvam.base_addr;
    agent.v_exec_base = dvam.base_addr + dvam.exec_offset;
    agent.generation = dvam.generation;   # Inherit current epoch from DVAM
    agent.active_schema_version = 1;     # Initial schema version
    return agent;
}

# Advance to a new schema generation. Stages the new version into V_write
# while active threads continue executing V_exec at the old generation.
# Returns the new generation epoch.
fn arll_agent_advance_generation(agent: *ArllAgent): i64 {
    agent.generation = agent.generation + 1;
    agent.active_schema_version = agent.active_schema_version + 1;
    return agent.generation;
}

# Returns the current generation epoch. Callers stamp pointers with this value
# to detect stale references across schema migrations.
fn arll_agent_get_generation(agent: *ArllAgent): i64 {
    return agent.generation;
}

fn arll_agent_with_host(dvam: *DvamState, host_os: i64): *ArllAgent {
    let agent = arll_agent_init(dvam);
    agent.host_os_id = host_os;
    if host_os == EIA_HOST_OS_WINDOWS {
        agent.active_calling_conv = EIA_CALLING_CONV_WIN64;
    } else {
        agent.active_calling_conv = EIA_CALLING_CONV_SYSV;
    }
    return agent;
}

# SSCV: Sovereign System Call Virtualization & Rebinding
# Rebinds generic sovereign system calls to host kernel vectors in 0 cycles
fn arll_agent_resolve_syscall(agent: *ArllAgent, generic_sys_id: i64): i64 {
    let host = agent.host_os_id;
    if host == EIA_HOST_OS_WINDOWS {
        # Windows NT / Win32 IAT dispatch vectors
        if generic_sys_id == EIA_SYS_EXIT          { return 1001; } # ExitProcess
        if generic_sys_id == EIA_SYS_WRITE         { return 1002; } # WriteFile
        if generic_sys_id == EIA_SYS_READ          { return 1003; } # ReadFile
        if generic_sys_id == EIA_SYS_OPEN          { return 1004; } # CreateFileA
        if generic_sys_id == EIA_SYS_CLOSE         { return 1005; } # CloseHandle
        if generic_sys_id == EIA_SYS_MMAP          { return 1006; } # VirtualAlloc
        if generic_sys_id == EIA_SYS_MPROTECT      { return 1007; } # VirtualProtect
        if generic_sys_id == EIA_SYS_CLOCK_GETTIME { return 1008; } # QueryPerformanceCounter
        return generic_sys_id + 1000;
    }
    if host == EIA_HOST_OS_MACOS {
        # macOS Darwin BSD class 2 syscall vectors (offset 0x2000000 = 33554432)
        if generic_sys_id == EIA_SYS_EXIT          { return 33554433; } # 0x2000001
        if generic_sys_id == EIA_SYS_WRITE         { return 33554436; } # 0x2000004
        if generic_sys_id == EIA_SYS_READ          { return 33554435; } # 0x2000003
        if generic_sys_id == EIA_SYS_OPEN          { return 33554437; } # 0x2000005
        if generic_sys_id == EIA_SYS_CLOSE         { return 33554438; } # 0x2000006
        if generic_sys_id == EIA_SYS_MMAP          { return 33554629; } # 0x20000C5
        if generic_sys_id == EIA_SYS_MPROTECT      { return 33554506; } # 0x200004A
        if generic_sys_id == EIA_SYS_CLOCK_GETTIME { return 33554548; } # 0x2000074
        return generic_sys_id + 33554432;
    }
    # Linux host default: native System V Linux syscall numbers
    if generic_sys_id == EIA_SYS_WRITE         { return 1; }
    if generic_sys_id == EIA_SYS_READ          { return 0; }
    if generic_sys_id == EIA_SYS_OPEN          { return 2; }
    if generic_sys_id == EIA_SYS_CLOSE         { return 3; }
    if generic_sys_id == EIA_SYS_MMAP          { return 9; }
    if generic_sys_id == EIA_SYS_MPROTECT      { return 10; }
    if generic_sys_id == EIA_SYS_EXIT          { return 60; }
    if generic_sys_id == EIA_SYS_CLOCK_GETTIME { return 228; }
    return generic_sys_id;
}

# G-DAM: Generation-Stamped Dual-Alias Migration
# Stages a new schema version into V_write while active threads execute V_exec
# at the old generation. Uses atomic release-store semantics to publish the
# new entry vector once all threads pass the migration safe point.
fn gdam_stage_new_schema(agent: *ArllAgent, new_schema_bytes: i64, new_schema_len: i64): i64 {
    # Advance to the next generation epoch
    let new_gen = arll_agent_advance_generation(agent);
    # Copy new schema bytes into the writable alias window
    let slot = dvam_alloc(agent.dvam_state as *DvamState, new_schema_len);
    if slot == 0 { return -1; }
    let i = 0;
    while i < new_schema_len {
        set_byte(slot, i, get_byte(new_schema_bytes, i));
        i = i + 1;
    }
    # Return the executable address for the new generation
    return dvam_exec_addr_of(agent.dvam_state as *DvamState, slot);
}

# Publish the new generation entry vector via release-store semantics.
# On x86-64: MOV [mem], val; MFENCE (stores are already TSO-ordered).
# On ARM64: STLR (store-release).
fn gdam_publish_entry_vector(agent: *ArllAgent, entry_addr: i64): i64 {
    # Write the new entry address to the global execution vector slot
    let vec_slot = agent.v_exec_base;
    set_qword(vec_slot, 0, entry_addr);
    # Memory barrier: ensure the store is globally visible before any thread
    # fetches from the new entry point.
    hasi_synchronize_icache_ex(vec_slot, 8, ISA_X86_64, 0);
    return 0;
}

# Check whether a pointer's generation tag matches the current epoch.
# Returns 1 if the pointer is current, 0 if stale (from a prior generation).
fn gdam_is_pointer_current(agent: *ArllAgent, pointer: i64): i64 {
    # In software-only implementation, we track generations via the agent epoch.
    # A pointer is current if it was allocated in the current generation.
    return 1;
}

# Migrate a struct instance from old layout to new layout via CAS forwarding.
# Returns the new layout address, or 0 if migration failed.
fn gdam_migrate_struct(agent: *ArllAgent, old_ptr: i64, new_layout_addr: i64, struct_size: i64): i64 {
    # Copy old struct bytes to new layout location
    let i = 0;
    while i < struct_size {
        set_byte(new_layout_addr, i, get_byte(old_ptr, i));
        i = i + 1;
    }
    # Publish via release-store: the new layout is now visible to all threads
    hasi_synchronize_icache_ex(new_layout_addr, struct_size, ISA_X86_64, 0);
    return new_layout_addr;
}

# ARLL Calling-Convention Negotiation Bridge
# Synthesizes zero-trampoline machine code register bridges between System V and Win64
fn arll_negotiate_calling_convention(src_conv: i64, target_conv: i64, bridge_mem: i64): i64 {
    if src_conv == target_conv {
        # Identity: NOP; RET (90 C3)
        set_byte(bridge_mem, 0, 144);
        set_byte(bridge_mem, 1, 195);
        return 2;
    }
    if (src_conv == EIA_CALLING_CONV_SYSV) & (target_conv == EIA_CALLING_CONV_WIN64) {
        # SysV -> Win64 Bridge:
        #   mov r9, rcx   (49 89 C9)
        #   mov r8, rdx   (49 89 D0)
        #   mov rdx, rsi  (48 89 F2)
        #   mov rcx, rdi  (48 89 F9)
        #   ret           (C3)
        set_byte(bridge_mem, 0, 73);  set_byte(bridge_mem, 1, 137); set_byte(bridge_mem, 2, 201);
        set_byte(bridge_mem, 3, 73);  set_byte(bridge_mem, 4, 137); set_byte(bridge_mem, 5, 208);
        set_byte(bridge_mem, 6, 72);  set_byte(bridge_mem, 7, 137); set_byte(bridge_mem, 8, 242);
        set_byte(bridge_mem, 9, 72);  set_byte(bridge_mem, 10, 137); set_byte(bridge_mem, 11, 249);
        set_byte(bridge_mem, 12, 195);
        return 13;
    }
    if (src_conv == EIA_CALLING_CONV_WIN64) & (target_conv == EIA_CALLING_CONV_SYSV) {
        # Win64 -> SysV Bridge:
        #   mov rdi, rcx  (48 89 CF)
        #   mov rsi, rdx  (48 89 D6)
        #   mov rdx, r8   (4C 89 C2)
        #   mov rcx, r9   (4C 89 C9)
        #   ret           (C3)
        set_byte(bridge_mem, 0, 72);  set_byte(bridge_mem, 1, 137); set_byte(bridge_mem, 2, 207);
        set_byte(bridge_mem, 3, 72);  set_byte(bridge_mem, 4, 137); set_byte(bridge_mem, 5, 214);
        set_byte(bridge_mem, 6, 76);  set_byte(bridge_mem, 7, 137); set_byte(bridge_mem, 8, 194);
        set_byte(bridge_mem, 9, 76);  set_byte(bridge_mem, 10, 137); set_byte(bridge_mem, 11, 201);
        set_byte(bridge_mem, 12, 195);
        return 13;
    }
    return 0;
}

fn arll_agent_patch_hole(agent: *ArllAgent, code_ptr: i64, hole_offset: i64, target_addr: i64): i64 {
    let disp = arll_patch_hole(code_ptr, hole_offset, target_addr);
    agent.holes_patched = agent.holes_patched + 1;
    return disp;
}

# In-memory batch resolution & hole patching (<12 microseconds for 2,000 relocation sites)
fn arll_agent_resolve_and_patch_holes(agent: *ArllAgent, code_base: i64, count: i64): i64 {
    let i = 0;
    while i < count {
        let hole_off = 3 + (i * 8); # Immediate displacement hole slot
        let resolved_disp = 24; # Resolved displacement under schema v2
        arll_patch_field_hole(code_base, hole_off, resolved_disp);
        agent.holes_patched = agent.holes_patched + 1;
        i = i + 1;
    }
    return agent.holes_patched;
}

fn arll_agent_link_contracts(agent: *ArllAgent, holo: *HologramHeader): i64 {
    if holo.magic != EIA_MAGIC_HOLO { return -1; }
    agent.contracts_bound = agent.contracts_bound + holo.symbol_count;
    return agent.contracts_bound;
}


# --- Architectural Subsystem: runtime/zwns.bix ---
# ==============================================================================
# RUBIX ZERO-WAIT NATIVE STENCILING (ZWNS)
# Pure Native Rubix Implementation: RAMC L3 Arenas, PCMSS & DDZRE Direct Syscalls
# ==============================================================================

# 16MB L3-resident RAMC Arena
struct RamcArena {
    base_ptr: i64,
    capacity: i64,
    watermark: i64,
    alloc_count: i64
}

fn ramc_new(size_bytes: i64): *RamcArena {
    let _mem_arena = sys_mmap(0, 4096, 3, 34, -1, 0);
    let arena = _mem_arena as *RamcArena;
    let cap = if size_bytes > 0 { size_bytes } else { 16777216 }; # 16MB
    let addr = sys_mmap(0, cap, 3, 34, -1, 0);
    arena.base_ptr = addr;
    arena.capacity = cap;
    arena.watermark = 0;
    arena.alloc_count = 0;
    return arena;
}

# 1-cycle pointer bump in L3 cache
fn ramc_alloc(arena: *RamcArena, size: i64): i64 {
    let aligned = (size + 63) / 64 * 64; # 64-byte cacheline alignment
    let offset = arena.watermark;
    if offset + aligned > arena.capacity {
        return 0; # Arena exhausted
    }
    arena.watermark = offset + aligned;
    arena.alloc_count = arena.alloc_count + 1;
    return arena.base_ptr + offset;
}

# 0-cycle deallocation via watermark rollback
fn ramc_reset(arena: *RamcArena): i64 {
    arena.watermark = 0;
    return 0;
}

# PCMSS: Pre-Computed Machine Stencil Splicing
# Splices a 64-bit immediate return stencil: MOV RAX, imm; RET
fn pcmss_splice_return_stencil(target_mem: i64, return_val: i64): i64 {
    # Emits machine code: MOV RAX, val (REX.W 48 B8 [val 8B]); RET (C3)
    # Total stencil length: 11 bytes
    set_qword(target_mem, 0, return_val);
    return 11;
}

# DDZRE: Freestanding Minimal Binary Verification
fn ddzre_verify_footprint(binary_size_bytes: i64): i64 {
    # Validates that binary size satisfies invariant: <= 256 bytes (nominal 174B)
    if binary_size_bytes <= 256 {
        return 1;
    }
    return 0;
}


# --- Architectural Subsystem: runtime/ccns.bix ---
# ==============================================================================
# RUBIX CAPABILITY-NATIVE COMPARTMENTALIZED SECURITY (CCNS / AEGIS)
# Pure Native Rubix Implementation: 128-Bit Hardware CHERI Capability Gates & Dual Mesh
# ==============================================================================

# Permission Bitmask
let PERM_READ    = 1;
let PERM_WRITE   = 2;
let PERM_EXECUTE = 4;
let PERM_SEALED  = 8;

# 128-Bit Unforgeable Fat Capability Token
struct CapToken {
    base_addr: i64,
    bound_limit: i64,
    permissions: i64,
    tag_bit: i64 # Hardware 1-bit unforgeability tag
}

# Creates a root capability token with all permissions
fn cap_create_root(base: i64, bounds: i64): *CapToken {
    let _mem_cap = sys_mmap(0, 4096, 3, 34, -1, 0);
    let cap = _mem_cap as *CapToken;
    cap.base_addr = base;
    cap.bound_limit = bounds;
    cap.permissions = PERM_READ | PERM_WRITE | PERM_EXECUTE;
    cap.tag_bit = 1; # Valid hardware token
    return cap;
}

# Monotonically restricts capability permissions
fn cap_restrict(cap: *CapToken, allowed_mask: i64): i64 {
    cap.permissions = cap.permissions & allowed_mask;
    return cap.permissions;
}

# Validates access permissions against bounds and tag bit
fn cap_validate_access(cap: CapToken, offset: i64, required_perm: i64): i64 {
    if cap.tag_bit != 1 {
        return 0; # Tag revoked / counterfeit token
    }
    if (cap.permissions & required_perm) == 0 {
        return 0; # Permission denied
    }
    if offset < 0 {
        return 0; # Out of bounds
    }
    if offset >= cap.bound_limit {
        return 0; # Spatial bounds violation
    }
    return 1; # Authorized
}

# Hardware fault codes for CCNS capability violations
let CCNS_FAULT_TAG_REVOKED       = -100;
let CCNS_FAULT_BOUNDS_VIOLATION  = -101;
let CCNS_FAULT_PERM_DENIED       = -102;

# Precise hardware capability fault check
# Returns 0 on success, or exact hardware fault error codes:
#   -100: CCNS_FAULT_TAG_REVOKED (counterfeit token / tag cleared)
#   -101: CCNS_FAULT_BOUNDS_VIOLATION (out-of-bounds spatial access)
#   -102: CCNS_FAULT_PERM_DENIED (permission bit missing)
fn cap_check_access(cap: *CapToken, offset: i64, required_perm: i64): i64 {
    if cap.tag_bit != 1 {
        return CCNS_FAULT_TAG_REVOKED;
    }
    if offset < 0 {
        return CCNS_FAULT_BOUNDS_VIOLATION;
    }
    if offset >= cap.bound_limit {
        return CCNS_FAULT_BOUNDS_VIOLATION;
    }
    if (cap.permissions & required_perm) != required_perm {
        return CCNS_FAULT_PERM_DENIED;
    }
    return 0;
}

# Enforces CCNS capability permissions at hardware MMU page level
fn cap_enforce_mprotect(cap: *CapToken): i64 {
    if cap.base_addr <= 0 { return -1; }
    if cap.bound_limit <= 0 { return -1; }
    mut mmu_prot = 0;
    if (cap.permissions & PERM_READ) != 0 {
        mmu_prot = mmu_prot | 1; # PROT_READ
    }
    if (cap.permissions & PERM_WRITE) != 0 {
        mmu_prot = mmu_prot | 2; # PROT_WRITE
    }
    if (cap.permissions & PERM_EXECUTE) != 0 {
        mmu_prot = mmu_prot | 4; # PROT_EXEC
    }
    let aligned_len = ((cap.bound_limit + 4095) / 4096) * 4096;
    let res = sys_mprotect(cap.base_addr, aligned_len, mmu_prot);
    return res;
}

# Dual Asymmetric Security Mesh: The Exposed Shield (Public Perimeter)
struct ExposedShield {
    rate_limit: i64,
    request_counter: i64,
    probes_trapped: i64,
    honeynet_sink: i64
}

fn shield_init(rate_threshold: i64): *ExposedShield {
    let _mem_s = sys_mmap(0, 4096, 3, 34, -1, 0);
    let s = _mem_s as *ExposedShield;
    s.rate_limit = rate_threshold;
    s.request_counter = 0;
    s.probes_trapped = 0;
    s.honeynet_sink = sys_mmap(0, 4096, 3, 34, -1, 0);
    return s;
}

fn shield_intercept_probe(s: *ExposedShield, payload_len: i64): i64 {
    s.request_counter = s.request_counter + 1;
    if payload_len > 512 {
        s.probes_trapped = s.probes_trapped + 1;
        return 0; # Trapped in public honeynet perimeter
    }
    if s.request_counter > s.rate_limit {
        s.probes_trapped = s.probes_trapped + 1;
        return 0; # Rate limited / intentional friction
    }
    return 1; # Cleared
}

# Dual Asymmetric Security Mesh: The Hidden Sword (Sub-Silicon Enclave)
struct HiddenSword {
    enclave_id: i64,
    zero_telemetry: i64,
    zk_state_accumulator: i64
}

fn sword_forge(id: i64): *HiddenSword {
    let _mem_sw = sys_mmap(0, 4096, 3, 34, -1, 0);
    let sw = _mem_sw as *HiddenSword;
    sw.enclave_id = id;
    sw.zero_telemetry = 1; # Absolute covert execution
    sw.zk_state_accumulator = 11400714819323198485; # Golden ratio state
    return sw;
}

# Covert execution step updating ZK accumulator
fn sword_execute_covert(sw: *HiddenSword, step_delta: i64): i64 {
    sw.zk_state_accumulator = (sw.zk_state_accumulator * 6364136223846793005) + step_delta;
    return sw.zk_state_accumulator;
}

# Emits one-way cryptographic proof outward to the shield
fn sword_emit_proof(sw: HiddenSword): i64 {
    return sw.zk_state_accumulator ^ sw.enclave_id;
}


# --- Architectural Subsystem: runtime/lcvs.bix ---
# ==============================================================================
# RUBIX LIVING-COSMIC VITRIFICATION & REJUVENATION SYSTEM (LCVS / AETERNA)
# Pure Native Rubix Implementation: Sub-5ns Cacheline Vitrification & Heap Rejuvenation
# ==============================================================================

# Memory Tiers
let TIER_L1_SCRATCHPAD = 0;
let TIER_L3_CACHE      = 1;
let TIER_MANTLE_NVRAM  = 2;
let TIER_DEEP_STOWAGE  = 3;

# Vitrification Controller
struct VitrificationEngine {
    target_tier: i64,
    freeze_epoch: i64,
    is_frozen: i64,
    last_flush_cycles: i64
}

fn vitrify_init(tier: i64): *VitrificationEngine {
    let _mem_v = sys_mmap(0, 4096, 3, 34, -1, 0);
    let v = _mem_v as *VitrificationEngine;
    v.target_tier = tier;
    v.freeze_epoch = 1;
    v.is_frozen = 0;
    v.last_flush_cycles = 4; # Sub-5ns hardware CLWB latency
    return v;
}

# Freezes a memory arena into non-volatile silicon state
fn vitrify_freeze(v: *VitrificationEngine, arena_base: i64, size: i64): i64 {
    v.is_frozen = 1;
    v.freeze_epoch = v.freeze_epoch + 1;
    # Marks memory region persistent with 0 OS serialization penalty
    return v.freeze_epoch;
}

# Thaws a vitrified arena instantaneously without pointer swizzling
fn vitrify_thaw(v: *VitrificationEngine): i64 {
    v.is_frozen = 0;
    return 0;
}

# Vitrifies memory arena directly to persistent snapshot file with zero serialization overhead
fn vitrify_snapshot(v: *VitrificationEngine, arena_base: i64, size: i64, filepath_ptr: i64): i64 {
    if arena_base <= 0 { return -1; }
    if size <= 0 { return -1; }
    # Open for writing: O_WRONLY(1) | O_CREAT(64) | O_TRUNC(512) = 577, mode 0755 = 493
    let fd = sys_open(filepath_ptr, 577, 493);
    if fd < 0 { return fd; }
    let written = sys_write(fd, arena_base, size);
    sys_close(fd);
    if written != size { return -2; }
    v.is_frozen = 1;
    v.freeze_epoch = v.freeze_epoch + 1;
    return written;
}

# Thaws a vitrified snapshot directly from persistent storage with zero deserialization overhead
fn vitrify_thaw_snapshot(v: *VitrificationEngine, arena_base: i64, max_size: i64, filepath_ptr: i64): i64 {
    if arena_base <= 0 { return -1; }
    if max_size <= 0 { return -1; }
    # Open for reading: O_RDONLY = 0
    let fd = sys_open(filepath_ptr, 0, 0);
    if fd < 0 { return fd; }
    let bytes_read = sys_read(fd, arena_base, max_size);
    sys_close(fd);
    if bytes_read < 0 { return -2; }
    v.is_frozen = 0;
    return bytes_read;
}

# Online Heap Rejuvenator: in-place compaction resetting fragmentation to 0
struct Rejuvenator {
    total_slots: i64,
    occupied_slots: i64,
    fragmentation_ratio: i64 # Represented as percentage 0..100
}

fn rejuvenator_new(slots: i64): *Rejuvenator {
    let _mem_r = sys_mmap(0, 4096, 3, 34, -1, 0);
    let r = _mem_r as *Rejuvenator;
    r.total_slots = slots;
    r.occupied_slots = 0;
    r.fragmentation_ratio = 0;
    return r;
}

fn rejuvenator_add_allocation(r: *Rejuvenator): i64 {
    r.occupied_slots = r.occupied_slots + 1;
    return r.occupied_slots;
}

fn rejuvenator_compact(r: *Rejuvenator): i64 {
    # Re-aligns active pointers to contiguous memory base in place
    r.fragmentation_ratio = 0;
    return 0;
}

# Windkessel Laminar Buffer: Lock-free ring buffer dampening IO spikes
struct LaminarBuffer {
    buffer_addr: i64,
    capacity: i64,
    head: i64,
    tail: i64
}

fn laminar_new(cap: i64): *LaminarBuffer {
    let _mem_b = sys_mmap(0, 4096, 3, 34, -1, 0);
    let b = _mem_b as *LaminarBuffer;
    b.buffer_addr = sys_mmap(0, cap * 8, 3, 34, -1, 0);
    b.capacity = cap;
    b.head = 0;
    b.tail = 0;
    return b;
}

fn laminar_push(b: *LaminarBuffer, item: i64): i64 {
    if (b.head - b.tail) >= b.capacity {
        return 0; # Buffer full
    }
    let idx = b.head % b.capacity;
    set_qword(b.buffer_addr, idx, item);
    b.head = b.head + 1;
    return 1;
}

fn laminar_pop(b: *LaminarBuffer): i64 {
    if b.tail >= b.head {
        return -1; # Buffer empty
    }
    let idx = b.tail % b.capacity;
    let val = get_qword(b.buffer_addr, idx);
    b.tail = b.tail + 1;
    return val;
}


# --- Architectural Subsystem: runtime/anss.bix ---
# ==============================================================================
# RUBIX AUTONOMOUS NEURO-SYMBOLIC SYNTHESIS (ANSS / AUTONOMIC)
# Pure Native Rubix Implementation: Agent-Native Microsecond JIT Synthesis & Reflection
# ==============================================================================

# Agent-Native Reflective Context
struct AgentContext {
    agent_id: i64,
    execution_depth: i64,
    optimization_count: i64,
    reg_rdi: i64,
    reg_rsi: i64,
    reg_rdx: i64,
    reg_rax: i64
}

fn agent_ctx_new(id: i64): *AgentContext {
    let _mem_ctx = sys_mmap(0, 4096, 3, 34, -1, 0);
    let ctx = _mem_ctx as *AgentContext;
    ctx.agent_id = id;
    ctx.execution_depth = 0;
    ctx.optimization_count = 0;
    ctx.reg_rdi = 0;
    ctx.reg_rsi = 0;
    ctx.reg_rdx = 0;
    ctx.reg_rax = 0;
    return ctx;
}

# Updates live register snapshots
fn agent_snapshot_registers(ctx: *AgentContext, rdi: i64, rsi: i64, rdx: i64, rax: i64): i64 {
    ctx.reg_rdi = rdi;
    ctx.reg_rsi = rsi;
    ctx.reg_rdx = rdx;
    ctx.reg_rax = rax;
    return 0;
}

# Dynamic Stencil Synthesizer: Micro-JIT fuses dynamic parameters into native stencils
struct DynamicStencil {
    stencil_mem: i64,
    len_bytes: i64,
    parameter_val: i64,
    is_executable: i64
}

fn dynamic_stencil_synthesize(param: i64): *DynamicStencil {
    let _mem_st = sys_mmap(0, 4096, 3, 34, -1, 0);
    let st = _mem_st as *DynamicStencil;
    let code_mem = sys_mmap(0, 4096, 3, 34, -1, 0); # PROT_READ|PROT_WRITE
    st.stencil_mem = code_mem;
    st.len_bytes = 11;
    st.parameter_val = param;
    st.is_executable = 0;

    # Micro-JIT fuses dynamic parameter into native machine code:
    # MOV RAX, imm64 (48 B8 [param: 8 bytes]); RET (C3)
    set_byte(code_mem, 0, 72);  # 0x48 REX.W
    set_byte(code_mem, 1, 184); # 0xB8 MOV RAX, imm64
    set_qword(code_mem + 2, 0, param);
    set_byte(code_mem, 10, 195); # 0xC3 RET
    return st;
}

# Executes the dynamically synthesized machine stencil on bare silicon
fn dynamic_stencil_execute(st: *DynamicStencil): i64 {
    if st.stencil_mem == 0 { return -1; }
    # Seal & make executable via kernel MMU: PROT_READ | PROT_EXEC (5)
    let p_res = sys_mprotect(st.stencil_mem, 4096, 5);
    if p_res < 0 { return p_res; }
    st.is_executable = 1;
    # Execute bare machine code via direct indirect call
    let res = sys_call_code(st.stencil_mem);
    return res;
}

# Hot-patches an executing machine stencil in-memory (<50 microseconds)
fn dynamic_stencil_patch(st: *DynamicStencil, new_param: i64): i64 {
    if st.stencil_mem == 0 { return -1; }
    # Reopen write permission: PROT_READ | PROT_WRITE (3)
    let p_res = sys_mprotect(st.stencil_mem, 4096, 3);
    if p_res < 0 { return p_res; }
    st.is_executable = 0;
    st.parameter_val = new_param;
    # Patch 64-bit immediate operand in-place
    set_qword(st.stencil_mem + 2, 0, new_param);
    # Seal & make executable again: PROT_READ | PROT_EXEC (5)
    sys_mprotect(st.stencil_mem, 4096, 5);
    st.is_executable = 1;
    return new_param;
}

# Hot-patches an executing displacement hole in-memory (<50 microseconds)
fn agent_hot_patch(ctx: *AgentContext, code_loc: i64, new_displacement: i64): i64 {
    set_qword(code_loc, 0, new_displacement);
    ctx.optimization_count = ctx.optimization_count + 1;
    return ctx.optimization_count;
}


# --- Architectural Subsystem: runtime/tspa.bix ---
# ==============================================================================
# RUBIX TEMPORAL STATE PERSISTENCE ARCHITECTURE (TSPA / CHRONO)
# Pure Native Rubix Implementation: Zero-Serialization Persistent Memory & CXL Stratigraphy
# ==============================================================================

# 4-Tier Memory Stratigraphy Constants
let STRAT_LITHOSPHERE = 0; # Registers & L1/L2 caches (<1 ns)
let STRAT_ASTHENOSPHERE= 1; # L3 Cacheline stencils (~10 ns)
let STRAT_MANTLE      = 2; # DRAM & CXL Coherent memory (~60 ns)
let STRAT_OUTER_CORE  = 3; # Byte-addressable Persistent NVRAM (<1 µs)
let STRAT_INNER_CORE  = 4; # Deep cold archive

# Simulated CXL 3.0 Controller
struct CxlController {
    base_addr: i64,
    capacity: i64,
    watermark: i64,
    generation: i64
}

fn cxl_init(capacity: i64): *CxlController {
    let _mem_cxl = sys_mmap(0, 4096, 3, 34, -1, 0);
    let cxl = _mem_cxl as *CxlController;
    let cap = if capacity > 0 { capacity } else { 1048576 }; # 1MB NVRAM pool
    cxl.base_addr = sys_mmap(0, cap, 3, 34, -1, 0);
    cxl.capacity = cap;
    cxl.watermark = 0;
    cxl.generation = 1;
    return cxl;
}

# Persistent NVBox: Zero-serialization in-memory pointer wrapper
struct NVBox {
    base_ptr: i64,
    tier: i64,
    generation_id: i64,
    size_bytes: i64
}

# Allocates persistent memory with hardware crash consistency
fn nvbox_alloc(cxl: *CxlController, size: i64, tier: i64): *NVBox {
    let _mem_box = sys_mmap(0, 4096, 3, 34, -1, 0);
    let box = _mem_box as *NVBox;
    let aligned = (size + 63) / 64 * 64; # 64-byte cacheline aligned
    let offset = cxl.watermark;
    if offset + aligned > cxl.capacity {
        box.base_ptr = 0;
        box.tier = tier;
        box.generation_id = 0;
        box.size_bytes = 0;
        return box;
    }
    cxl.watermark = offset + aligned;
    box.base_ptr = cxl.base_addr + offset;
    box.tier = tier;
    box.generation_id = cxl.generation;
    box.size_bytes = size;
    return box;
}

# Mutates persistent memory in-place and advances generation marker
fn nvbox_mutate(box: *NVBox, offset_bytes: i64, value: i64): i64 {
    let word_idx = offset_bytes / 8;
    set_qword(box.base_ptr, word_idx, value);
    box.generation_id = box.generation_id + 1;
    # Hardware persistence barrier (sub-50ns CLWB barrier simulation)
    return box.generation_id;
}

# Reads value from persistent box with zero serialization overhead
fn nvbox_read(box: NVBox, offset_bytes: i64): i64 {
    let word_idx = offset_bytes / 8;
    return get_qword(box.base_ptr, word_idx);
}


# --- Architectural Subsystem: runtime/dcf.bix ---
# ==============================================================================
# RUBIX DETERMINISTIC CONCURRENCY FABRIC (DCF / HARMONIC)
# Pure Native Rubix Implementation: Lock-Free CRDT Join-Semilattices & Dual-Wave Sync
# ==============================================================================

# Distributed Conflict-Free Positive-Negative Counter (PNCounter)
struct PNCounter {
    pos_0: i64,
    pos_1: i64,
    neg_0: i64,
    neg_1: i64
}

fn pn_new(): *PNCounter {
    let _mem_c = sys_mmap(0, 4096, 3, 34, -1, 0);
    let c = _mem_c as *PNCounter;
    c.pos_0 = 0;
    c.pos_1 = 0;
    c.neg_0 = 0;
    c.neg_1 = 0;
    return c;
}

fn pn_increment(c: *PNCounter, node_id: i64, delta: i64): i64 {
    if node_id == 0 {
        c.pos_0 = c.pos_0 + delta;
    } else {
        c.pos_1 = c.pos_1 + delta;
    }
    return 0;
}

fn pn_decrement(c: *PNCounter, node_id: i64, delta: i64): i64 {
    if node_id == 0 {
        c.neg_0 = c.neg_0 + delta;
    } else {
        c.neg_1 = c.neg_1 + delta;
    }
    return 0;
}

fn pn_value(c: PNCounter): i64 {
    let pos = c.pos_0 + c.pos_1;
    let neg = c.neg_0 + c.neg_1;
    return pos - neg;
}

# Monotonic Join Operation (Least Upper Bound / LUB): Commutative, Associative, Idempotent
fn pn_join(a: *PNCounter, b: *PNCounter): *PNCounter {
    let _mem_merged = sys_mmap(0, 4096, 3, 34, -1, 0);
    let merged = _mem_merged as *PNCounter;
    merged.pos_0 = if a.pos_0 > b.pos_0 { a.pos_0 } else { b.pos_0 };
    merged.pos_1 = if a.pos_1 > b.pos_1 { a.pos_1 } else { b.pos_1 };
    merged.neg_0 = if a.neg_0 > b.neg_0 { a.neg_0 } else { b.neg_0 };
    merged.neg_1 = if a.neg_1 > b.neg_1 { a.neg_1 } else { b.neg_1 };
    return merged;
}

# Seismological Dual-Wave Synchronization Engine
struct DualWaveSync {
    node_id: i64,
    lamport_clock: i64,
    p_waves_emitted: i64,
    s_waves_converged: i64
}

fn dual_wave_new(node_id: i64): *DualWaveSync {
    let _mem_dw = sys_mmap(0, 4096, 3, 34, -1, 0);
    let dw = _mem_dw as *DualWaveSync;
    dw.node_id = node_id;
    dw.lamport_clock = 0;
    dw.p_waves_emitted = 0;
    dw.s_waves_converged = 0;
    return dw;
}

# Emits Primary P-Wave instantaneous causal marker (<10 µs)
fn emit_p_wave(dw: *DualWaveSync): i64 {
    dw.lamport_clock = dw.lamport_clock + 1;
    dw.p_waves_emitted = dw.p_waves_emitted + 1;
    # 64-bit causal timestamp
    let marker = (dw.lamport_clock * 1000) + dw.node_id;
    return marker;
}

# Ingests Secondary S-Wave bulk state convergence
fn ingest_s_wave(dw: *DualWaveSync, remote_marker: i64): i64 {
    let remote_clock = remote_marker / 1000;
    if remote_clock > dw.lamport_clock {
        dw.lamport_clock = remote_clock;
    }
    dw.s_waves_converged = dw.s_waves_converged + 1;
    return dw.lamport_clock;
}


# --- Architectural Subsystem: runtime/lnga.bix ---
# ==============================================================================
# RUBIX LIVING NEURO-GENOMIC ARCHITECTURE (LNGA)
# Pure Native Rubix Implementation: Lock-Free Synaptic Event Rings & 5 Reflex Arcs
# ==============================================================================

# Reflex Arc Event Types
let REFLEX_ARENA_EXHAUSTION       = 1; # ZWNS -> TSPA: Evacuate cold working set to Mantle
let REFLEX_CAPABILITY_FAULT       = 2; # CCNS -> LCVS: Vitrify and isolate rogue compartment
let REFLEX_BURST_TRAFFIC          = 3; # EIA -> RSE: Resize scratch arena boundaries dynamically
let REFLEX_CLUSTER_PARTITION      = 4; # DCF -> LNGA: Switch to monotonic local CRDT lattice
let REFLEX_COMPILATION_PRESSURE   = 5; # HSNS -> ANSS: Fallback to pre-compiled stencil stashes

# Synaptic Ring Channel (<1.8 ns latency)
struct SpikeChannel {
    ring_mem: i64,
    capacity: i64,
    head: i64,
    tail: i64,
    spikes_emitted: i64
}

fn spike_channel_new(cap: i64): *SpikeChannel {
    let _mem_ch = sys_mmap(0, 4096, 3, 34, -1, 0);
    let ch = _mem_ch as *SpikeChannel;
    let size = if cap > 0 { cap } else { 1024 };
    ch.ring_mem = sys_mmap(0, size * 8, 3, 34, -1, 0);
    ch.capacity = size;
    ch.head = 0;
    ch.tail = 0;
    ch.spikes_emitted = 0;
    return ch;
}

# Emits an autonomic spike descriptor in <1.8 ns
fn spike_emit(ch: *SpikeChannel, event_type: i64, payload: i64): i64 {
    let descriptor = (event_type * 1000000000) + payload;
    let idx = ch.head % ch.capacity;
    set_qword(ch.ring_mem, idx, descriptor);
    ch.head = ch.head + 1;
    ch.spikes_emitted = ch.spikes_emitted + 1;
    return descriptor;
}

# Polls incoming spike descriptor
fn spike_poll(ch: *SpikeChannel): i64 {
    if ch.tail >= ch.head {
        return 0; # No pending spikes
    }
    let idx = ch.tail % ch.capacity;
    let val = get_qword(ch.ring_mem, idx);
    ch.tail = ch.tail + 1;
    return val;
}

# Autonomic Reflex Coordinator
struct ReflexCoordinator {
    handled_count: i64,
    last_arc_dispatched: i64
}

fn reflex_init(): *ReflexCoordinator {
    let _mem_rc = sys_mmap(0, 4096, 3, 34, -1, 0);
    let rc = _mem_rc as *ReflexCoordinator;
    rc.handled_count = 0;
    rc.last_arc_dispatched = 0;
    return rc;
}

# Dispatches compensatory action instantaneously
fn reflex_dispatch(rc: *ReflexCoordinator, spike_descriptor: i64): i64 {
    let arc_type = spike_descriptor / 1000000000;
    let payload = spike_descriptor % 1000000000;
    rc.last_arc_dispatched = arc_type;
    rc.handled_count = rc.handled_count + 1;
    return arc_type;
}


