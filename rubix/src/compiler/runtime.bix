# RUBIX RESIDENT COMPILER DAEMON (RUBIXD / RUBIX SERVER)
# EIA Resident Arena Continuum & Sub-Microsecond Shared Memory IPC
# Bypasses Operating System Process Spawn (Fork/Exec) Overhead (<1 µs turnaround)
# ==============================================================================

# Command Flags
let DAEMON_CMD_COMPILE = 1;
let DAEMON_CMD_RUN     = 2;
