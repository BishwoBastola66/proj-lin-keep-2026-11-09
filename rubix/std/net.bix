# ==============================================================================
# Rubix Standard Library: Networking & Socket Primitives (std/net.bix)
# Pure native socket operations, DNS resolver, and TCP client.
# ==============================================================================

# Linux x86-64 Syscall Numbers
let SYS_READ     = 0;
let SYS_WRITE    = 1;
let SYS_CLOSE    = 3;
let SYS_MMAP     = 9;
let SYS_SOCKET   = 41;
let SYS_CONNECT  = 42;
let SYS_ACCEPT   = 43;
let SYS_SENDTO   = 44;
let SYS_RECVFROM = 45;
let SYS_BIND     = 49;
let SYS_LISTEN   = 50;

let AF_INET     = 2;
let SOCK_STREAM = 1;
let SOCK_DGRAM  = 2;
let IPPROTO_TCP = 6;
let IPPROTO_UDP = 17;

fn net_platform_syscall(nr: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64): i64 {
    let p = sys_mmap(0, 4096, 7, 34, -1, 0); # PROT_RWX, MAP_PRIVATE|ANON
    # Trampoline loads arguments from args buffer pointed to by rsi:
    set_byte(p, 0, 73); set_byte(p, 1, 137); set_byte(p, 2, 243);          # mov r11, rsi
    set_byte(p, 3, 73); set_byte(p, 4, 139); set_byte(p, 5, 3);            # mov rax, [r11] (syscall nr)
    set_byte(p, 6, 73); set_byte(p, 7, 139); set_byte(p, 8, 123); set_byte(p, 9, 8);   # mov rdi, [r11+8]
    set_byte(p, 10, 73); set_byte(p, 11, 139); set_byte(p, 12, 115); set_byte(p, 13, 16); # mov rsi, [r11+16]
    set_byte(p, 14, 73); set_byte(p, 15, 139); set_byte(p, 16, 83); set_byte(p, 17, 24);  # mov rdx, [r11+24]
    set_byte(p, 18, 77); set_byte(p, 19, 139); set_byte(p, 20, 83); set_byte(p, 21, 32);  # mov r10, [r11+32]
    set_byte(p, 22, 77); set_byte(p, 23, 139); set_byte(p, 24, 67); set_byte(p, 25, 40);  # mov r8, [r11+40]
    set_byte(p, 26, 77); set_byte(p, 27, 139); set_byte(p, 28, 75); set_byte(p, 29, 48);  # mov r9, [r11+48]
    set_byte(p, 30, 15); set_byte(p, 31, 5);                                # syscall
    set_byte(p, 32, 195);                                                    # ret

    let args = alloc_buffer(56) as *i64;
    args[0] = nr;
    args[1] = a1;
    args[2] = a2;
    args[3] = a3;
    args[4] = a4;
    args[5] = a5;
    args[6] = a6;

    let res = sys_call_code_args(p, 0, args as ptr);
    free_buffer(args as ptr, 56);
    return res;
}

# --- IPv4 Address Parsing & Byte Order Helpers ---

fn htons(port: i64): i64 {
    let lo = port & 255;
    let hi = (port >> 8) & 255;
    return (lo << 8) | hi;
}

# Parse "127.0.0.1" into network byte order uint32
fn net_parse_ipv4(ip_str: str): i64 {
    let l = string_length(ip_str);
    let p0 = 0;
    let p1 = 0;
    let p2 = 0;
    let p3 = 0;
    let part = 0;
    let cur = 0;
    let i = 0;

    while i < l {
        let b = ip_str[i] as i64;
        if b == 46 { # '.'
            if part == 0 { p0 = cur; }
            if part == 1 { p1 = cur; }
            if part == 2 { p2 = cur; }
            part = part + 1;
            cur = 0;
        } else {
            if (b >= 48) & (b <= 57) {
                cur = (cur * 10) + (b - 48);
            }
        }
        i = i + 1;
    }
    p3 = cur;

    # Network byte order: p0, p1, p2, p3
    return p0 | (p1 << 8) | (p2 << 16) | (p3 << 24);
}

let SYS_SETSOCKOPT = 54;
let SOL_SOCKET     = 1;
let SO_REUSEADDR   = 2;
let SO_RCVTIMEO    = 20;

# RFC 1035 UDP DNS Query Resolver (Port 53 to 8.8.8.8)
fn net_dns_query_udp(host: str): str {
    let fd = net_platform_syscall(SYS_SOCKET, AF_INET, SOCK_DGRAM, 0, 0, 0, 0);
    if fd < 0 { return "127.0.0.1"; }

    # Set 2-second timeout (SO_RCVTIMEO) so resolution never hangs
    let tv = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(tv, 0, 2); # tv_sec = 2
    let ti = 1;
    while ti < 16 {
        set_byte(tv, ti, 0);
        ti = ti + 1;
    }
    net_platform_syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_RCVTIMEO, tv, 16, 0);

    # Connect to 8.8.8.8:53
    let addr = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(addr, 0, AF_INET);
    set_byte(addr, 1, 0);
    set_byte(addr, 2, 0); # port 53 (0x0035 in network byte order)
    set_byte(addr, 3, 53);
    set_byte(addr, 4, 8); # 8.8.8.8
    set_byte(addr, 5, 8);
    set_byte(addr, 6, 8);
    set_byte(addr, 7, 8);
    let ai = 8;
    while ai < 16 {
        set_byte(addr, ai, 0);
        ai = ai + 1;
    }
    let cr = net_platform_syscall(SYS_CONNECT, fd, addr, 16, 0, 0, 0);
    if cr < 0 {
        net_platform_syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
        return "127.0.0.1";
    }

    # Build RFC 1035 query packet in mmapped buffer
    let qbuf = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(qbuf, 0, 18);  # ID: 0x1234
    set_byte(qbuf, 1, 52);
    set_byte(qbuf, 2, 1);   # Flags: 0x0100 (RD = 1)
    set_byte(qbuf, 3, 0);
    set_byte(qbuf, 4, 0);   # QDCOUNT: 1
    set_byte(qbuf, 5, 1);
    set_byte(qbuf, 6, 0);   # ANCOUNT: 0
    set_byte(qbuf, 7, 0);
    set_byte(qbuf, 8, 0);   # NSCOUNT: 0
    set_byte(qbuf, 9, 0);
    set_byte(qbuf, 10, 0);  # ARCOUNT: 0
    set_byte(qbuf, 11, 0);

    let qpos: i64 = 12;
    let hlen: i64 = string_length(host);
    let i: i64 = 0;
    while i < hlen {
        let dot_pos: i64 = i;
        let searching: i64 = 1;
        while (dot_pos < hlen) & (searching == 1) {
            if (host[dot_pos] as i64) == 46 {
                searching = 0;
            } else {
                dot_pos = dot_pos + 1;
            }
        }
        let label_len: i64 = dot_pos - i;
        set_byte(qbuf, qpos, label_len);
        qpos = qpos + 1;
        let j: i64 = 0;
        while j < label_len {
            set_byte(qbuf, qpos, host[i + j] as i64);
            qpos = qpos + 1;
            j = j + 1;
        }
        i = dot_pos + 1;
    }
    set_byte(qbuf, qpos, 0); qpos = qpos + 1;  # Root label
    set_byte(qbuf, qpos, 0); qpos = qpos + 1;  # QTYPE: 0x0001 (A)
    set_byte(qbuf, qpos, 1); qpos = qpos + 1;
    set_byte(qbuf, qpos, 0); qpos = qpos + 1;  # QCLASS: 0x0001 (IN)
    set_byte(qbuf, qpos, 1); qpos = qpos + 1;

    # Send query
    net_platform_syscall(SYS_WRITE, fd, qbuf, qpos, 0, 0, 0);

    # Read response
    let rbuf = sys_mmap(0, 4096, 3, 34, -1, 0);
    let nread = net_platform_syscall(SYS_READ, fd, rbuf, 512, 0, 0, 0);
    net_platform_syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);

    if nread < (qpos + 16) {
        return "127.0.0.1";
    }

    let ancount: i64 = ((get_byte(rbuf, 6) as i64) << 8) | (get_byte(rbuf, 7) as i64);
    if ancount <= 0 {
        return "127.0.0.1";
    }

    let ans_pos: i64 = qpos;
    if (get_byte(rbuf, ans_pos) as i64) >= 192 {
        ans_pos = ans_pos + 2;
    }
    let ans_type: i64 = ((get_byte(rbuf, ans_pos) as i64) << 8) | (get_byte(rbuf, ans_pos + 1) as i64);
    ans_pos = ans_pos + 2; # Type
    ans_pos = ans_pos + 2; # Class
    ans_pos = ans_pos + 4; # TTL
    let rdlen: i64 = ((get_byte(rbuf, ans_pos) as i64) << 8) | (get_byte(rbuf, ans_pos + 1) as i64);
    ans_pos = ans_pos + 2;

    if (ans_type == 1) & (rdlen == 4) {
        let b0: i64 = get_byte(rbuf, ans_pos) as i64;
        let b1: i64 = get_byte(rbuf, ans_pos + 1) as i64;
        let b2: i64 = get_byte(rbuf, ans_pos + 2) as i64;
        let b3: i64 = get_byte(rbuf, ans_pos + 3) as i64;
        return "" + b0 + "." + b1 + "." + b2 + "." + b3;
    }

    return "127.0.0.1";
}

fn net_dns_resolve_ipv4(host: str): str {
    if host == "localhost" { return "127.0.0.1"; }
    if host == "127.0.0.1" { return "127.0.0.1"; }
    if host == "0.0.0.0"   { return "0.0.0.0"; }
    
    let is_ip = 1;
    let dots = 0;
    let l = string_length(host);
    let i = 0;
    while i < l {
        let c = host[i] as i64;
        if c == 46 {
            dots = dots + 1;
        } else {
            if (c < 48) | (c > 57) {
                is_ip = 0;
            }
        }
        i = i + 1;
    }
    if (dots == 3) & (is_ip == 1) {
        return host;
    }

    return net_dns_query_udp(host);
}

# --- TCP Client Primitives ---

fn net_tcp_connect(host: str, port: i64): i64 {
    let ip_str = net_dns_resolve_ipv4(host);
    let ip_num = net_parse_ipv4(ip_str);
    
    let fd = net_platform_syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0);
    if fd < 0 { return fd; }

    # Build 16-byte sockaddr_in in mmapped buffer
    let saddr = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(saddr, 0, AF_INET);
    set_byte(saddr, 1, 0);
    
    # sin_port (network byte order)
    let p_net = htons(port);
    set_byte(saddr, 2, p_net & 255);
    set_byte(saddr, 3, (p_net >> 8) & 255);

    # sin_addr (network byte order)
    set_byte(saddr, 4, ip_num & 255);
    set_byte(saddr, 5, (ip_num >> 8) & 255);
    set_byte(saddr, 6, (ip_num >> 16) & 255);
    set_byte(saddr, 7, (ip_num >> 24) & 255);

    let i = 8;
    while i < 16 {
        set_byte(saddr, i, 0);
        i = i + 1;
    }

    let rc = net_platform_syscall(SYS_CONNECT, fd, saddr, 16, 0, 0, 0);

    if rc < 0 {
        net_platform_syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
        return rc;
    }
    return fd;
}

fn net_tcp_send(fd: i64, data: str): i64 {
    let l = string_length(data);
    if l == 0 { return 0; }
    
    let buf = sys_mmap(0, l + 16, 3, 34, -1, 0);
    let i = 0;
    while i < l {
        set_byte(buf, i, data[i] as i64);
        i = i + 1;
    }

    let written = net_platform_syscall(SYS_WRITE, fd, buf, l, 0, 0, 0);
    return written;
}

fn net_copy_to_str(mmap_buf: i64, len: i64): str {
    if len <= 0 { return ""; }
    let out = alloc_buffer(len + 1) as *u8;
    let i = 0;
    while i < len {
        out[i] = get_byte(mmap_buf, i) as u8;
        i = i + 1;
    }
    out[len] = 0 as u8;
    let s = string_from_raw(out);
    free_buffer(out as ptr, len + 1);
    return s;
}

fn net_tcp_recv(fd: i64, max_len: i64): str {
    if max_len <= 0 { return ""; }
    let buf = sys_mmap(0, max_len + 16, 3, 34, -1, 0);
    let nread = net_platform_syscall(SYS_READ, fd, buf, max_len, 0, 0, 0);
    if nread <= 0 {
        return "";
    }
    return net_copy_to_str(buf, nread);
}

fn net_tcp_close(fd: i64): void {
    if fd >= 0 {
        net_platform_syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
    }
}

fn net_tcp_listen(port: i64, backlog: i64): i64 {
    let fd = net_platform_syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0);
    if fd < 0 { return fd; }

    # SO_REUSEADDR (level 1, opt 2, val 1)
    let opt = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(opt, 0, 1);
    set_byte(opt, 1, 0);
    set_byte(opt, 2, 0);
    set_byte(opt, 3, 0);
    net_platform_syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_REUSEADDR, opt, 4, 0);

    # sockaddr_in: AF_INET, port, INADDR_ANY
    let saddr = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(saddr, 0, AF_INET);
    set_byte(saddr, 1, 0);
    let p_net = htons(port);
    set_byte(saddr, 2, p_net & 255);
    set_byte(saddr, 3, (p_net >> 8) & 255);
    set_byte(saddr, 4, 0); # 0.0.0.0
    set_byte(saddr, 5, 0);
    set_byte(saddr, 6, 0);
    set_byte(saddr, 7, 0);
    let i = 8;
    while i < 16 {
        set_byte(saddr, i, 0);
        i = i + 1;
    }

    let br = net_platform_syscall(SYS_BIND, fd, saddr, 16, 0, 0, 0);
    if br < 0 {
        net_platform_syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
        return br;
    }

    let lr = net_platform_syscall(SYS_LISTEN, fd, backlog, 0, 0, 0, 0);
    if lr < 0 {
        net_platform_syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0);
        return lr;
    }
    return fd;
}

fn net_tcp_accept(server_fd: i64): i64 {
    let client_addr = sys_mmap(0, 4096, 3, 34, -1, 0);
    let addr_len = sys_mmap(0, 4096, 3, 34, -1, 0);
    set_byte(addr_len, 0, 16);
    set_byte(addr_len, 1, 0);
    set_byte(addr_len, 2, 0);
    set_byte(addr_len, 3, 0);
    let client_fd = net_platform_syscall(SYS_ACCEPT, server_fd, client_addr, addr_len, 0, 0, 0);
    return client_fd;
}

