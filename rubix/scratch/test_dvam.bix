fn main(): i64 {
    let page_aligned_len = 4096;
    let memfd_name = sys_mmap(0, 64, 3, 34, -1, 0);
    set_byte(memfd_name, 0, 114); set_byte(memfd_name, 1, 117); set_byte(memfd_name, 2, 98); # "rubix_dvam\0"
    set_byte(memfd_name, 3, 105); set_byte(memfd_name, 4, 120); set_byte(memfd_name, 5, 95);
    set_byte(memfd_name, 6, 100); set_byte(memfd_name, 7, 118); set_byte(memfd_name, 8, 97);
    set_byte(memfd_name, 9, 109); set_byte(memfd_name, 10, 0);
    let memfd = sys_memfd_create(memfd_name, 0);
    sys_munmap(memfd_name, 64);

    let res_trunc = sys_ftruncate(memfd, page_aligned_len);
    let v_write = sys_mmap(0, page_aligned_len, 3, 1, memfd, 0);
    let v_exec  = sys_mmap(0, page_aligned_len, 5, 1, memfd, 0);

    print(memfd);
    print(res_trunc);
    print(v_write);
    print(v_exec);

    # Write a simple ret to v_write
    set_byte(v_write, 0, 184); # mov eax, 42
    set_byte(v_write, 1, 42);
    set_byte(v_write, 2, 0);
    set_byte(v_write, 3, 0);
    set_byte(v_write, 4, 0);
    set_byte(v_write, 5, 195); # ret

    let r = sys_call_code(v_exec);
    print(r);
    return r;
}
