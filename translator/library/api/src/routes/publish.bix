# ==============================================================================
# Rubix Library API: Publish Route (/v1/publish)
# File: library/api/src/routes/publish.bix
# ==============================================================================

use std.core;
use std.string;
use std.json;

fn api_handle_publish(name: str, version: str, integrity: str, ai_verdict: str): str {
    let lb = json_lbrace();
    let rb = json_rbrace();

    let enc_status = json_encode_str("published");
    let enc_name = json_encode_str(name);
    let enc_ver = json_encode_str(version);
    let enc_integ = json_encode_str(integrity);
    let enc_verdict = json_encode_str(ai_verdict);

    let part_status = json_build_pair("status", enc_status);
    let part_name = json_build_pair("name", enc_name);
    let part_ver = json_build_pair("version", enc_ver);
    let part_integ = json_build_pair("integrity", enc_integ);
    let part_verdict = json_build_pair("ai_verdict", enc_verdict);

    let resp = lb + part_status + "," + part_name + "," + part_ver + "," + part_integ + "," + part_verdict + rb;
    return resp;
}
