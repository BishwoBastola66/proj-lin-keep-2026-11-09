# ==============================================================================
# Yugant Xettri Portfolio — Automated Test Battery (tests/test_portfolio.bix)
# ==============================================================================

include "../App.bix";

fn test_portfolio_initialization(): i64 {
    let app = create_portfolio_app();
    if app.web_app.node_count <= 0 { return 0; }

    # Verify reactive state store initial values
    if StateGet(app, "views") != 4820 { return 0; }
    if StateGet(app, "stars") != 1250 { return 0; }
    if StateGet(app, "downloads") != 28400 { return 0; }
    if StateGet(app, "theme_dark") != 1 { return 0; }

    return 1;
}

fn test_portfolio_state_mutations(): i64 {
    let app = create_portfolio_app();

    StateInc(app, "views");
    if StateGet(app, "views") != 4821 { return 0; }

    StateInc(app, "stars");
    StateInc(app, "stars");
    if StateGet(app, "stars") != 1252 { return 0; }

    return 1;
}

fn test_portfolio_build(): i64 {
    let app = create_portfolio_app();
    let b = Build(app);
    if b != 42 { return 0; }
    return 1;
}

fn main(): i64 {
    if test_portfolio_initialization() != 1 { return 1; }
    if test_portfolio_state_mutations() != 1 { return 2; }
    if test_portfolio_build() != 1 { return 3; }

    # All tests passed!
    return 42;
}
