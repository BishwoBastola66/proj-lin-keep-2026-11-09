# ==============================================================================
# Webbix Framework — Beginner-First Sweet High-Level Benchmark Suite
# File: webbix/examples/beginner_suite.bix
#
# Proves that a person knowing only basic variables, functions, conditions, and loops
# can build modern web applications in Rubix without knowing HTML, CSS, JavaScript,
# React, Next.js, or Tailwind.
#
# 10 Progressive Examples:
#   1. Hello World page
#   2. Personal portfolio
#   3. Counter (interactive reactive state)
#   4. Todo application (structured nested lists)
#   5. Form with validation (typed inputs)
#   6. Responsive dashboard (reactive metrics grid)
#   7. Animated landing page (native animations)
#   8. Data-fetching application (dynamic state binding)
#   9. Authentication-style UI (credential input forms)
#  10. Complete production-style application (REX + DOM mutation lowering)
#
# Built strictly with:
#   RUBIX -> Rubix Web IR -> REX -> Browser Host -> Pixels
# Zero HTML strings, zero CSS rules, zero JavaScript dependencies.
# ==============================================================================

include "../webbix.bix";

# 1. Hello World Page
fn example_1_hello_world(): i64 {
    let app = App("Hello World");
    Page(app, "/", "Hello World");
        Title(app, "Hello, Rubix Web!");
        Text(app, "Welcome to native web development without HTML or CSS.");
    End(app);

    if app.web_app.node_count != 3 { return 0; }
    return 1;
}

# 2. Personal Portfolio
fn example_2_personal_portfolio(): i64 {
    let app = App("My Portfolio");
    Page(app, "/", "Developer Portfolio");
        Navbar(app, "DevName", "Available for Hire", "Work", "#work", "About", "#about");
        Hero(app, "Systems", "Building Software From Scratch", "Full-Stack Systems Engineer", "View Work", "#work");
        Section(app, "Featured Projects", "Compilers and native runtimes.");
            Grid(app, 2);
                ProjectCard(app, "Language", "Rubix", "Self-bootstrapping compiler", "Source", "x86-64");
            End(app);
        End(app);
    End(app);

    if app.web_app.node_count < 7 { return 0; }
    return 1;
}

# 3. Interactive Counter Application
fn example_3_counter_app(): i64 {
    let app = App("Counter");
    State(app, "count", 0);

    Page(app, "/", "Counter");
        Hero(app, "Interactive", "Counter", "State management", "Learn More", "/");
        Button(app, "+ Increment", "count");
        Stats(app);
            StatReactive(app, "Count", "count");
        End(app);
    End(app);

    # Simulate 3 interactive click events dispatched via REX runtime
    DispatchClick(app, 5); # click 1
    DispatchClick(app, 5); # click 2
    DispatchClick(app, 5); # click 3

    if StateGet(app, "count") != 3 { return 0; }
    return 1;
}

# 4. Todo Application Structure
fn example_4_todo_application(): i64 {
    let app = App("Todo List");
    State(app, "todos", 3);

    Page(app, "/", "Todo App");
        Section(app, "Active Tasks", "Items pending execution");
            Grid(app, 1);
                Card(app, "Implement Lexer");
                    Badge(app, "Done");
                End(app);
                Card(app, "Implement REX Bridge");
                    Badge(app, "In Progress");
                End(app);
                Card(app, "Emit Native Pixels");
                    Badge(app, "Ready");
                End(app);
            End(app);
        End(app);
    End(app);

    if app.web_app.node_count < 8 { return 0; }
    return 1;
}

# 5. Form With Validation
fn example_5_form_with_validation(): i64 {
    let app = App("User Registration");
    State(app, "username", 0);
    State(app, "email", 0);
    State(app, "password", 0);

    Page(app, "/register", "Register");
        Form(app, 501);
            InputKind(app, WebInputKind.Text as i64, "Username", "username");
            InputKind(app, WebInputKind.Email as i64, "Email Address", "email");
            InputKind(app, WebInputKind.Password as i64, "Password", "password");
            Submit(app, "Create Account");
        End(app);
    End(app);

    if app.web_app.node_count < 5 { return 0; }
    return 1;
}

# 6. Responsive Dashboard
fn example_6_responsive_dashboard(): i64 {
    let app = App("Systems Dashboard");
    State(app, "cpu_health", 98);

    Page(app, "/dashboard", "Analytics");
        Stats(app);
            StatReactive(app, "CPU Health (%)", "cpu_health");
            StatMetric(app, "Network IO", "1.2 GB/s");
            StatMetric(app, "Syscall Latency", "0.4 µs");
            StatMetric(app, "Active Conns", "4,210");
        End(app);
    End(app);

    if app.web_app.node_count < 6 { return 0; }
    if StateGet(app, "cpu_health") != 98 { return 0; }
    return 1;
}

# 7. Animated Landing Page
fn example_7_animated_landing_page(): i64 {
    let app = App("Landing Page");

    Page(app, "/", "Fast Next-Gen Runtimes");
        Hero(app, "Fast Runtimes", "Instant Native Web Applications", "Zero JS", "Start Free", "/signup");
        Animate(app, WebAnimation.SlideUp);
    End(app);

    if app.web_app.nodes[0].style.animation != WebAnimation.SlideUp { return 0; }
    return 1;
}

# 8. Data-Fetching Application
fn example_8_data_fetching_app(): i64 {
    let app = App("Data Viewer");
    State(app, "http_status", 200);

    Page(app, "/data", "API Data");
        Section(app, "Live Data Stream", "Connected to native REX TCP runtime");
            Stats(app);
                StatReactive(app, "HTTP Status", "http_status");
            End(app);
        End(app);
    End(app);

    if StateGet(app, "http_status") != 200 { return 0; }
    return 1;
}

# 9. Authentication-Style UI
fn example_9_authentication_ui(): i64 {
    let app = App("Sign In");
    State(app, "email", 0);
    State(app, "password", 0);

    Page(app, "/login", "Secure Login");
        Hero(app, "Cloud Access", "Welcome Back", "Sign in to your account", "Explore", "/");
        Form(app, 901);
            InputKind(app, WebInputKind.Email as i64, "name@company.com", "email");
            InputKind(app, WebInputKind.Password as i64, "••••••••", "password");
            Submit(app, "Sign In");
        End(app);
    End(app);

    if app.web_app.node_count < 6 { return 0; }
    return 1;
}

# 10. Complete Production-Style Application
fn example_10_production_application(): i64 {
    let app = App("Enterprise App");
    State(app, "active_nodes", 128);

    Page(app, "/", "Enterprise Platform");
        Navbar(app, "CloudPlatform", "Online", "Status", "/status", "Docs", "/docs");
        Hero(app, "Compute", "Scale Without Limits", "Distributed native compute", "Get Started", "/get-started");
        Stats(app);
            StatReactive(app, "Active Nodes", "active_nodes");
            StatMetric(app, "Uptime", "99.999%");
        End(app);
        Footer(app, "Enterprise Inc. All rights reserved.");
    End(app);

    # Verify native build & REX Lowering
    let b_res = Build(app);
    if b_res != 42 { return 0; }

    # Verify DOM Mutation Lowering
    let muts: [DomMutationRecord; 32];
    let mut_count = rex_web_app_to_dom_mutations(app.web_app, &muts[0], 32);
    if mut_count < 6 { return 0; }

    return 1;
}

fn main(): i64 {
    if example_1_hello_world() != 1 { return 1; }
    if example_2_personal_portfolio() != 1 { return 2; }
    if example_3_counter_app() != 1 { return 3; }
    if example_4_todo_application() != 1 { return 4; }
    if example_5_form_with_validation() != 1 { return 5; }
    if example_6_responsive_dashboard() != 1 { return 6; }
    if example_7_animated_landing_page() != 1 { return 7; }
    if example_8_data_fetching_app() != 1 { return 8; }
    if example_9_authentication_ui() != 1 { return 9; }
    if example_10_production_application() != 1 { return 10; }

    # All 10 high-level progressive examples passed cleanly!
    return 42;
}
