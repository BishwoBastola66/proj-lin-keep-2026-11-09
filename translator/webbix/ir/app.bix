# ==============================================================================
# Webbix Web IR — Application Container & State Graph (webbix/ir/app.bix)
# Pure typed Rubix Web Application Graph and Reactive State Store.
#
# Unified container holding the node tree and named state store.
# Strictly <= 16 fields per struct.
# ==============================================================================

include "node.bix";

# ------------------------------------------------------------------------------
# Route Entry
# ------------------------------------------------------------------------------
struct WebRoute {
    path: str,
    title: str,
    component_id: i64,
    layout_id: i64,
    is_dynamic: i64,
    param_name: str,
    is_404: i64,
    theme: i64
}

fn web_route_init(r: *WebRoute): void {
    r.path = "/";
    r.title = "";
    r.component_id = -1;
    r.layout_id = -1;
    r.is_dynamic = 0;
    r.param_name = "";
    r.is_404 = 0;
    r.theme = WebTheme.Dark;
}

# ------------------------------------------------------------------------------
# Application Container (11 fields <= 16)
# ------------------------------------------------------------------------------
struct WebApp {
    name: str,
    route: str,
    title: str,
    description: str,
    canonical_url: str,
    node_count: i64,
    root_id: i64,
    nodes: [WebNode; 96],
    state_keys: [i64; 32],
    state_vals: [i64; 32],
    state_count: i64,
    theme: i64
}

fn web_app_init(app: *WebApp, name: str): void {
    app.name = name;
    app.route = "/";
    app.title = name;
    app.description = "";
    app.canonical_url = "";
    app.node_count = 0;
    app.root_id = -1;
    app.state_count = 0;
    app.theme = WebTheme.Dark;

    let i = 0;
    while i < 32 {
        app.state_keys[i] = 0;
        app.state_vals[i] = 0;
        i = i + 1;
    }
}

fn web_app_set_state(app: *WebApp, key: i64, val: i64): void {
    let i = 0;
    while i < app.state_count {
        if app.state_keys[i] == key {
            app.state_vals[i] = val;
            return;
        }
        i = i + 1;
    }
    if app.state_count < 32 {
        let idx = app.state_count;
        app.state_keys[idx] = key;
        app.state_vals[idx] = val;
        app.state_count = app.state_count + 1;
    }
}

fn web_app_get_state(app: *WebApp, key: i64): i64 {
    let i = 0;
    while i < app.state_count {
        if app.state_keys[i] == key {
            return app.state_vals[i];
        }
        i = i + 1;
    }
    return 0;
}

fn web_app_increment_state(app: *WebApp, key: i64): i64 {
    let cur = web_app_get_state(app, key);
    let nxt = cur + 1;
    web_app_set_state(app, key, nxt);
    return nxt;
}

fn web_app_decrement_state(app: *WebApp, key: i64): i64 {
    let cur = web_app_get_state(app, key);
    let nxt = cur - 1;
    web_app_set_state(app, key, nxt);
    return nxt;
}

fn web_app_toggle_state(app: *WebApp, key: i64): i64 {
    let cur = web_app_get_state(app, key);
    let nxt = 0;
    if cur == 0 {
        nxt = 1;
    }
    web_app_set_state(app, key, nxt);
    return nxt;
}

fn web_app_add_node(app: *WebApp, kind: i64, parent_id: i64): i64 {
    if app.node_count >= 96 {
        return -1;
    }
    let id = app.node_count;
    app.nodes[id].id = id;
    app.nodes[id].kind = kind;
    app.nodes[id].parent_id = parent_id;
    app.nodes[id].child_count = 0;
    app.nodes[id].text = "";
    app.nodes[id].aux_text = "";
    app.nodes[id].desc = "";
    app.nodes[id].link_url = "";
    app.nodes[id].placeholder = "";
    app.nodes[id].input_kind = WebInputKind.Text;

    # Direct field initialization
    app.nodes[id].style.layout = WebLayout.Column;
    app.nodes[id].style.align = WebAlign.Start;
    app.nodes[id].style.justify = WebAlign.Start;
    app.nodes[id].style.gap = 0;
    app.nodes[id].style.padding_x = 0;
    app.nodes[id].style.padding_y = 0;
    app.nodes[id].style.text_color = WebColor.Default;
    app.nodes[id].style.bg_color = WebColor.Default;
    app.nodes[id].style.border_color = WebColor.Transparent;
    app.nodes[id].style.text_size = WebTextSize.Md;
    app.nodes[id].style.weight = WebWeight.Normal;
    app.nodes[id].style.radius = WebRadius.None;
    app.nodes[id].style.shadow = WebShadow.None;
    app.nodes[id].style.animation = WebAnimation.None;
    app.nodes[id].style.columns = 1;
    app.nodes[id].style.is_responsive = 0;

    app.nodes[id].event.event_kind = WebEventKind.None;
    app.nodes[id].event.action_kind = WebActionKind.None;
    app.nodes[id].event.target_state_key = 0;
    app.nodes[id].event.payload_val = 0;

    app.nodes[id].state_binding = 0;
    app.nodes[id].state_value = 0;
    app.nodes[id].render_mode = WebRenderMode.Client;
    app.nodes[id].is_active = 1;
    app.node_count = app.node_count + 1;

    if parent_id >= 0 {
        app.nodes[parent_id].child_count = app.nodes[parent_id].child_count + 1;
    } else {
        if app.root_id < 0 {
            app.root_id = id;
        }
    }
    return id;
}

fn web_app_evaluate_bindings(app: *WebApp): void {
    let i = 0;
    while i < app.node_count {
        let b = app.nodes[i].state_binding;
        if b > 0 {
            app.nodes[i].state_value = web_app_get_state(app, b);
        }
        i = i + 1;
    }
}
