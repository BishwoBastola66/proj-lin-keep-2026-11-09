# ==============================================================================
# Webbix Web IR — Native Declarative Builders (webbix/ir/builder.bix)
# Pure Rubix developer interface for constructing modern Web IR trees.
# Zero HTML tags, zero CSS rules, zero string concatenation.
#
# These are the low-level building blocks. Application developers use
# the high-level App API in declarative/app.bix instead.
# ==============================================================================

include "app.bix";

# ==============================================================================
# Document Structure
# ==============================================================================

fn web_page(app: *WebApp, route: str, title: str): i64 {
    app.route = route;
    app.title = title;
    let page_id = web_app_add_node(app, WebKind.Page, -1);
    app.nodes[page_id].text = title;
    app.nodes[page_id].link_url = route;
    return page_id;
}

fn web_header(app: *WebApp, parent_id: i64): i64 {
    let id = web_app_add_node(app, WebKind.Header, parent_id);
    return id;
}

fn web_main(app: *WebApp, parent_id: i64): i64 {
    let id = web_app_add_node(app, WebKind.Main, parent_id);
    return id;
}

# ==============================================================================
# Navigation
# ==============================================================================

fn web_nav(app: *WebApp, parent_id: i64, brand_title: str, badge_text: str): i64 {
    let nav_id = web_app_add_node(app, WebKind.Nav, parent_id);
    app.nodes[nav_id].text = brand_title;
    app.nodes[nav_id].aux_text = badge_text;
    return nav_id;
}

fn web_nav_link(app: *WebApp, nav_id: i64, label: str, url: str): i64 {
    let link_id = web_app_add_node(app, WebKind.NavLink, nav_id);
    app.nodes[link_id].text = label;
    app.nodes[link_id].link_url = url;
    return link_id;
}

# ==============================================================================
# Content Sections
# ==============================================================================

fn web_hero(app: *WebApp, parent_id: i64, pretitle: str): i64 {
    let hero_id = web_app_add_node(app, WebKind.Hero, parent_id);
    app.nodes[hero_id].aux_text = pretitle;
    app.nodes[hero_id].style.animation = WebAnimation.FadeIn;
    return hero_id;
}

fn web_section(app: *WebApp, parent_id: i64, title: str, desc: str): i64 {
    let sec_id = web_app_add_node(app, WebKind.Section, parent_id);
    app.nodes[sec_id].text = title;
    app.nodes[sec_id].desc = desc;
    return sec_id;
}

fn web_article(app: *WebApp, parent_id: i64, title: str): i64 {
    let id = web_app_add_node(app, WebKind.Article, parent_id);
    app.nodes[id].text = title;
    return id;
}

fn web_aside(app: *WebApp, parent_id: i64): i64 {
    let id = web_app_add_node(app, WebKind.Aside, parent_id);
    return id;
}

# ==============================================================================
# Typography
# ==============================================================================

fn web_title(app: *WebApp, parent_id: i64, title_text: str): i64 {
    let title_id = web_app_add_node(app, WebKind.Title, parent_id);
    app.nodes[title_id].text = title_text;
    app.nodes[title_id].style.text_size = WebTextSize.Display1;
    app.nodes[title_id].style.weight = WebWeight.Bold;
    return title_id;
}

fn web_heading(app: *WebApp, parent_id: i64, heading_text: str, level: i64): i64 {
    let heading_id = web_app_add_node(app, WebKind.Heading, parent_id);
    app.nodes[heading_id].text = heading_text;
    app.nodes[heading_id].style.text_size = WebTextSize.Xl2;
    app.nodes[heading_id].style.weight = WebWeight.SemiBold;
    return heading_id;
}

fn web_text(app: *WebApp, parent_id: i64, body_text: str): i64 {
    let text_id = web_app_add_node(app, WebKind.Text, parent_id);
    app.nodes[text_id].text = body_text;
    return text_id;
}

fn web_paragraph(app: *WebApp, parent_id: i64, p_text: str): i64 {
    let id = web_app_add_node(app, WebKind.Paragraph, parent_id);
    app.nodes[id].text = p_text;
    return id;
}

# ==============================================================================
# Interactive Elements
# ==============================================================================

fn web_button(app: *WebApp, parent_id: i64, label: str): i64 {
    let btn_id = web_app_add_node(app, WebKind.Button, parent_id);
    app.nodes[btn_id].text = label;
    app.nodes[btn_id].style.radius = WebRadius.Md;
    app.nodes[btn_id].style.padding_x = 16;
    app.nodes[btn_id].style.padding_y = 10;
    return btn_id;
}

# ==============================================================================
# Event Handlers & State Modifiers
# ==============================================================================

fn web_on_click_increment(app: *WebApp, node_id: i64, state_key: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].event.event_kind = WebEventKind.Click;
    app.nodes[node_id].event.action_kind = WebActionKind.IncrementState;
    app.nodes[node_id].event.target_state_key = state_key;
}

fn web_on_click_decrement(app: *WebApp, node_id: i64, state_key: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].event.event_kind = WebEventKind.Click;
    app.nodes[node_id].event.action_kind = WebActionKind.DecrementState;
    app.nodes[node_id].event.target_state_key = state_key;
}

fn web_on_click_toggle(app: *WebApp, node_id: i64, state_key: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].event.event_kind = WebEventKind.Click;
    app.nodes[node_id].event.action_kind = WebActionKind.ToggleState;
    app.nodes[node_id].event.target_state_key = state_key;
}

fn web_on_click_set(app: *WebApp, node_id: i64, state_key: i64, value: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].event.event_kind = WebEventKind.Click;
    app.nodes[node_id].event.action_kind = WebActionKind.SetState;
    app.nodes[node_id].event.target_state_key = state_key;
    app.nodes[node_id].event.payload_val = value;
}

fn web_on_click_navigate(app: *WebApp, node_id: i64, target_url: str): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].event.event_kind = WebEventKind.Click;
    app.nodes[node_id].event.action_kind = WebActionKind.Navigate;
    app.nodes[node_id].link_url = target_url;
}

fn web_on_submit(app: *WebApp, node_id: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].event.event_kind = WebEventKind.Submit;
    app.nodes[node_id].event.action_kind = WebActionKind.SubmitForm;
}

# ==============================================================================
# Reactive Statistics & Dashboards
# ==============================================================================

fn web_stats_grid(app: *WebApp, parent_id: i64): i64 {
    let id = web_app_add_node(app, WebKind.StatsGrid, parent_id);
    app.nodes[id].style.layout = WebLayout.Grid;
    app.nodes[id].style.columns = 3;
    app.nodes[id].style.gap = 16;
    return id;
}

fn web_stat_card(app: *WebApp, parent_id: i64, label: str, state_binding: i64): i64 {
    let card_id = web_app_add_node(app, WebKind.StatCard, parent_id);
    app.nodes[card_id].text = label;
    app.nodes[card_id].state_binding = state_binding;
    app.nodes[card_id].state_value = web_app_get_state(app, state_binding);
    app.nodes[card_id].style.radius = WebRadius.Lg;
    app.nodes[card_id].style.shadow = WebShadow.Sm;
    return card_id;
}

fn web_stat_metric(app: *WebApp, parent_id: i64, label: str, value_str: str): i64 {
    let card_id = web_app_add_node(app, WebKind.StatCard, parent_id);
    app.nodes[card_id].text = label;
    app.nodes[card_id].aux_text = value_str;
    app.nodes[card_id].style.radius = WebRadius.Lg;
    app.nodes[card_id].style.shadow = WebShadow.Sm;
    return card_id;
}

# ==============================================================================
