fn web_input(app: *WebApp, parent_id: i64, input_kind: i64, placeholder: str, state_key: i64): i64 {
    let id = web_app_add_node(app, WebKind.Input, parent_id);
    app.nodes[id].input_kind = input_kind;
    app.nodes[id].placeholder = placeholder;
    app.nodes[id].state_binding = state_key;
    app.nodes[id].style.radius = WebRadius.Md;
    return id;
}

