# ==============================================================================
# Style Setters
# ==============================================================================

fn web_set_style_color(app: *WebApp, node_id: i64, text_color: i64, bg_color: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].style.text_color = text_color;
    app.nodes[node_id].style.bg_color = bg_color;
}

fn web_set_style_border(app: *WebApp, node_id: i64, border_color: i64, radius: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].style.border_color = border_color;
    app.nodes[node_id].style.radius = radius;
}

fn web_set_style_padding(app: *WebApp, node_id: i64, px: i64, py: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].style.padding_x = px;
    app.nodes[node_id].style.padding_y = py;
}

fn web_set_style_shadow(app: *WebApp, node_id: i64, shadow: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].style.shadow = shadow;
}

fn web_set_style_animation(app: *WebApp, node_id: i64, animation: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].style.animation = animation;
}

fn web_set_render_mode(app: *WebApp, node_id: i64, mode: i64): void {
    if (node_id < 0) | (node_id >= app.node_count) { return; }
    app.nodes[node_id].render_mode = mode;
}

# ==============================================================================
# Additional UI Primitives & Components
# ==============================================================================

fn web_button_link(app: *WebApp, parent_id: i64, label: str, url: str, color: i64): i64 {
    let btn_id = web_app_add_node(app, WebKind.Button, parent_id);
    app.nodes[btn_id].text = label;
    app.nodes[btn_id].link_url = url;
    app.nodes[btn_id].style.bg_color = color;
    app.nodes[btn_id].style.radius = WebRadius.Md;
    return btn_id;
}

fn web_stat_card_static(app: *WebApp, stats_grid: i64, label: str, metric_value: str, color: i64): i64 {
    let card_id = web_app_add_node(app, WebKind.StatCard, stats_grid);
    app.nodes[card_id].text = label;
    app.nodes[card_id].aux_text = metric_value;
    app.nodes[card_id].style.text_color = color;
    app.nodes[card_id].style.radius = WebRadius.Lg;
    app.nodes[card_id].style.shadow = WebShadow.Sm;
    return card_id;
}

fn web_flex(app: *WebApp, parent_id: i64, direction: i64): i64 {
    let id = web_app_add_node(app, WebKind.Flex, parent_id);
    app.nodes[id].style.layout = direction;
    return id;
}

fn web_link(app: *WebApp, parent_id: i64, label: str, url: str): i64 {
    let id = web_app_add_node(app, WebKind.NavLink, parent_id);
    app.nodes[id].text = label;
    app.nodes[id].link_url = url;
    return id;
}

