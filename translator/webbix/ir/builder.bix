fn web_form(app: *WebApp, parent_id: i64, action_id: i64): i64 {
    let id = web_app_add_node(app, WebKind.Form, parent_id);
    app.nodes[id].state_binding = action_id;
    return id;
}

fn web_label(app: *WebApp, parent_id: i64, label_text: str, for_field: str): i64 {
    let id = web_app_add_node(app, WebKind.Label, parent_id);
    app.nodes[id].text = label_text;
    app.nodes[id].aux_text = for_field;
    return id;
