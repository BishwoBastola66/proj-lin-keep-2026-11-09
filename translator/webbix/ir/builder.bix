fn web_grid(app: *WebApp, parent_id: i64, columns: i64): i64 {
    let grid_id = web_app_add_node(app, WebKind.Grid, parent_id);
    app.nodes[grid_id].style.layout = WebLayout.Grid;
    app.nodes[grid_id].style.columns = columns;
    app.nodes[grid_id].style.gap = 24;
    return grid_id;
}

fn web_flex_row(app: *WebApp, parent_id: i64, gap: i64): i64 {
    let id = web_app_add_node(app, WebKind.Flex, parent_id);
    app.nodes[id].style.layout = WebLayout.Row;
    app.nodes[id].style.gap = gap;
    return id;
}

fn web_flex_col(app: *WebApp, parent_id: i64, gap: i64): i64 {
    let id = web_app_add_node(app, WebKind.Flex, parent_id);
    app.nodes[id].style.layout = WebLayout.Column;
    app.nodes[id].style.gap = gap;
    return id;
}

# ==============================================================================
# Cards & Badges
# ==============================================================================

fn web_card(app: *WebApp, parent_id: i64, title: str): i64 {
    let id = web_app_add_node(app, WebKind.Card, parent_id);
    app.nodes[id].text = title;
    app.nodes[id].style.radius = WebRadius.Lg;
    app.nodes[id].style.shadow = WebShadow.Md;
    return id;
}

fn web_project_card(
    app: *WebApp,
    parent_id: i64,
    tag: str,
    title: str,
    desc: str,
    tech1: str,
    tech2: str
): i64 {
    let card_id = web_app_add_node(app, WebKind.ProjectCard, parent_id);
    app.nodes[card_id].text = title;
    app.nodes[card_id].aux_text = tag;
    app.nodes[card_id].desc = desc;
    app.nodes[card_id].placeholder = tech1;
    app.nodes[card_id].style.radius = WebRadius.Lg;
    app.nodes[card_id].style.shadow = WebShadow.Md;
    return card_id;
}

fn web_badge_card(
    app: *WebApp,
    parent_id: i64,
    title: str,
    b1: str,
    b2: str,
    b3: str,
    b4: str,
    b5: str
): i64 {
    let card_id = web_app_add_node(app, WebKind.Badge, parent_id);
    app.nodes[card_id].text = title;
    app.nodes[card_id].aux_text = b1;
    app.nodes[card_id].desc = b2;
    app.nodes[card_id].placeholder = b3;
    app.nodes[card_id].style.radius = WebRadius.Lg;
    return card_id;
}

fn web_badge(app: *WebApp, parent_id: i64, label: str): i64 {
    let id = web_app_add_node(app, WebKind.Badge, parent_id);
    app.nodes[id].text = label;
    app.nodes[id].style.radius = WebRadius.Full;
    app.nodes[id].style.padding_x = 8;
    app.nodes[id].style.padding_y = 4;
    return id;
}

