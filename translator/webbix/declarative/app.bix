# ==============================================================================
# Webbix Framework — High-Level Developer Application Engine
# File: webbix/declarative/app.bix
#
# "HIDE THE MACHINERY, NOT REMOVE THE POWER"
#
# This is the primary developer-facing API. Application code uses ONLY
# the functions in this file. All framework machinery (WebApp, Ui, node IDs,
# state slots, Web IR, REX, sockets, HTTP) is hidden inside.
#
# Application developers think about:
#   app, page, route, component, state, events, styles, animations
#
# Webbix internally handles:
#   WebApp, Ui, node IDs, parent IDs, state slots, Web IR, REX,
#   HTTP, sockets, OS syscalls, rendering, native machine-code
# ==============================================================================

include "ui.bix";
include "../rex/rex_bridge.bix";
include "../net/platform.bix";
include "../net/socket.bix";
include "../server/http.bix";
include "../routing/router.bix";
include "../render/render.bix";

# ==============================================================================
# 1. Application Container
# ==============================================================================

struct App {
    name: str,
    port: i64,
    web_app: *WebApp,
    ui: *Ui
}

fn App(name: str): *App {
    let app: *App = alloc_buffer(40) as *App;
    app.name = name;
    app.port = 8089;

    let wa: *WebApp = alloc_buffer(131072) as *WebApp;
    app.web_app = wa;

    let ui: *Ui = alloc_buffer(8192) as *Ui;
    app.ui = ui;

    ui_init(ui, wa, name);



    return app;
}

# ==============================================================================
# 2. State Management — Named Reactive State
# ==============================================================================

fn State(app: *App, name: str, initial_val: i64): void {
    ui_state(app.ui, name, initial_val);
}

fn StateGet(app: *App, name: str): i64 {
    return ui_get_state(app.ui, name);
}

fn StateSet(app: *App, name: str, val: i64): void {
    ui_set_state(app.ui, name, val);
}

fn StateInc(app: *App, name: str): i64 {
    ui_inc_state(app.ui, name);
    return ui_get_state(app.ui, name);
}

fn StateDec(app: *App, name: str): i64 {
    ui_dec_state(app.ui, name);
    return ui_get_state(app.ui, name);
}

fn StateToggle(app: *App, name: str): i64 {
    ui_toggle_state(app.ui, name);
    return ui_get_state(app.ui, name);
}

# ==============================================================================
# 3. SEO & Metadata
# ==============================================================================

fn Meta(app: *App, title: str, description: str): void {
    app.web_app.title = title;
    app.web_app.description = description;
}

fn MetaOG(app: *App, og_title: str, og_desc: str, og_image: str): void {
    app.web_app.title = og_title;
    app.web_app.description = og_desc;
}

fn MetaCanonical(app: *App, url: str): void {
    app.web_app.canonical_url = url;
}

# ==============================================================================
# 4. Theme
# ==============================================================================

fn Theme(app: *App, theme: i64): void {
    app.web_app.theme = theme;
}

