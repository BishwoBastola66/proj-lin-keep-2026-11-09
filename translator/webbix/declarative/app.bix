# ==============================================================================
# 6. Lifecycle & Execution
# ==============================================================================

fn Build(app: *App): i64 {
    if app.web_app.node_count <= 0 { return -1; }
    let insts: [RexWebInstruction; 128];
    let inst_count = rex_compile_web_app(app.web_app, &insts[0], 128);
    if inst_count <= 0 { return -2; }
    return 42;
}

fn Run(app: *App): i64 {
    return Build(app);
}

fn Serve(app: *App, port: i64): i64 {
    if port <= 0 {
        port = app.port;
    }
    if port <= 0 {
        port = 8080;
    }
    app.port = port;

    let b_res = Build(app);
    if b_res != 42 { return -10; }

    let disp: PlatformDispatcher;
    let p_res = webbix_platform_init(&disp);
    if p_res < 0 { return -1; }

    let sock: WebbixSocket;
    let s_res = webbix_socket_create(&sock, &disp, AF_INET, SOCK_STREAM, 0);
    if s_res < 0 {
        webbix_platform_destroy(&disp);
        return -2;
    }

    webbix_socket_set_reuseaddr(&sock, &disp);

    let b_res2 = webbix_socket_bind(&sock, &disp, port);
    if b_res2 < 0 {
        webbix_socket_close(&sock);
        webbix_platform_destroy(&disp);
        return -3;
    }

    let l_res = webbix_socket_listen(&sock, &disp, 64);
    if l_res < 0 {
        webbix_socket_close(&sock);
        webbix_platform_destroy(&disp);
        return -4;
    }

    let scratch = sys_mmap(0, 65536, 3, 34, -1, 0);
    webbix_socket_write_str(1, "\n=================================================================\n", scratch);
    webbix_socket_write_str(1, "WEBBIX NATIVE APPLICATION SERVER\n", scratch);
    webbix_socket_write_str(1, "=================================================================\n", scratch);
    webbix_socket_write_str(1, "  Application: ", scratch);
    webbix_socket_write_str(1, app.name, scratch);
    webbix_socket_write_str(1, "\n  Port:        ", scratch);
    webbix_socket_write_str(1, webbix_int_to_str(port), scratch);
    webbix_socket_write_str(1, "\n  Status:      Listening on http://127.0.0.1:", scratch);
    webbix_socket_write_str(1, webbix_int_to_str(port), scratch);
    webbix_socket_write_str(1, "/\n  Pipeline:    Native Web IR -> HTTP Router -> Browser Output\n", scratch);
    webbix_socket_write_str(1, "=================================================================\n", scratch);
    webbix_socket_write_str(1, "[Webbix] Ready for connections.\n\n", scratch);

    while 1 {
        let client_fd = webbix_socket_accept(&sock, &disp);
        if client_fd >= 0 {
            let req_len = sys_read(client_fd, scratch, 4096);
            if req_len > 0 {
                set_byte(scratch, req_len, 0);

                let req_buf = alloc_buffer(req_len + 1) as *u8;
                let ri = 0;
                while ri < req_len {
                    req_buf[ri] = get_byte(scratch, ri) as u8;
                    ri = ri + 1;
                }
                req_buf[req_len] = 0 as u8;
                let req_str = req_buf as str;

                # 1. Parse real HTTP request
                let req: HttpRequest;
                http_parse_request(&req, req_str);
                free_buffer(req_buf as ptr, req_len + 1);

                # 2. Match route against Web IR Page nodes
                let param = "";
                let page_id = webbix_router_find_page(app.web_app, req.path, req.method, &param);

                # 3. Compile Web IR component tree to HTML5 document
                let body = webbix_render_document(app.web_app, app.ui, page_id, param);

                # 4. Build typed HTTP/1.1 response
                let resp: HttpResponse;
                let status_code = 200;
                if page_id == -404 {
                    status_code = 404;
                }
                http_make_response(&resp, status_code, "text/html; charset=utf-8", body);
                let resp_str = http_response_format(&resp);

                # 5. Write response to client socket
                webbix_socket_write_str(client_fd, resp_str, scratch);
            }
            sys_close(client_fd);
        }
    }

    webbix_socket_close(&sock);
    webbix_platform_destroy(&disp);
    return 0;
}

fn DispatchClick(app: *App, button_node_id: i64): void {
    rex_dispatch_ui_event(app.web_app, button_node_id, WebEventKind.Click);
}

fn DispatchEvent(app: *App, node_id: i64, event_kind: i64): void {
    rex_dispatch_ui_event(app.web_app, node_id, event_kind);
}
