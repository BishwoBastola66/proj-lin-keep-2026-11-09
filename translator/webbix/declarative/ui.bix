# Animation
fn UiAnimate(ui: *Ui, anim: WebAnimation): void {
    let p = current_parent(ui);
    if p >= 0 {
        ui.app.nodes[p].style.animation = anim as i64;
    }
}

fn UiAnimateFull(ui: *Ui, anim: WebAnimation, duration_ms: i64, delay_ms: i64, easing: i64): void {
    let p = current_parent(ui);
    if p >= 0 {
        ui.app.nodes[p].style.animation = anim as i64;
    }
}

fn UiAnimateOnScroll(ui: *Ui, anim: WebAnimation, duration_ms: i64): void {
    let p = current_parent(ui);
    if p >= 0 {
        ui.app.nodes[p].style.animation = anim as i64;
    }
}

fn UiStagger(ui: *Ui, stagger_ms: i64): void {
    let p = current_parent(ui);
    if p >= 0 {
        ui.app.nodes[p].style.animation = WebAnimation.StaggerChildren as i64;
    }
}
