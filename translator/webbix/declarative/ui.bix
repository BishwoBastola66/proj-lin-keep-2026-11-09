# ==============================================================================
# Webbix Framework — Declarative UI Engine (webbix/declarative/ui.bix)
# Pure Rubix auto-parenting component engine.
#
# Key Features:
#   1. Automatic parent/child tree nesting (ZERO parent node IDs)
#   2. Named reactive state store (ZERO numeric state slot IDs)
#   3. High-level component primitives (ZERO Web IR internals)
#   4. Zero HTML tags, zero CSS strings, zero JavaScript
# ==============================================================================

include "../ir/builder.bix";
include "../components/ui.bix";

struct Ui {
    app: *WebApp,
    parent_stack: [i64; 64],
    depth: i64,
    state_names: [str; 64],
    state_slots: [i64; 64],
    state_count: i64
}

fn ui_init(ui: *Ui, app: *WebApp, title: str): void {
    web_app_init(app, title);
    ui.app = app;
    ui.depth = 0;
    ui.state_count = 0;
}

fn current_parent(ui: *Ui): i64 {
    if ui.depth <= 0 { return -1; }
    return ui.parent_stack[ui.depth - 1];
}

fn push_parent(ui: *Ui, id: i64): void {
    if (ui.depth >= 0) & (ui.depth < 64) {
        ui.parent_stack[ui.depth] = id;
        ui.depth = ui.depth + 1;
    }
}

fn pop_parent(ui: *Ui): void {
    if ui.depth > 0 {
        ui.depth = ui.depth - 1;
    }
}

# ------------------------------------------------------------------------------
# Named Reactive State API
# ------------------------------------------------------------------------------

fn ui_state(ui: *Ui, name: str, initial_val: i64): void {
    let slot = ui.state_count + 1;
    ui.state_names[ui.state_count] = name;
    ui.state_slots[ui.state_count] = slot;
    ui.state_count = ui.state_count + 1;
    web_app_set_state(ui.app, slot, initial_val);
}

fn find_slot(ui: *Ui, name: str): i64 {
    let i = 0;
    while i < ui.state_count {
        if string_equal(ui.state_names[i], name) {
            return ui.state_slots[i];
        }
        i = i + 1;
    }
    return 1;
}

fn ui_get_state(ui: *Ui, name: str): i64 {
    let slot = find_slot(ui, name);
    return web_app_get_state(ui.app, slot);
}

fn ui_set_state(ui: *Ui, name: str, val: i64): void {
    let slot = find_slot(ui, name);
    web_app_set_state(ui.app, slot, val);
}

fn ui_inc_state(ui: *Ui, name: str): void {
    let slot = find_slot(ui, name);
    web_app_increment_state(ui.app, slot);
}

fn ui_dec_state(ui: *Ui, name: str): void {
    let slot = find_slot(ui, name);
    web_app_decrement_state(ui.app, slot);
}

fn ui_toggle_state(ui: *Ui, name: str): void {
    let slot = find_slot(ui, name);
    web_app_toggle_state(ui.app, slot);
}

# ------------------------------------------------------------------------------
# Declarative Component Primitives (Auto-Parenting, Zero Node IDs)
# ------------------------------------------------------------------------------

fn UiPage(ui: *Ui, route: str, title: str): void {
    let p_id = web_page(ui.app, route, title);
    push_parent(ui, p_id);
}

fn UiEnd(ui: *Ui): void {
    pop_parent(ui);
}

fn UiNavbar(ui: *Ui, brand: str, badge: str, l1: str, u1: str, l2: str, u2: str): void {
    let p = current_parent(ui);
    let id = ui_navbar(ui.app, p, brand, badge, l1, u1, l2, u2);
}

fn UiHero(ui: *Ui, eyebrow: str, headline: str, desc: str, cta: str, url: str): void {
    let p = current_parent(ui);
    let color = WebColor.Primary as i64;
    let id = ui_hero(ui.app, p, eyebrow, headline, desc, cta, url, color);
}

fn UiButton(ui: *Ui, label: str, state_name: str): void {
    let p = current_parent(ui);
    let slot = find_slot(ui, state_name);
    let id = ui_action_button(ui.app, p, label, slot);
}

fn UiButtonToggle(ui: *Ui, label: str, state_name: str): void {
    let p = current_parent(ui);
    let slot = find_slot(ui, state_name);
    let id = web_button(ui.app, p, label);
    web_on_click_toggle(ui.app, id, slot);
}

fn UiButtonNavigate(ui: *Ui, label: str, url: str): void {
    let p = current_parent(ui);
    let id = web_button(ui.app, p, label);
    web_on_click_navigate(ui.app, id, url);
}

fn UiStats(ui: *Ui): void {
