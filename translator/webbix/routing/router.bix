# ==============================================================================
# Webbix Framework — Application Routing (webbix/routing/router.bix)
# Pure Rubix implementation of path routing, dynamic parameter extraction,
# method matching, and 404/405 dispatch.
# ==============================================================================

include "../../rubix/std/string.bix";
include "../ir/app.bix";

let WEBMIX_METHOD_GET  = 1;
let WEBMIX_METHOD_POST = 2;

struct WebbixRoute {
    route_id: i64,
    path_id: i64,
    comp_type: i64,
    method_mask: i64
}

struct WebbixRouter {
    route_count: i64,
    active_route_id: i64
}

fn webbix_router_init(router: *WebbixRouter): void {
    router.route_count = 0;
    router.active_route_id = 0;
}

fn webbix_route_init(
    route: *WebbixRoute,
    route_id: i64,
    path_id: i64,
    comp_type: i64,
    method_mask: i64
): void {
    route.route_id = route_id;
    route.path_id = path_id;
    route.comp_type = comp_type;
    route.method_mask = method_mask;
}

fn webbix_route_match(route: *WebbixRoute, path_id: i64, method: i64): i64 {
    if route.path_id != path_id {
        return 0;
    }
    if (route.method_mask & method) == 0 {
        return 0;
    }
    return 1;
}

fn webbix_router_add(
    router: *WebbixRouter,
    route: *WebbixRoute,
    route_id: i64,
    path_id: i64,
    comp_type: i64,
    method_mask: i64
): void {
    webbix_route_init(route, route_id, path_id, comp_type, method_mask);
    router.route_count = router.route_count + 1;
}

fn webbix_router_resolve(route: *WebbixRoute, path_id: i64, method: i64): i64 {
    if webbix_route_match(route, path_id, method) == 1 {
        return route.comp_type;
    }
    return -1; # 404 Not Found
}

# ------------------------------------------------------------------------------
# Real Path-Based Route Resolution over Web IR Application Tree
# ------------------------------------------------------------------------------

fn webbix_router_find_page(
    app: *WebApp,
    req_path: str,
    req_method: str,
    out_param: *str
): i64 {
    *out_param = "";
    if app.node_count <= 0 { return -404; }

    # 1. Exact match pass over all Page nodes
    let i = 0;
    while i < app.node_count {
        if app.nodes[i].kind == (WebKind.Page as i64) {
            let r = app.nodes[i].link_url;
            if r == req_path {
                return i;
            }
        }
        i = i + 1;
    }

    # 2. Dynamic parameter route match pass (e.g., /projects/:id or /projects/*)
    let j = 0;
    while j < app.node_count {
        if app.nodes[j].kind == (WebKind.Page as i64) {
            let r = app.nodes[j].link_url;
            let colon = string_index_of(r, ":");
            if colon > 0 {
                let prefix = string_slice(r, 0, colon);
                if string_starts_with(req_path, prefix) {
                    let val = string_slice(req_path, prefix.len(), req_path.len() - prefix.len());
                    *out_param = val;
                    return j;
                }
            }
            # Also support /projects -> match /projects/<id> if nested page not found
            if (r != "/") & (r.len() > 1) {
                let pfx = r + "/";
                if string_starts_with(req_path, pfx) {
                    let val = string_slice(req_path, pfx.len(), req_path.len() - pfx.len());
                    *out_param = val;
                    return j;
                }
            }
        }
        j = j + 1;
    }

    # 3. Check for dedicated 404 page
    let k = 0;
    while k < app.node_count {
        if app.nodes[k].kind == (WebKind.Page as i64) {
            let r = app.nodes[k].link_url;
            if (r == "/404") | (r == "404") {
                return k;
            }
        }
        k = k + 1;
    }

    return -404;
}
