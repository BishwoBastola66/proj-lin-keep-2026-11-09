# ==============================================================================
# Webbix Framework — Runtime Bridge & HTML Serialization (webbix/runtime/runtime.bix)
# Pure Rubix implementation bridging Webbix components with REX DOM mutations,
# tree synchronization, and HTML5 serialization.
# ==============================================================================

let WEBMIX_DOM_MUT_CREATE_ELEMENT = 1;
let WEBMIX_DOM_MUT_SET_TEXT       = 5;
let WEBMIX_DOM_MUT_APPEND_CHILD   = 7;
let WEBMIX_DOM_MUT_ADD_LISTENER   = 9;

struct WebbixMutation {
    op: i64,
    target_id: i64,
    param1: i64,
    param2: i64
}

fn webbix_runtime_mutation_init(
    m: *WebbixMutation,
    op: i64,
    target_id: i64,
    param1: i64,
    param2: i64
): void {
    m.op = op;
    m.target_id = target_id;
    m.param1 = param1;
    m.param2 = param2;
}

fn webbix_runtime_vnode_to_dom_mutation(
    m: *WebbixMutation,
    node_id: i64,
    tag_id: i64,
    parent_id: i64
): void {
    webbix_runtime_mutation_init(m, WEBMIX_DOM_MUT_CREATE_ELEMENT, node_id, tag_id, parent_id);
}

fn webbix_runtime_tag_name(tag_id: i64): str {
    if tag_id == 1 { return "div"; }
    if tag_id == 2 { return "span"; }
    if tag_id == 3 { return "h1"; }
    if tag_id == 4 { return "p"; }
    if tag_id == 5 { return "button"; }
    if tag_id == 6 { return "input"; }
    if tag_id == 7 { return "section"; }
    if tag_id == 8 { return "nav"; }
    if tag_id == 9 { return "main"; }
    return "div";
}

# Computes HTML serialized byte length: <tag>...</tag>
fn webbix_runtime_serialize_tag_len(tag_id: i64, inner_text_len: i64): i64 {
    let tag_name_len = 0;
    if tag_id == 1 { tag_name_len = 3; } # div
    if tag_id == 2 { tag_name_len = 4; } # span
    if tag_id == 3 { tag_name_len = 2; } # h1
    if tag_id == 4 { tag_name_len = 1; } # p
    if tag_id == 5 { tag_name_len = 6; } # button
    if tag_id == 6 { tag_name_len = 5; } # input
    if tag_id == 7 { tag_name_len = 7; } # section
    if tag_id == 8 { tag_name_len = 3; } # nav
    if tag_id == 9 { tag_name_len = 4; } # main

    # Opening tag: '<' + tag + '>' = tag_name_len + 2
    # Closing tag: '</' + tag + '>' = tag_name_len + 3
    # Total = tag_name_len * 2 + 5 + inner_text_len
    return tag_name_len * 2 + 5 + inner_text_len;
}
