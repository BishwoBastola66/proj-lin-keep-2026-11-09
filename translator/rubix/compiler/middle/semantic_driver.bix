# ==============================================================================
# Rubix — Unified Semantic Pipeline Driver
# File: compiler/middle/semantic_driver.bix
#
# Coordinates the unified Rubix architecture pipeline:
#   Source -> SIR -> Type & Effect Check -> AIR -> Escape & Borrow -> UIR -> Native
# ==============================================================================

fn semantic_check_source(src_path: i64, is_json: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 {
        cli_write_lit(2, "rubix: error: unable to open source file\n");
        return -10;
    }

    let raw_src = sys_mmap(0, 1048576, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 1048576);
    sys_close(fd);
    if n <= 0 {
        sys_munmap(raw_src, 1048576);
        cli_write_lit(2, "rubix: error: source file is empty\n");
        return -11;
    }
    set_byte(raw_src, n, 0);

    # Initialize SIR AST buffer (1MB)
    let ast_buf = sys_mmap(0, 1048576, 3, 34, -1, 0);
    sir_ast_init(ast_buf, 16384);

    # Parse SIR AST
    let root = sir_parse_program(raw_src, n, ast_buf);

    # Verify Semantic Invariants (Effects & Capabilities)
    let verify_res = sir_verify_program(ast_buf, root);

    if verify_res == ERR_SIR_OK {
        if is_json == 1 {
            cli_write_lit(1, "[STATUS_OK] phase=semantic_verification effects=verified capabilities=verified\n");
        } else {
            cli_write_lit(1, "PASS: Semantic, Effect, and Capability verification passed cleanly.\n");
        }
    } else if verify_res == ERR_SIR_PURITY_VIOLATION {
        cli_write_lit(2, "rubix: error[-101] [EFFECT_VIOLATION]: pure function cannot invoke effectful operation\n");
    } else if verify_res == ERR_SIR_CAPABILITY_UNAUTHORIZED {
        cli_write_lit(2, "rubix: error[-102] [CAPABILITY_UNAUTHORIZED]: privileged operation requires explicit capability token\n");
    } else {
        cli_write_lit(2, "rubix: error: semantic verification failed\n");
    }

    sys_munmap(ast_buf, 1048576);
    sys_munmap(raw_src, 1048576);
    return verify_res;
}

fn semantic_emit_effects(src_path: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 { return -10; }

    let raw_src = sys_mmap(0, 1048576, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 1048576);
    sys_close(fd);
    if n <= 0 {
        sys_munmap(raw_src, 1048576);
        return -11;
    }
    set_byte(raw_src, n, 0);

    let ast_buf = sys_mmap(0, 1048576, 3, 34, -1, 0);
    sir_ast_init(ast_buf, 16384);
    let root = sir_parse_program(raw_src, n, ast_buf);

    cli_write_lit(1, "=== RUBIX EFFECT & CAPABILITY LEDGER ===\n");
    let curr = sir_ast_get_child(ast_buf, root, 0);
    let fn_idx = 1;

    while curr > 0 {
        let eff = sir_ast_effects(ast_buf, curr);
        let caps = sir_ast_caps(ast_buf, curr);

        cli_write_lit(1, "Function [");
        let ob = sys_mmap_page();
        let cur = diag_write_num(ob, 0, fn_idx);
        sys_write(1, ob, cur);
        sys_munmap(ob, 4096);

        cli_write_lit(1, "]: Declared Effects = ");
        if eff == EFFECT_PURE {
            cli_write_lit(1, "pure (0x0)");
        } else {
            let eb = sys_mmap_page();
            let c2 = diag_write_num(eb, 0, eff);
            sys_write(1, eb, c2);
            sys_munmap(eb, 4096);
        }

        cli_write_lit(1, " | Required Capabilities = ");
        if caps == CAP_FLAG_NONE {
            cli_write_lit(1, "none (0x0)\n");
        } else {
            let cb = sys_mmap_page();
            let c3 = diag_write_num(cb, 0, caps);
            sys_write(1, cb, c3);
            sys_munmap(cb, 4096);
            cli_write_lit(1, "\n");
        }

        fn_idx = fn_idx + 1;
        curr = sir_ast_get_child(ast_buf, curr, 0);
    }

    sys_munmap(ast_buf, 1048576);
    sys_munmap(raw_src, 1048576);
    return 0;
}

fn semantic_emit_air(src_path: i64): i64 {
    let fd = sys_open(src_path, 0, 0);
    if fd < 0 { return -10; }

    let raw_src = sys_mmap(0, 1048576, 3, 34, -1, 0);
    let n = sys_read_all(fd, raw_src, 1048576);
    sys_close(fd);
    if n <= 0 {
        sys_munmap(raw_src, 1048576);
        return -11;
    }
    set_byte(raw_src, n, 0);

    let ast_buf = sys_mmap(0, 1048576, 3, 34, -1, 0);
    sir_ast_init(ast_buf, 16384);
    let root = sir_parse_program(raw_src, n, ast_buf);

    let verify_res = sir_verify_program(ast_buf, root);
    if verify_res != ERR_SIR_OK {
        cli_write_lit(2, "rubix: error: semantic verification failed before AIR lowering\n");
        sys_munmap(ast_buf, 1048576);
        sys_munmap(raw_src, 1048576);
        return verify_res;
    }

    # Allocate AIR instruction buffer (1MB)
    let air_buf = sys_mmap(0, 1048576, 3, 34, -1, 0);
    air_init(air_buf, 16384);

    # Synthesize AIR blocks for parsed functions
    let curr = sir_ast_get_child(ast_buf, root, 0);
    let fn_count = 0;
    while curr > 0 {
        fn_count = fn_count + 1;
        air_emit(air_buf, AIR_OP_REGION_ENTER, 0, 0, 0, 0, 0);
        air_emit(air_buf, AIR_OP_CONST, 0, fn_count, 0, 0, 0);
        air_emit(air_buf, AIR_OP_MOVE, 1, 0, 0, fn_count, 0);
        air_emit(air_buf, AIR_OP_REGION_LEAVE, 0, 0, 0, 0, 0);
        curr = sir_ast_get_child(ast_buf, curr, 0);
    }

    # Perform automated escape analysis & stack promotion pass
    let promoted = air_analyze_escapes(air_buf, -1);

    # Perform pure dead-code elimination pass
    let eliminated = air_opt_pure_dce(air_buf);

    # Verify affine ownership
    let state_tbl = sys_mmap_page();
    let own_res = air_check_ownership(air_buf, state_tbl, 64);
    sys_munmap(state_tbl, 4096);

    cli_write_lit(1, "=== RUBIX AFFINE & RESOURCE IR (AIR) LEDGER ===\n");
    let total_air = air_get_count(air_buf);
    let i = 0;
    while i < total_air {
        let op = air_get_op(air_buf, i);
        let dst = air_get_dst(air_buf, i);
        let s1 = air_get_src1(air_buf, i);
        let res_id = air_get_res_id(air_buf, i);

        cli_write_lit(1, "  [AIR-");
        let ib = sys_mmap_page();
        let ic = diag_write_num(ib, 0, i);
        sys_write(1, ib, ic);
        sys_munmap(ib, 4096);

        cli_write_lit(1, "] OP=");
        if op == AIR_OP_REGION_ENTER {
            cli_write_lit(1, "REGION_ENTER");
        } else if op == AIR_OP_REGION_LEAVE {
            cli_write_lit(1, "REGION_LEAVE");
        } else if op == AIR_OP_CONST {
            cli_write_lit(1, "CONST       ");
        } else if op == AIR_OP_MOVE {
            cli_write_lit(1, "MOVE        ");
        } else if op == AIR_OP_STACK_PROMOTE {
            cli_write_lit(1, "STACK_PROMOTE");
        } else {
            cli_write_lit(1, "OP_OTHER    ");
        }

        cli_write_lit(1, " | dst=v");
        let db = sys_mmap_page();
        let dc = diag_write_num(db, 0, dst);
        sys_write(1, db, dc);
        sys_munmap(db, 4096);

        cli_write_lit(1, " | s1=");
        let sb = sys_mmap_page();
        let sc = diag_write_num(sb, 0, s1);
        sys_write(1, sb, sc);
        sys_munmap(sb, 4096);

        cli_write_lit(1, " | res_id=");
        let rb = sys_mmap_page();
        let rc = diag_write_num(rb, 0, res_id);
        sys_write(1, rb, rc);
        sys_munmap(rb, 4096);

        cli_write_lit(1, "\n");
        i = i + 1;
    }

    cli_write_lit(1, "\n=== AIR Optimization & Verification Summary ===\n");
    cli_write_lit(1, "  Total AIR Instructions: ");
    let tb = sys_mmap_page();
    let tc = diag_write_num(tb, 0, total_air);
    sys_write(1, tb, tc);
    sys_munmap(tb, 4096);

    cli_write_lit(1, "\n  Stack Promotions (Escape Analysis): ");
    let pb = sys_mmap_page();
    let pc = diag_write_num(pb, 0, promoted);
    sys_write(1, pb, pc);
    sys_munmap(pb, 4096);

    cli_write_lit(1, "\n  Affine Ownership Status: ");
    if own_res == ERR_BORROW_OK {
        cli_write_lit(1, "VERIFIED (0 errors)\n");
    } else {
        cli_write_lit(1, "VIOLATION DETECTED\n");
    }

    sys_munmap(air_buf, 1048576);
    sys_munmap(ast_buf, 1048576);
    sys_munmap(raw_src, 1048576);
    return own_res;
}

fn semantic_compile_binary(src_path: i64, out_path: i64): i64 {
    let check_res = semantic_check_source(src_path, 0);
    if check_res != 0 {
        return check_res;
    }
    let res = compile_file_to_binary(src_path, out_path);
    if res > 0 {
        cli_write_lit(1, "PASS: Synthesized sovereign native executable successfully.\n");
        return 0;
    }
    return res;
}

# Compatibility aliases
fn next_check_source(src_path: i64, is_json: i64): i64 {
    return semantic_check_source(src_path, is_json);
}

fn next_emit_effects(src_path: i64): i64 {
    return semantic_emit_effects(src_path);
}

fn next_emit_air(src_path: i64): i64 {
    return semantic_emit_air(src_path);
}

fn next_compile_binary(src_path: i64, out_path: i64): i64 {
    return semantic_compile_binary(src_path, out_path);
}
