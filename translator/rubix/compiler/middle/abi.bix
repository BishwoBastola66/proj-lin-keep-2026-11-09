# ==============================================================================
# Rubix Application Binary Interface (ABI) Resilience Subsystem
# File: compiler/middle/abi.bix
# Pure Rubix Architecture: Zero external tools, zero Python, zero LLVM.
# ==============================================================================

struct AbiContract {
    name_hash: i64,
    arity: i64,
    ret_type: i64,
    abi_id: i64,
    caps: i64,
    effects: i64,
    identity_hash: i64,
    compat_hash: i64,
    security_hash: i64,
    contract_hash: i64,
    interface_ver: i64,
    repr_ver: i64
}

# ------------------------------------------------------------------------------
# 1. ABI Calling Convention Identifiers
# ------------------------------------------------------------------------------
let ABI_SYSV           = 1; # System V AMD64 ABI (Linux/macOS x86_64: rdi, rsi, rdx, rcx, r8, r9)
let ABI_WIN64          = 2; # Microsoft x64 ABI (Windows: rcx, rdx, r8, r9, 32B shadow)
let ABI_AAPCS64        = 3; # ARM 64-bit Architecture PCS (Linux/Android: x0-x7)
let ABI_DARWIN_AAPCS64 = 4; # Apple Silicon Darwin AAPCS64 (macOS/iOS: x0-x7)
let ABI_RISCV_LP64     = 5; # RISC-V LP64 Standard ABI (Linux: a0-a7)
let ABI_WASI           = 6; # WebAssembly WASI ABI
let ABI_RUBIX_FAST     = 7; # Sovereign Rubix Internal Fastcall

# ------------------------------------------------------------------------------
# 2. Comprehensive Compatibility Lattice Classification
# ------------------------------------------------------------------------------
let COMPAT_BITWISE          = 0; # Identical register mapping; direct native call, 0 overhead
let COMPAT_REPRESENTATIONAL = 1; # Compatible bit representation; bit-identical
let COMPAT_CALLING          = 2; # Equivalent argument registers, same width
let COMPAT_ABI              = 3; # Target ABI equivalent
let COMPAT_ADAPTER          = 4; # Convertible; synthesized specialized machine trampoline
let COMPAT_SEMANTIC         = 5; # Semantic match; requires capability/effect gate check
let COMPAT_RECOMPILE_REQ    = 6; # Source compatible; requires local compiler rebuild
let COMPAT_CROSS_ISA        = 7; # Cross-architecture boundary (requires emulation/translation)
let COMPAT_REMOTE           = 8; # Cross-process / RPC boundary
let COMPAT_INCOMPATIBLE     = -1; # Incompatible arity, type, or unauthorized capability

# ------------------------------------------------------------------------------
# 3. Categorized ABI Change Classification
# ------------------------------------------------------------------------------
let CHANGE_NONE               = 0;
let CHANGE_CALLING_CONVENTION = 1;
let CHANGE_DATA_LAYOUT        = 2;
let CHANGE_REPRESENTATION     = 3;
let CHANGE_SYMBOL_LINKAGE     = 4;
let CHANGE_OBJECT_FORMAT      = 5;
let CHANGE_RUNTIME_CONTRACT   = 6;
let CHANGE_OS_ABI             = 7;
let CHANGE_THREAD_TLS         = 8;
let CHANGE_EXCEPTION_UNWIND   = 9;
let CHANGE_ISA                = 10;
let CHANGE_CROSS_ISA          = 11;

# ------------------------------------------------------------------------------
# 4. Parameter Classification Constants
# ------------------------------------------------------------------------------
let PARAM_CLASS_INTEGER   = 1; # Fits in general purpose integer register
let PARAM_CLASS_POINTER   = 2; # Memory pointer
let PARAM_CLASS_FLOAT     = 3; # Floating point / vector register
let PARAM_CLASS_AGGREGATE = 4; # Multi-word aggregate / struct
let PARAM_CLASS_AFFINE    = 5; # Linear resource handle

# ------------------------------------------------------------------------------
# 5. Error Diagnostics
# ------------------------------------------------------------------------------
let ERR_ABI_MISMATCH_ARITY = -35;
let ERR_ABI_MISMATCH_TYPE  = -42;
let ERR_ABI_INCOMPATIBLE   = -90;
let ERR_CAP_UNAUTHORIZED   = -71;
let ERR_EFFECT_PURITY      = -72;

# ------------------------------------------------------------------------------
# 6. Core ABI Query API
# ------------------------------------------------------------------------------
fn abi_get_name(abi_id: i64): str {
    if abi_id == ABI_SYSV { return "sysv_amd64"; }
    if abi_id == ABI_WIN64 { return "ms_win64"; }
    if abi_id == ABI_AAPCS64 { return "arm_aapcs64"; }
    if abi_id == ABI_DARWIN_AAPCS64 { return "darwin_arm64"; }
    if abi_id == ABI_RISCV_LP64 { return "riscv_lp64"; }
    if abi_id == ABI_WASI { return "wasi"; }
    if abi_id == ABI_RUBIX_FAST { return "rubix_fastcall"; }
    return "unknown_abi";
}

fn abi_compat_name(compat_id: i64): str {
    if compat_id == COMPAT_BITWISE { return "BITWISE_COMPATIBLE"; }
    if compat_id == COMPAT_REPRESENTATIONAL { return "REPRESENTATION_COMPATIBLE"; }
    if compat_id == COMPAT_CALLING { return "CALLING_COMPATIBLE"; }
    if compat_id == COMPAT_ABI { return "ABI_COMPATIBLE"; }
    if compat_id == COMPAT_ADAPTER { return "ADAPTER_COMPATIBLE"; }
    if compat_id == COMPAT_SEMANTIC { return "SEMANTICALLY_COMPATIBLE"; }
    if compat_id == COMPAT_RECOMPILE_REQ { return "RECOMPILE_REQUIRED"; }
    if compat_id == COMPAT_CROSS_ISA { return "CROSS_ISA_BOUNDARY"; }
    if compat_id == COMPAT_REMOTE { return "REMOTE_BOUNDARY"; }
    return "INCOMPATIBLE";
}

fn abi_change_name(change_id: i64): str {
    if change_id == CHANGE_NONE { return "NONE"; }
    if change_id == CHANGE_CALLING_CONVENTION { return "CALLING_CONVENTION_CHANGE"; }
    if change_id == CHANGE_DATA_LAYOUT { return "DATA_LAYOUT_CHANGE"; }
    if change_id == CHANGE_REPRESENTATION { return "REPRESENTATION_CHANGE"; }
    if change_id == CHANGE_SYMBOL_LINKAGE { return "SYMBOL_LINKAGE_CHANGE"; }
    if change_id == CHANGE_OBJECT_FORMAT { return "OBJECT_FORMAT_CHANGE"; }
    if change_id == CHANGE_RUNTIME_CONTRACT { return "RUNTIME_CONTRACT_CHANGE"; }
    if change_id == CHANGE_OS_ABI { return "OS_ABI_CHANGE"; }
    if change_id == CHANGE_THREAD_TLS { return "THREAD_TLS_CHANGE"; }
    if change_id == CHANGE_EXCEPTION_UNWIND { return "EXCEPTION_UNWIND_CHANGE"; }
    if change_id == CHANGE_ISA { return "ISA_CHANGE"; }
    if change_id == CHANGE_CROSS_ISA { return "CROSS_ISA_BOUNDARY"; }
    return "UNKNOWN_CHANGE";
}

fn abi_get_max_reg_args(abi_id: i64): i64 {
    if abi_id == ABI_SYSV { return 6; }
    if abi_id == ABI_WIN64 { return 4; }
    if abi_id == ABI_AAPCS64 { return 8; }
    if abi_id == ABI_DARWIN_AAPCS64 { return 8; }
    if abi_id == ABI_RISCV_LP64 { return 8; }
    if abi_id == ABI_RUBIX_FAST { return 6; }
    return 0;
}

fn abi_get_shadow_space(abi_id: i64): i64 {
    if abi_id == ABI_WIN64 { return 32; }
    return 0;
}

fn abi_get_stack_align(abi_id: i64): i64 {
    return 16;
}

# ------------------------------------------------------------------------------
# 7. Semantic Contract Construction & Multi-Hash Fingerprinting
# ------------------------------------------------------------------------------
fn abi_contract_alloc(): *AbiContract {
    let c = alloc_buffer(96) as *AbiContract;
    c.name_hash = 0;
    c.arity = 0;
    c.ret_type = 0;
    c.abi_id = ABI_SYSV;
    c.caps = 0;
    c.effects = 0;
    c.identity_hash = 0;
    c.compat_hash = 0;
    c.security_hash = 0;
    c.contract_hash = 0;
    c.interface_ver = 1;
    c.repr_ver = 1;
    return c;
}

fn abi_calc_identity_hash(name_hash: i64, arity: i64): i64 {
    let h = 14695981039346656037;
    h = (h ^ name_hash) * 1099511628211;
    h = (h ^ (arity + 1)) * 1099511628211;
    return h;
}

fn abi_calc_compat_hash(arity: i64, ret_type: i64, abi_id: i64): i64 {
    let h = 14695981039346656037;
    h = (h ^ (arity + 1)) * 1099511628211;
    h = (h ^ (ret_type + 1)) * 1099511628211;
    h = (h ^ (abi_id + 1)) * 1099511628211;
    return h;
}

fn abi_calc_security_hash(caps: i64, effects: i64): i64 {
    let h = 14695981039346656037;
    h = (h ^ (caps + 7)) * 1099511628211;
    h = (h ^ (effects + 13)) * 1099511628211;
    return h;
}

fn abi_contract_init(c: *AbiContract, name_hash: i64, arity: i64, ret_type: i64, abi_id: i64, caps: i64, effects: i64): i64 {
    c.name_hash = name_hash;
    c.arity = arity;
    c.ret_type = ret_type;
    c.abi_id = abi_id;
    c.caps = caps;
    c.effects = effects;
    c.identity_hash = abi_calc_identity_hash(name_hash, arity);
    c.compat_hash = abi_calc_compat_hash(arity, ret_type, abi_id);
    c.security_hash = abi_calc_security_hash(caps, effects);

    # Composite contract fingerprint
    let h = 14695981039346656037;
    h = (h ^ c.identity_hash) * 1099511628211;
    h = (h ^ c.compat_hash) * 1099511628211;
    h = (h ^ c.security_hash) * 1099511628211;
    c.contract_hash = h;
    return c.contract_hash;
}

# ------------------------------------------------------------------------------
# 8. ABI Change Classification
# ------------------------------------------------------------------------------
fn abi_classify_change(caller_abi: i64, callee_abi: i64, caller_isa: i64, callee_isa: i64): i64 {
    if caller_isa != callee_isa {
        return CHANGE_CROSS_ISA;
    }
    if caller_abi == callee_abi {
        return CHANGE_NONE;
    }
    # x86_64 SysV vs Win64
    if ((caller_abi == ABI_SYSV) & (callee_abi == ABI_WIN64)) | ((caller_abi == ABI_WIN64) & (callee_abi == ABI_SYSV)) {
        return CHANGE_CALLING_CONVENTION;
    }
    # ARM64 AAPCS vs Darwin ARM64
    if ((caller_abi == ABI_AAPCS64) & (callee_abi == ABI_DARWIN_AAPCS64)) | ((caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_AAPCS64)) {
        return CHANGE_CALLING_CONVENTION;
    }
    return CHANGE_CALLING_CONVENTION;
}

# ------------------------------------------------------------------------------
# 9. Rich Compatibility Lattice Solver
# ------------------------------------------------------------------------------
fn abi_solve_compatibility(caller_abi: i64, callee_abi: i64, caller_arity: i64, callee_arity: i64, caller_caps: i64, callee_caps: i64): i64 {
    # Invariant 1: Arity must match
    if caller_arity != callee_arity {
        return COMPAT_INCOMPATIBLE;
    }

    # Invariant 2: Caller must possess all capabilities required by callee
    if (callee_caps & caller_caps) != callee_caps {
        return COMPAT_INCOMPATIBLE;
    }

    # Invariant 3: Identical calling conventions -> BITWISE_COMPATIBLE (Zero Overhead)
    if caller_abi == callee_abi {
        return COMPAT_BITWISE;
    }

    # Invariant 4: System V and Rubix Fastcall share argument registers -> BITWISE_COMPATIBLE
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_RUBIX_FAST) {
        return COMPAT_BITWISE;
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_SYSV) {
        return COMPAT_BITWISE;
    }

    # Invariant 5: System V <-> Win64 on x86_64 requires register shuffling and shadow space
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_WIN64) {
        return COMPAT_ADAPTER;
    }
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_SYSV) {
        return COMPAT_ADAPTER;
    }

    # Invariant 6: ARM64 and Darwin ARM64 are convertible via adapter
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return COMPAT_ADAPTER;
    }
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_AAPCS64) {
        return COMPAT_ADAPTER;
    }

    # Cross-architecture interfaces require semantic bridges
    return COMPAT_SEMANTIC;
}

fn abi_solve_contracts(caller: *AbiContract, callee: *AbiContract): i64 {
    return abi_solve_compatibility(caller.abi_id, callee.abi_id, caller.arity, callee.arity, caller.caps, callee.caps);
}

# Returns 1 if no adapter is needed (100% direct native call)
fn abi_is_zero_cost_eliminated(caller_abi: i64, callee_abi: i64): i64 {
    let compat = abi_solve_compatibility(caller_abi, callee_abi, 0, 0, 0, 0);
    if compat == COMPAT_BITWISE { return 1; }
    return 0;
}

# ------------------------------------------------------------------------------
# 10. Specialized Machine Trampoline Synthesizers
# ------------------------------------------------------------------------------

# Synthesizes an x86-64 machine trampoline for System V caller -> Microsoft x64 callee
fn abi_synthesize_adapter_sysv_to_win64(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;

    # push rbp (0x55)
    set_byte(code_buf, l, 85); l = l + 1;
    # mov rbp, rsp (0x48, 0x89, 0xe5)
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 137); l = l + 1;
    set_byte(code_buf, l, 229); l = l + 1;

    # sub rsp, 32 (0x48, 0x83, 0xec, 0x20) - Allocate mandatory Win64 32B shadow space
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 131); l = l + 1;
    set_byte(code_buf, l, 236); l = l + 1;
    set_byte(code_buf, l, 32); l = l + 1;

    # Argument Register Permutation:
    # SysV:  rdi, rsi, rdx, rcx
    # Win64: rcx, rdx, r8,  r9

    if arity >= 4 {
        # mov r9, rcx (49 89 c9)
        set_byte(code_buf, l, 73); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 201); l = l + 1;
    }
    if arity >= 3 {
        # mov r8, rdx (49 89 d0)
        set_byte(code_buf, l, 73); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 208); l = l + 1;
    }
    if arity >= 2 {
        # mov rdx, rsi (48 89 f2)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 242); l = l + 1;
    }
    if arity >= 1 {
        # mov rcx, rdi (48 89 f9)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 249); l = l + 1;
    }

    # Call target via RAX
    if target_ptr != 0 {
        # mov rax, target_ptr (48 b8 <8 bytes>)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0;
        let p = target_ptr;
        while bi < 8 {
            set_byte(code_buf, l, p & 255);
            l = l + 1;
            p = p >> 8;
            bi = bi + 1;
        }
        # call rax (ff d0)
        set_byte(code_buf, l, 255); l = l + 1;
        set_byte(code_buf, l, 208); l = l + 1;
    }

    # add rsp, 32 (48 83 c4 20) - Tear down shadow space
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 131); l = l + 1;
    set_byte(code_buf, l, 196); l = l + 1;
    set_byte(code_buf, l, 32); l = l + 1;

    # pop rbp (5d)
    set_byte(code_buf, l, 93); l = l + 1;
    # ret (c3)
    set_byte(code_buf, l, 195); l = l + 1;

    return l;
}

# Synthesizes an x86-64 reverse thunk for Microsoft x64 caller -> System V callee (Callback Reverse Thunk)
fn abi_synthesize_adapter_win64_to_sysv(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;

    # push rbp (0x55)
    set_byte(code_buf, l, 85); l = l + 1;
    # mov rbp, rsp (0x48, 0x89, 0xe5)
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 137); l = l + 1;
    set_byte(code_buf, l, 229); l = l + 1;

    # Reverse Register Permutation:
    # Win64 incoming: rcx, rdx, r8, r9
    # SysV outgoing:  rdi, rsi, rdx, rcx
    if arity >= 1 {
        # mov rdi, rcx (48 89 cf)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 207); l = l + 1;
    }
    if arity >= 2 {
        # mov rsi, rdx (48 89 d6)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 214); l = l + 1;
    }
    if arity >= 3 {
        # mov rdx, r8 (4c 89 c2)
        set_byte(code_buf, l, 76); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 194); l = l + 1;
    }
    if arity >= 4 {
        # mov rcx, r9 (4c 89 c9)
        set_byte(code_buf, l, 76); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 201); l = l + 1;
    }

    # Call target via RAX
    if target_ptr != 0 {
        # mov rax, target_ptr (48 b8 <8 bytes>)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0;
        let p = target_ptr;
        while bi < 8 {
            set_byte(code_buf, l, p & 255);
            l = l + 1;
            p = p >> 8;
            bi = bi + 1;
        }
        # call rax (ff d0)
        set_byte(code_buf, l, 255); l = l + 1;
        set_byte(code_buf, l, 208); l = l + 1;
    }

    # pop rbp (5d)
    set_byte(code_buf, l, 93); l = l + 1;
    # ret (c3)
    set_byte(code_buf, l, 195); l = l + 1;

    return l;
}

# ------------------------------------------------------------------------------
# 11. Intra-Architecture Specialized Trampolines (x86_64, AArch64, RISC-V)
# ------------------------------------------------------------------------------

# System V -> Rubix Fastcall
# SysV incoming:     rdi (arg 1), rsi (arg 2), rdx (arg 3), rcx (arg 4), r8 (arg 5), r9 (arg 6)
# Fastcall outgoing: rax (arg 1), rbx (arg 2), rcx (arg 3), rdx (arg 4), rsi (arg 5), rdi (arg 6)
fn abi_synthesize_adapter_sysv_to_fast(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp (0x55)
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 137); l = l + 1;
    set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp (48 89 e5)

    if arity >= 6 {
        # mov rdi, r9 (4c 89 cf)
        set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 207); l = l + 1;
    }
    if arity >= 5 {
        # mov rsi, r8 (4c 89 c6)
        set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 198); l = l + 1;
    }
    if arity >= 4 {
        # mov r10, rcx; mov rdx, r10 (save rcx into r10, move to rdx)
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 202); l = l + 1;
    }
    if arity >= 3 {
        # mov rcx, rdx (48 89 d1)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 209); l = l + 1;
    }
    if arity >= 4 {
        # mov rdx, r10 (4c 89 d2)
        set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 210); l = l + 1;
    }
    if arity >= 2 {
        # mov rbx, rsi (48 89 f3)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 243); l = l + 1;
    }
    if arity >= 1 {
        # mov rax, rdi (48 89 f8)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 248); l = l + 1;
    }

    if target_ptr != 0 {
        # mov r11, target_ptr (49 bb <8 bytes>)
        set_byte(code_buf, l, 73); l = l + 1;
        set_byte(code_buf, l, 187); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        # call r11 (41 ff d3)
        set_byte(code_buf, l, 65); l = l + 1;
        set_byte(code_buf, l, 255); l = l + 1;
        set_byte(code_buf, l, 211); l = l + 1;
    }

    set_byte(code_buf, l, 93); l = l + 1; # pop rbp (0x5d)
    set_byte(code_buf, l, 195); l = l + 1; # ret (0xc3)
    return l;
}

# Rubix Fastcall -> System V
# Fastcall incoming: rax (arg 1), rbx (arg 2), rcx (arg 3), rdx (arg 4), rsi (arg 5), rdi (arg 6)
# SysV outgoing:     rdi (arg 1), rsi (arg 2), rdx (arg 3), rcx (arg 4), r8 (arg 5), r9 (arg 6)
fn abi_synthesize_adapter_fast_to_sysv(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp (0x55)
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 137); l = l + 1;
    set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp (48 89 e5)

    if arity >= 6 {
        # mov r9, rdi (49 89 f9)
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 249); l = l + 1;
    }
    if arity >= 5 {
        # mov r8, rsi (49 89 f0)
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 240); l = l + 1;
    }
    if arity >= 4 {
        # mov r10, rdx (save fastcall arg 4)
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 210); l = l + 1;
    }
    if arity >= 3 {
        # mov rdx, rcx (48 89 ca)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 202); l = l + 1;
    }
    if arity >= 4 {
        # mov rcx, r10 (4c 89 d1)
        set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 209); l = l + 1;
    }
    if arity >= 2 {
        # mov rsi, rbx (48 89 de)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 222); l = l + 1;
    }
    if arity >= 1 {
        # mov rdi, rax (48 89 c7)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 199); l = l + 1;
    }

    if target_ptr != 0 {
        # mov r11, target_ptr (49 bb <8 bytes>)
        set_byte(code_buf, l, 73); l = l + 1;
        set_byte(code_buf, l, 187); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        # call r11 (41 ff d3)
        set_byte(code_buf, l, 65); l = l + 1;
        set_byte(code_buf, l, 255); l = l + 1;
        set_byte(code_buf, l, 211); l = l + 1;
    }

    set_byte(code_buf, l, 93); l = l + 1; # pop rbp
    set_byte(code_buf, l, 195); l = l + 1; # ret
    return l;
}

# Win64 -> Rubix Fastcall
# Win64 incoming:    rcx (arg 1), rdx (arg 2), r8 (arg 3), r9 (arg 4)
# Fastcall outgoing: rax (arg 1), rbx (arg 2), rcx (arg 3), rdx (arg 4)
fn abi_synthesize_adapter_win64_to_fast(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1;

    if arity >= 1 {
        # mov rax, rcx (48 89 c8)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 200); l = l + 1;
    }
    if arity >= 2 {
        # mov rbx, rdx (48 89 d3)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 211); l = l + 1;
    }
    if arity >= 3 {
        # mov rcx, r8 (4c 89 c1)
        set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 193); l = l + 1;
    }
    if arity >= 4 {
        # mov rdx, r9 (4c 89 ca)
        set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 202); l = l + 1;
    }

    if target_ptr != 0 {
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 187); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 65); l = l + 1; set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 211); l = l + 1;
    }

    set_byte(code_buf, l, 93); l = l + 1; # pop rbp
    set_byte(code_buf, l, 195); l = l + 1; # ret
    return l;
}

# Rubix Fastcall -> Win64
# Fastcall incoming: rax (arg 1), rbx (arg 2), rcx (arg 3), rdx (arg 4)
# Win64 outgoing:    rcx (arg 1), rdx (arg 2), r8 (arg 3), r9 (arg 4) + 32-byte shadow space!
fn abi_synthesize_adapter_fast_to_win64(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1;

    # sub rsp, 32 (48 83 ec 20: allocate mandatory Win64 shadow space)
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 32); l = l + 1;

    if arity >= 4 {
        # mov r9, rdx (49 89 d1)
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 209); l = l + 1;
    }
    if arity >= 3 {
        # mov r8, rcx (49 89 c8)
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 200); l = l + 1;
    }
    if arity >= 2 {
        # mov rdx, rbx (48 89 da)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 218); l = l + 1;
    }
    if arity >= 1 {
        # mov rcx, rax (48 89 c1)
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 193); l = l + 1;
    }

    if target_ptr != 0 {
        set_byte(code_buf, l, 73); l = l + 1; set_byte(code_buf, l, 187); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 65); l = l + 1; set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 211); l = l + 1;
    }

    # add rsp, 32 (48 83 c4 20: tear down shadow space)
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 196); l = l + 1; set_byte(code_buf, l, 32); l = l + 1;

    set_byte(code_buf, l, 93); l = l + 1; # pop rbp
    set_byte(code_buf, l, 195); l = l + 1; # ret
    return l;
}

# ------------------------------------------------------------------------------
# 11. Pairwise Adapters: Intra-ISA Machine Code Trampolines
# ------------------------------------------------------------------------------

# Pair 4: AArch64 AAPCS64 -> Apple Darwin ARM64
# Zero-extends 32-bit registers in caller and aligns arguments for Darwin
fn abi_synthesize_adapter_aapcs_to_darwin(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    # stp x29, x30, [sp, -16]! (e8 07 bf a9)
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 191); l = l + 1; set_byte(code_buf, l, 169); l = l + 1;
    # mov x29, sp (fd 03 00 91)
    set_byte(code_buf, l, 253); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1;
    if arity >= 1 { # uxtw x0, w0 (e0 03 00 2a)
        set_byte(code_buf, l, 224); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 42); l = l + 1;
    }
    if arity >= 2 { # uxtw x1, w1 (e1 03 01 2a)
        set_byte(code_buf, l, 225); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 42); l = l + 1;
    }
    if arity >= 3 { # uxtw x2, w2 (e2 03 02 2a)
        set_byte(code_buf, l, 226); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 42); l = l + 1;
    }
    if arity >= 4 { # uxtw x3, w3 (e3 03 03 2a)
        set_byte(code_buf, l, 227); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 42); l = l + 1;
    }
    if target_ptr != 0 {
        # ldr x16, [pc, 16] (50 00 00 58); blr x16 (00 02 3f d6)
        set_byte(code_buf, l, 80); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 63); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    }
    # ldp x29, x30, [sp], 16 (e8 07 c1 a8); ret (c0 03 5f d6)
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 193); l = l + 1; set_byte(code_buf, l, 168); l = l + 1;
    set_byte(code_buf, l, 192); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 95); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# Pair 4 Reverse: Apple Darwin ARM64 -> AArch64 AAPCS64
fn abi_synthesize_adapter_darwin_to_aapcs(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 191); l = l + 1; set_byte(code_buf, l, 169); l = l + 1;
    set_byte(code_buf, l, 253); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1;
    if target_ptr != 0 {
        set_byte(code_buf, l, 80); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 63); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    }
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 193); l = l + 1; set_byte(code_buf, l, 168); l = l + 1;
    set_byte(code_buf, l, 192); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 95); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# Pair 5: AArch64 AAPCS64 -> Rubix Fastcall (AArch64)
# Fastcall uses x8..x13; AAPCS64 uses x0..x7
fn abi_synthesize_adapter_aapcs_to_fast(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 191); l = l + 1; set_byte(code_buf, l, 169); l = l + 1;
    set_byte(code_buf, l, 253); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1;
    if arity >= 1 { # mov x8, x0 (e8 03 00 aa)
        set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 170); l = l + 1;
    }
    if arity >= 2 { # mov x9, x1 (e9 03 01 aa)
        set_byte(code_buf, l, 233); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 170); l = l + 1;
    }
    if arity >= 3 { # mov x10, x2 (ea 03 02 aa)
        set_byte(code_buf, l, 242); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 170); l = l + 1;
    }
    if target_ptr != 0 {
        set_byte(code_buf, l, 80); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 63); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    }
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 193); l = l + 1; set_byte(code_buf, l, 168); l = l + 1;
    set_byte(code_buf, l, 192); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 95); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

