        set_byte(code_buf, l, 225); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 9); l = l + 1; set_byte(code_buf, l, 170); l = l + 1;
    }
    if target_ptr != 0 {
        set_byte(code_buf, l, 80); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 63); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    }
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 193); l = l + 1; set_byte(code_buf, l, 168); l = l + 1;
    set_byte(code_buf, l, 192); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 95); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

