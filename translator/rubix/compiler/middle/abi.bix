fn abi_synthesize_adapter_fast_to_aapcs(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 191); l = l + 1; set_byte(code_buf, l, 169); l = l + 1;
