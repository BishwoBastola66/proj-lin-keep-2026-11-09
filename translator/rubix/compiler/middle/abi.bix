# 12. Cross-ISA Emulation/IPC Bridges & WASI Canonical ABI Translators
# ------------------------------------------------------------------------------

# Real x86-64 machine thunk: builds an 80-byte BridgeFrame on stack, spills incoming registers, calls bridge
fn abi_emit_x86_bridge_thunk(code_buf: i64, cur_len: i64, caller_abi: i64, callee_abi: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 80); l = l + 1; # sub rsp, 80

    if (caller_abi == ABI_SYSV) | (caller_abi == ABI_RUBIX_FAST) {
        if arity >= 1 { # mov [rsp + 24], rdi
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 24); l = l + 1;
        }
        if arity >= 2 { # mov [rsp + 32], rsi
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 116); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 32); l = l + 1;
        }
        if arity >= 3 { # mov [rsp + 40], rdx
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 84); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 40); l = l + 1;
        }
        if arity >= 4 { # mov [rsp + 48], rcx
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 48); l = l + 1;
        }
    }
    if caller_abi == ABI_WIN64 {
        if arity >= 1 { # mov [rsp + 24], rcx
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 24); l = l + 1;
        }
        if arity >= 2 { # mov [rsp + 32], rdx
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 84); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 32); l = l + 1;
        }
        if arity >= 3 { # mov [rsp + 40], r8
            set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 68); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 40); l = l + 1;
        }
        if arity >= 4 { # mov [rsp + 48], r9
            set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 76); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 48); l = l + 1;
        }
    }

    # lea rdi, [rsp + 24] (pass bridge context buffer)
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 141); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 24); l = l + 1;

    if target_ptr != 0 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 208); l = l + 1; # call rax
    }

    set_byte(code_buf, l, 201); l = l + 1; # leave
    set_byte(code_buf, l, 195); l = l + 1; # ret
    return l;
}

# Real AArch64 machine thunk: spills ARM registers into frame buffer, calls bridge
fn abi_emit_arm_bridge_thunk(code_buf: i64, cur_len: i64, caller_abi: i64, callee_abi: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 188); l = l + 1; set_byte(code_buf, l, 169); l = l + 1; # stp x29, x30, [sp, -64]!
    set_byte(code_buf, l, 253); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1; # mov x29, sp
    set_byte(code_buf, l, 224); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 169); l = l + 1; # stp x0, x1, [sp, 16]
    set_byte(code_buf, l, 224); l = l + 1; set_byte(code_buf, l, 4); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1; # add x0, sp, 16
    if target_ptr != 0 {
        set_byte(code_buf, l, 80); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 63); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    }
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 196); l = l + 1; set_byte(code_buf, l, 168); l = l + 1; # ldp x29, x30, [sp], 64
    set_byte(code_buf, l, 192); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 95); l = l + 1; set_byte(code_buf, l, 214); l = l + 1; # ret
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# Real RISC-V machine thunk: spills RV64 registers into frame buffer, calls bridge
fn abi_emit_riscv_bridge_thunk(code_buf: i64, cur_len: i64, caller_abi: i64, callee_abi: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 252); l = l + 1; # addi sp, sp, -64
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 51); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; # sd ra, 56(sp)
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; # sd s0, 48(sp)
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 40); l = l + 1; set_byte(code_buf, l, 10); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # sd a0, 0(sp)
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 44); l = l + 1; set_byte(code_buf, l, 11); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # sd a1, 8(sp)
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 133); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; # mv a0, sp
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 51); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; # ld ra, 56(sp)
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 50); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; # ld s0, 48(sp)
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 4); l = l + 1; # addi sp, sp, 64
    set_byte(code_buf, l, 103); l = l + 1; set_byte(code_buf, l, 128); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # ret
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# WASI Canonical ABI: lifts and lowers linear memory parameters vs registers
fn abi_synthesize_wasi_canonical_adapter(caller_abi: i64, callee_abi: i64, code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; # sub rsp, 48

    if callee_abi == ABI_WASI {
        # Lowering: Marshall registers into WASI linear memory pointer
        if arity >= 1 {
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # mov [rsp], rdi
        }
        if arity >= 2 {
            set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 116); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; # mov [rsp + 8], rsi
        }
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 231); l = l + 1; # mov rdi, rsp
    } else {
        # Lifting: Unpack WASI linear memory pointers into registers
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 139); l = l + 1; set_byte(code_buf, l, 55); l = l + 1; # mov rsi, [rdi]
    }

    if target_ptr != 0 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 208); l = l + 1; # call rax
    }
    set_byte(code_buf, l, 201); l = l + 1; # leave
    set_byte(code_buf, l, 195); l = l + 1; # ret
    return l;
}

