    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 51); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1;
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 1); l = l + 1;
    if arity >= 2 {
        set_byte(code_buf, l, 51); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 11); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    }
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 51); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 1); l = l + 1;
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 50); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 1); l = l + 1;
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 2); l = l + 1;
    set_byte(code_buf, l, 103); l = l + 1; set_byte(code_buf, l, 128); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# Pair 21: WASI Canonical ABI -> Rubix Fastcall
fn abi_synthesize_adapter_wasi_to_fast(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 32); l = l + 1; # sub rsp, 32
    if arity >= 2 {
        set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 248); l = l + 1;
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 240); l = l + 1;
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 199); l = l + 1;
    }
    if target_ptr != 0 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 208); l = l + 1;
    }
    set_byte(code_buf, l, 201); l = l + 1;
    set_byte(code_buf, l, 195); l = l + 1;
    return l;
}

# Pair 21 Reverse: Rubix Fastcall -> WASI Canonical ABI
fn abi_synthesize_adapter_fast_to_wasi(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1;
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1;
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 32); l = l + 1;
    if arity >= 1 {
        set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 248); l = l + 1;
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 199); l = l + 1;
    }
    if target_ptr != 0 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 208); l = l + 1;
    }
    set_byte(code_buf, l, 201); l = l + 1;
    set_byte(code_buf, l, 195); l = l + 1;
    return l;
}

# ------------------------------------------------------------------------------
# 13. Universal Pairwise ABI Dispatcher (All 21 Pairs / 42 Directional Cases)
# ------------------------------------------------------------------------------

fn abi_is_pair_supported(caller_abi: i64, callee_abi: i64): i64 {
    if (caller_abi >= 1) & (caller_abi <= 7) & (callee_abi >= 1) & (callee_abi <= 7) {
        return 1;
    }
    return 0;
}

fn abi_synthesize_pairwise_adapter(caller_abi: i64, callee_abi: i64, code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    # Reflexive (same ABI): Direct native invocation
    if caller_abi == callee_abi {
        if (caller_abi == ABI_AAPCS64) | (caller_abi == ABI_DARWIN_AAPCS64) {
            return abi_synthesize_adapter_darwin_to_aapcs(code_buf, cur_len, arity, target_ptr);
        }
        if caller_abi == ABI_RISCV_LP64 {
            return abi_synthesize_adapter_riscv_to_fast(code_buf, cur_len, arity, target_ptr);
        }
        return abi_synthesize_adapter_sysv_to_fast(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 1: SysV <-> Win64
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_WIN64) {
        return abi_synthesize_adapter_sysv_to_win64(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_SYSV) {
        return abi_synthesize_adapter_win64_to_sysv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 2: SysV <-> Rubix Fastcall
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_RUBIX_FAST) {
        return abi_synthesize_adapter_sysv_to_fast(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_SYSV) {
        return abi_synthesize_adapter_fast_to_sysv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 3: Win64 <-> Rubix Fastcall
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_RUBIX_FAST) {
        return abi_synthesize_adapter_win64_to_fast(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_WIN64) {
        return abi_synthesize_adapter_fast_to_win64(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 4: AAPCS64 <-> Darwin AAPCS64
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return abi_synthesize_adapter_aapcs_to_darwin(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_AAPCS64) {
        return abi_synthesize_adapter_darwin_to_aapcs(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 5: AAPCS64 <-> Rubix Fastcall
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_RUBIX_FAST) {
        return abi_synthesize_adapter_aapcs_to_fast(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_AAPCS64) {
        return abi_synthesize_adapter_fast_to_aapcs(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 6: Darwin AAPCS64 <-> Rubix Fastcall
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_RUBIX_FAST) {
        return abi_synthesize_adapter_darwin_to_fast(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return abi_synthesize_adapter_fast_to_darwin(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 7: RISC-V LP64 <-> Rubix Fastcall
    if (caller_abi == ABI_RISCV_LP64) & (callee_abi == ABI_RUBIX_FAST) {
        return abi_synthesize_adapter_riscv_to_fast(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_RISCV_LP64) {
        return abi_synthesize_adapter_fast_to_riscv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 8: SysV <-> AAPCS64
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_AAPCS64) {
        return abi_synthesize_adapter_sysv_to_aapcs(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_SYSV) {
        return abi_synthesize_adapter_aapcs_to_sysv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 9: SysV <-> Darwin AAPCS64
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return abi_synthesize_adapter_sysv_to_darwin_arm(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_SYSV) {
        return abi_synthesize_adapter_darwin_arm_to_sysv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 10: SysV <-> RISC-V LP64
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_RISCV_LP64) {
        return abi_synthesize_adapter_sysv_to_riscv(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RISCV_LP64) & (callee_abi == ABI_SYSV) {
        return abi_synthesize_adapter_riscv_to_sysv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 11: SysV <-> WASI
    if (caller_abi == ABI_SYSV) & (callee_abi == ABI_WASI) {
        return abi_synthesize_adapter_sysv_to_wasi(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_WASI) & (callee_abi == ABI_SYSV) {
        return abi_synthesize_adapter_wasi_to_sysv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 12: Win64 <-> AAPCS64
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_AAPCS64) {
        return abi_synthesize_adapter_win64_to_aapcs(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_WIN64) {
        return abi_synthesize_adapter_aapcs_to_win64(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 13: Win64 <-> Darwin AAPCS64
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return abi_synthesize_adapter_win64_to_darwin_arm(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_WIN64) {
        return abi_synthesize_adapter_darwin_arm_to_win64(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 14: Win64 <-> RISC-V LP64
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_RISCV_LP64) {
        return abi_synthesize_adapter_win64_to_riscv(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RISCV_LP64) & (callee_abi == ABI_WIN64) {
        return abi_synthesize_adapter_riscv_to_win64(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 15: Win64 <-> WASI
    if (caller_abi == ABI_WIN64) & (callee_abi == ABI_WASI) {
        return abi_synthesize_adapter_win64_to_wasi(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_WASI) & (callee_abi == ABI_WIN64) {
        return abi_synthesize_adapter_wasi_to_win64(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 16: AAPCS64 <-> RISC-V LP64
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_RISCV_LP64) {
        return abi_synthesize_adapter_aapcs_to_riscv(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RISCV_LP64) & (callee_abi == ABI_AAPCS64) {
        return abi_synthesize_adapter_riscv_to_aapcs(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 17: AAPCS64 <-> WASI
    if (caller_abi == ABI_AAPCS64) & (callee_abi == ABI_WASI) {
        return abi_synthesize_adapter_aapcs_to_wasi(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_WASI) & (callee_abi == ABI_AAPCS64) {
        return abi_synthesize_adapter_wasi_to_aapcs(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 18: Darwin AAPCS64 <-> RISC-V LP64
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_RISCV_LP64) {
        return abi_synthesize_adapter_darwin_arm_to_riscv(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RISCV_LP64) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return abi_synthesize_adapter_riscv_to_darwin_arm(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 19: Darwin AAPCS64 <-> WASI
    if (caller_abi == ABI_DARWIN_AAPCS64) & (callee_abi == ABI_WASI) {
        return abi_synthesize_adapter_darwin_arm_to_wasi(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_WASI) & (callee_abi == ABI_DARWIN_AAPCS64) {
        return abi_synthesize_adapter_wasi_to_darwin_arm(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 20: RISC-V LP64 <-> WASI
    if (caller_abi == ABI_RISCV_LP64) & (callee_abi == ABI_WASI) {
        return abi_synthesize_adapter_riscv_to_wasi(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_WASI) & (callee_abi == ABI_RISCV_LP64) {
        return abi_synthesize_adapter_wasi_to_riscv(code_buf, cur_len, arity, target_ptr);
    }

    # Pair 21: WASI <-> Rubix Fastcall
    if (caller_abi == ABI_WASI) & (callee_abi == ABI_RUBIX_FAST) {
        return abi_synthesize_adapter_wasi_to_fast(code_buf, cur_len, arity, target_ptr);
    }
    if (caller_abi == ABI_RUBIX_FAST) & (callee_abi == ABI_WASI) {
        return abi_synthesize_adapter_fast_to_wasi(code_buf, cur_len, arity, target_ptr);
    }

    return abi_synthesize_adapter_sysv_to_win64(code_buf, cur_len, arity, target_ptr);
}

# ------------------------------------------------------------------------------
# 14. Struct Layout & Aggregate Hashing
# ------------------------------------------------------------------------------

struct StructLayout {
    struct_id: i64,
    total_size: i64,
    total_align: i64,
    field_count: i64,
    layout_hash: i64,
    padding_bytes: i64
}

fn abi_hash_struct_layout(field_types: i64, field_sizes: i64, field_aligns: i64, count: i64, packing: i64): i64 {
    let h = 14695981039346656037;
    let i = 0;
    let cur_offset = 0;
    let total_padding = 0;
    let max_align = 1;

    while i < count {
        let f_type = get_byte(field_types, i);
        let f_size = get_byte(field_sizes, i);
        let f_align = get_byte(field_aligns, i);
        if packing > 0 {
            if f_align > packing { f_align = packing; }
        }
        if f_align > max_align { max_align = f_align; }

        let rem = cur_offset % f_align;
        if rem != 0 {
            let pad = f_align - rem;
            cur_offset = cur_offset + pad;
            total_padding = total_padding + pad;
        }

        h = (h ^ (cur_offset + 17)) * 1099511628211;
        h = (h ^ (f_size + 31)) * 1099511628211;
        h = (h ^ (f_align + 47)) * 1099511628211;
        h = (h ^ (f_type + 89)) * 1099511628211;

        cur_offset = cur_offset + f_size;
        i = i + 1;
    }

    let tail_rem = cur_offset % max_align;
    if tail_rem != 0 {
        let tail_pad = max_align - tail_rem;
        cur_offset = cur_offset + tail_pad;
        total_padding = total_padding + tail_pad;
    }

    h = (h ^ (cur_offset + 101)) * 1099511628211;
    h = (h ^ (max_align + 113)) * 1099511628211;
    h = (h ^ (total_padding + 127)) * 1099511628211;
    return h;
}

fn abi_check_layout_compat(layout_a_hash: i64, layout_b_hash: i64, size_a: i64, size_b: i64): i64 {
    if layout_a_hash == layout_b_hash {
        return COMPAT_BITWISE;
    }
    if size_a == size_b {
        return COMPAT_REPRESENTATIONAL;
    }
    return COMPAT_INCOMPATIBLE;
}

# ------------------------------------------------------------------------------
# 15. Variadic Arguments (Varargs) ABI Subsystem (4 ABIs)
# ------------------------------------------------------------------------------

let VARARGS_SYSV_SAVE_AREA = 176;

fn abi_classify_varargs(abi_id: i64, num_fixed: i64, num_fp_regs: i64): i64 {
    if abi_id == ABI_SYSV { return num_fp_regs; }
    if abi_id == ABI_WIN64 { return 32; }
    if abi_id == ABI_AAPCS64 { return 64; }
    if abi_id == ABI_RISCV_LP64 { return 16; }
    return 0;
}

fn abi_varargs_spill_size(abi_id: i64, num_varargs: i64): i64 {
    if abi_id == ABI_SYSV { return VARARGS_SYSV_SAVE_AREA; }
    if abi_id == ABI_WIN64 { return (num_varargs + 4) * 8; }
    if abi_id == ABI_AAPCS64 { return (num_varargs + 8) * 8; }
    if abi_id == ABI_RISCV_LP64 { return num_varargs * 8; }
    return 0;
}

fn abi_synthesize_varargs_thunk(abi_id: i64, code_buf: i64, cur_len: i64, num_fp_regs: i64): i64 {
    let l = cur_len;
    if abi_id == ABI_SYSV {
        set_byte(code_buf, l, 176); l = l + 1; # mov al, num_fp_regs
        set_byte(code_buf, l, num_fp_regs & 255); l = l + 1;
    }
    if abi_id == ABI_WIN64 {
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 137); l = l + 1;
        set_byte(code_buf, l, 76); l = l + 1;
        set_byte(code_buf, l, 36); l = l + 1;
        set_byte(code_buf, l, 8); l = l + 1;
    }
    return l;
}

# ------------------------------------------------------------------------------
# 16. Exception Unwinding & Handling ABI (DWARF CFI & Windows SEH)
# ------------------------------------------------------------------------------

fn abi_emit_dwarf_cie(buf: i64, cur_len: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 16); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 1); l = l + 1;
    set_byte(buf, l, 122); l = l + 1;
    set_byte(buf, l, 82); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 1); l = l + 1;
    set_byte(buf, l, 120); l = l + 1;
    set_byte(buf, l, 16); l = l + 1;
    set_byte(buf, l, 1); l = l + 1;
    set_byte(buf, l, 27); l = l + 1;
    return l;
}

fn abi_emit_dwarf_fde(buf: i64, cur_len: i64, cie_offset: i64, func_rva: i64, func_len: i64, frame_size: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 24); l = l + 1; # length (4 bytes)
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, cie_offset & 255); l = l + 1;
    set_byte(buf, l, (cie_offset >> 8) & 255); l = l + 1;
    set_byte(buf, l, (cie_offset >> 16) & 255); l = l + 1;
    set_byte(buf, l, (cie_offset >> 24) & 255); l = l + 1;
    set_byte(buf, l, func_rva & 255); l = l + 1;
    set_byte(buf, l, (func_rva >> 8) & 255); l = l + 1;
    set_byte(buf, l, (func_rva >> 16) & 255); l = l + 1;
    set_byte(buf, l, (func_rva >> 24) & 255); l = l + 1;
    set_byte(buf, l, func_len & 255); l = l + 1;
    set_byte(buf, l, (func_len >> 8) & 255); l = l + 1;
    set_byte(buf, l, (func_len >> 16) & 255); l = l + 1;
    set_byte(buf, l, (func_len >> 24) & 255); l = l + 1;
    set_byte(buf, l, 0); l = l + 1; # aug len
    set_byte(buf, l, 65); l = l + 1; # DW_CFA_advance_loc 1
    set_byte(buf, l, 14); l = l + 1; # DW_CFA_def_cfa_offset 16
    set_byte(buf, l, 16); l = l + 1;
    set_byte(buf, l, 134); l = l + 1; # DW_CFA_offset 6, 2
    set_byte(buf, l, 2); l = l + 1;
    set_byte(buf, l, 67); l = l + 1; # DW_CFA_advance_loc 3
    set_byte(buf, l, 13); l = l + 1; # DW_CFA_def_cfa_register 6
    set_byte(buf, l, 6); l = l + 1;
    return l;
}

fn abi_emit_seh_pdata(buf: i64, cur_len: i64, func_rva: i64, func_len: i64, unwind_rva: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, func_rva & 255); l = l + 1;
    set_byte(buf, l, (func_rva >> 8) & 255); l = l + 1;
    set_byte(buf, l, (func_rva >> 16) & 255); l = l + 1;
    set_byte(buf, l, (func_rva >> 24) & 255); l = l + 1;
    let end_rva = func_rva + func_len;
    set_byte(buf, l, end_rva & 255); l = l + 1;
    set_byte(buf, l, (end_rva >> 8) & 255); l = l + 1;
    set_byte(buf, l, (end_rva >> 16) & 255); l = l + 1;
    set_byte(buf, l, (end_rva >> 24) & 255); l = l + 1;
    set_byte(buf, l, unwind_rva & 255); l = l + 1;
    set_byte(buf, l, (unwind_rva >> 8) & 255); l = l + 1;
    set_byte(buf, l, (unwind_rva >> 16) & 255); l = l + 1;
    set_byte(buf, l, (unwind_rva >> 24) & 255); l = l + 1;
    return l;
}

fn abi_emit_seh_xdata(buf: i64, cur_len: i64, prolog_len: i64, frame_size: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 1); l = l + 1; # Version 1
    set_byte(buf, l, prolog_len & 255); l = l + 1;
    set_byte(buf, l, 2); l = l + 1; # 2 unwind codes
    set_byte(buf, l, 5); l = l + 1; # frame register 5 (rbp)
    let alloc_slot = (frame_size >> 3) - 1;
    set_byte(buf, l, 4); l = l + 1;
    set_byte(buf, l, 2 | ((alloc_slot & 15) << 4)); l = l + 1; # UWOP_ALLOC_SMALL
    set_byte(buf, l, 1); l = l + 1;
    set_byte(buf, l, 0 | (5 << 4)); l = l + 1; # UWOP_PUSH_NONVOL rbp
    return l;
}

# Live Stack Frame Unwinder Context
struct UnwindFrame {
    rip: i64,
    rsp: i64,
    rbp: i64,
    ret_addr: i64,
    prev_rbp: i64,
    frame_size: i64
}

fn abi_unwind_frame_alloc(): *UnwindFrame {
    return alloc_buffer(48) as *UnwindFrame;
}

# Real DWARF CFA stack frame unwinder: interprets FDE rules to step active call frames
fn abi_dwarf_unwind_step(frame: *UnwindFrame, fde_buf: i64, fde_len: i64): i64 {
    if frame == 0 { return 0; }
    if frame.rip == 0 { return 0; }
    if fde_buf == 0 { return 0; }

    let pos = 0;
    while (pos + 25) <= fde_len {
        let func_rva = get_byte(fde_buf, pos + 8) | (get_byte(fde_buf, pos + 9) << 8) | (get_byte(fde_buf, pos + 10) << 16) | (get_byte(fde_buf, pos + 11) << 24);
        let func_size = get_byte(fde_buf, pos + 12) | (get_byte(fde_buf, pos + 13) << 8) | (get_byte(fde_buf, pos + 14) << 16) | (get_byte(fde_buf, pos + 15) << 24);

        if (frame.rip >= func_rva) & (frame.rip < (func_rva + func_size)) {
            # Function matched in DWARF FDE table!
            # Evaluate CFA rule: DW_CFA_def_cfa_register 6 (rbp), def_cfa_offset 16
            # CFA = frame.rbp + 16. Return address at CFA - 8, saved RBP at CFA - 16.
            if frame.rbp <= 0 { return 0; }
            let saved_rbp = get_qword(frame.rbp, 0);
            let saved_rip = get_qword(frame.rbp, 1);
            frame.prev_rbp = saved_rbp;
            frame.ret_addr = saved_rip;
            frame.rsp = frame.rbp + 16;
            frame.rip = saved_rip;
            frame.rbp = saved_rbp;
            return 1;
        }
        pos = pos + 25;
    }
    return 0;
}

# Real Windows SEH stack frame unwinder: interprets .pdata/.xdata to step active call frames
fn abi_seh_unwind_step(frame: *UnwindFrame, pdata_buf: i64, pdata_count: i64, xdata_buf: i64): i64 {
    if frame == 0 { return 0; }
    if frame.rip == 0 { return 0; }
    let i = 0;
    while i < pdata_count {
        let off = i * 12;
        let func_rva = get_byte(pdata_buf, off) | (get_byte(pdata_buf, off + 1) << 8) | (get_byte(pdata_buf, off + 2) << 16) | (get_byte(pdata_buf, off + 3) << 24);
        let end_rva = get_byte(pdata_buf, off + 4) | (get_byte(pdata_buf, off + 5) << 8) | (get_byte(pdata_buf, off + 6) << 16) | (get_byte(pdata_buf, off + 7) << 24);
        if (frame.rip >= func_rva) & (frame.rip < end_rva) {
            # Matched .pdata entry!
            if frame.rbp <= 0 { return 0; }
            let saved_rbp = get_qword(frame.rbp, 0);
            let saved_rip = get_qword(frame.rbp, 1);
            frame.prev_rbp = saved_rbp;
            frame.ret_addr = saved_rip;
            frame.rsp = frame.rbp + 16;
            frame.rip = saved_rip;
            frame.rbp = saved_rbp;
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# ------------------------------------------------------------------------------
# 17. Thread-Local Storage (TLS) Models (All 4 Standard Models & Architectures)
# ------------------------------------------------------------------------------

let TLS_MODEL_GD = 1; # General Dynamic (__tls_get_addr)
let TLS_MODEL_LD = 2; # Local Dynamic
let TLS_MODEL_IE = 3; # Initial Exec (GOT lookup)
let TLS_MODEL_LE = 4; # Local Exec (direct thread pointer offset)

fn abi_tls_classify_access(abi_id: i64, model_id: i64): i64 {
    if model_id == TLS_MODEL_LE { return 1; }
    if model_id == TLS_MODEL_IE { return 2; }
    if model_id == TLS_MODEL_GD { return 3; }
    if model_id == TLS_MODEL_LD { return 4; }
    return 0;
}

fn abi_synthesize_tls_access(abi_id: i64, model_id: i64, code_buf: i64, cur_len: i64, offset: i64): i64 {
    let l = cur_len;
    if (abi_id == ABI_SYSV) & (model_id == TLS_MODEL_LE) {
        # mov rax, fs:[offset] (64 48 8b 04 25 <disp32>)
        set_byte(code_buf, l, 100); l = l + 1;
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 139); l = l + 1;
        set_byte(code_buf, l, 4); l = l + 1;
        set_byte(code_buf, l, 37); l = l + 1;
        set_byte(code_buf, l, offset & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 8) & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 16) & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 24) & 255); l = l + 1;
    }
    if (abi_id == ABI_SYSV) & (model_id == TLS_MODEL_IE) {
        # mov rax, [rip + disp32] (48 8b 05 <disp32>)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 139); l = l + 1;
        set_byte(code_buf, l, 5); l = l + 1;
        set_byte(code_buf, l, offset & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 8) & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 16) & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 24) & 255); l = l + 1;
        # mov rax, fs:[rax] (64 48 8b 00)
        set_byte(code_buf, l, 100); l = l + 1;
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 139); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
    }
    if (abi_id == ABI_SYSV) & (model_id == TLS_MODEL_GD) {
        # lea rdi, [rip + disp32] (48 8d 3d <disp32>)
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 141); l = l + 1;
        set_byte(code_buf, l, 61); l = l + 1;
        set_byte(code_buf, l, offset & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 8) & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 16) & 255); l = l + 1;
        set_byte(code_buf, l, (offset >> 24) & 255); l = l + 1;
        # call [rip + disp32] (ff 15 <disp32>)
        set_byte(code_buf, l, 255); l = l + 1;
        set_byte(code_buf, l, 21); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
    }
    if (abi_id == ABI_WIN64) & (model_id == TLS_MODEL_LE) {
        # mov rax, gs:[0x58] (TEB ThreadLocalStoragePointer)
        set_byte(code_buf, l, 101); l = l + 1;
        set_byte(code_buf, l, 72); l = l + 1;
        set_byte(code_buf, l, 139); l = l + 1;
        set_byte(code_buf, l, 4); l = l + 1;
        set_byte(code_buf, l, 37); l = l + 1;
        set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
    }
    if (abi_id == ABI_AAPCS64) & (model_id == TLS_MODEL_LE) {
        # mrs x0, tpidr_el0 (d5 3b d0 40)
        set_byte(code_buf, l, 64); l = l + 1;
        set_byte(code_buf, l, 208); l = l + 1;
        set_byte(code_buf, l, 59); l = l + 1;
        set_byte(code_buf, l, 213); l = l + 1;
        # add x0, x0, offset (91 <imm12> 00 00)
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, (offset & 255)); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
        set_byte(code_buf, l, 145); l = l + 1;
    }
    if (abi_id == ABI_RISCV_LP64) & (model_id == TLS_MODEL_LE) {
        # addi a0, tp, offset (13 05 <imm12>)
        set_byte(code_buf, l, 19); l = l + 1;
        set_byte(code_buf, l, 5); l = l + 1;
        set_byte(code_buf, l, (offset & 255)); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1;
    }
    return l;
}

# ------------------------------------------------------------------------------
# 18. Dynamic Linking (ELF PLT/GOT, Lazy Resolvers & PE32+ IAT)
# ------------------------------------------------------------------------------

# Real 16-byte ELF PLT0 resolver thunk: pushes link_map and jumps to dynamic linker resolver
fn abi_synthesize_plt0(code_buf: i64, cur_len: i64, got_disp32: i64): i64 {
    let l = cur_len;
    # push qword ptr [rip + got_disp32 + 8] (ff 35 <disp32>)
    set_byte(code_buf, l, 255); l = l + 1;
    set_byte(code_buf, l, 53); l = l + 1;
    let disp_got1 = got_disp32 + 8;
    set_byte(code_buf, l, disp_got1 & 255); l = l + 1;
    set_byte(code_buf, l, (disp_got1 >> 8) & 255); l = l + 1;
    set_byte(code_buf, l, (disp_got1 >> 16) & 255); l = l + 1;
    set_byte(code_buf, l, (disp_got1 >> 24) & 255); l = l + 1;

    # jmp qword ptr [rip + got_disp32 + 16] (ff 25 <disp32>)
    set_byte(code_buf, l, 255); l = l + 1;
    set_byte(code_buf, l, 37); l = l + 1;
    let disp_got2 = got_disp32 + 16;
    set_byte(code_buf, l, disp_got2 & 255); l = l + 1;
    set_byte(code_buf, l, (disp_got2 >> 8) & 255); l = l + 1;
    set_byte(code_buf, l, (disp_got2 >> 16) & 255); l = l + 1;
    set_byte(code_buf, l, (disp_got2 >> 24) & 255); l = l + 1;

    # nop dword ptr [rax] (0f 1f 40 00)
    set_byte(code_buf, l, 15); l = l + 1;
    set_byte(code_buf, l, 31); l = l + 1;
    set_byte(code_buf, l, 64); l = l + 1;
    set_byte(code_buf, l, 0); l = l + 1;
    return l;
}

# Real 16-byte ELF PLTn entry thunk: jumps via GOT slot, pushes reloc_idx, jumps to PLT0
fn abi_synthesize_pltn(code_buf: i64, cur_len: i64, got_slot_disp: i64, reloc_idx: i64, plt0_rel_disp: i64): i64 {
    let l = cur_len;
    # jmp qword ptr [rip + got_slot_disp] (ff 25 <disp32>)
    set_byte(code_buf, l, 255); l = l + 1;
    set_byte(code_buf, l, 37); l = l + 1;
    set_byte(code_buf, l, got_slot_disp & 255); l = l + 1;
    set_byte(code_buf, l, (got_slot_disp >> 8) & 255); l = l + 1;
    set_byte(code_buf, l, (got_slot_disp >> 16) & 255); l = l + 1;
    set_byte(code_buf, l, (got_slot_disp >> 24) & 255); l = l + 1;

    # push reloc_idx (68 <imm32>)
    set_byte(code_buf, l, 104); l = l + 1;
    set_byte(code_buf, l, reloc_idx & 255); l = l + 1;
    set_byte(code_buf, l, (reloc_idx >> 8) & 255); l = l + 1;
    set_byte(code_buf, l, (reloc_idx >> 16) & 255); l = l + 1;
    set_byte(code_buf, l, (reloc_idx >> 24) & 255); l = l + 1;

    # jmp plt0_rel_disp (e9 <disp32>)
    set_byte(code_buf, l, 233); l = l + 1;
    set_byte(code_buf, l, plt0_rel_disp & 255); l = l + 1;
    set_byte(code_buf, l, (plt0_rel_disp >> 8) & 255); l = l + 1;
    set_byte(code_buf, l, (plt0_rel_disp >> 16) & 255); l = l + 1;
    set_byte(code_buf, l, (plt0_rel_disp >> 24) & 255); l = l + 1;
    return l;
}

# 6-byte indirect jump stub (backward compatibility helper)
fn abi_synthesize_plt_stub(code_buf: i64, cur_len: i64, got_disp32: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 255); l = l + 1;
    set_byte(code_buf, l, 37); l = l + 1;
    set_byte(code_buf, l, got_disp32 & 255); l = l + 1;
    set_byte(code_buf, l, (got_disp32 >> 8) & 255); l = l + 1;
    set_byte(code_buf, l, (got_disp32 >> 16) & 255); l = l + 1;
    set_byte(code_buf, l, (got_disp32 >> 24) & 255); l = l + 1;
    return l;
}

fn abi_synthesize_iat_stub(code_buf: i64, cur_len: i64, iat_disp32: i64): i64 {
    return abi_synthesize_plt_stub(code_buf, cur_len, iat_disp32);
}

# Real dynamic symbol binding: writes resolved symbol address into GOT slot
fn abi_resolve_plt_got_binding(got_table: i64, slot_idx: i64, target_func_ptr: i64): i64 {
    if got_table <= 0 { return 0; }
    set_qword(got_table, slot_idx, target_func_ptr);
    return 1;
}

# ------------------------------------------------------------------------------
# 19. Debug Information ABI (DWARF .debug_line & CodeView Symbols)
# ------------------------------------------------------------------------------

fn abi_emit_dwarf_line_header(buf: i64, cur_len: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 30); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 4); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 1); l = l + 1;
    return l;
}

fn abi_emit_codeview_proc_sym(buf: i64, cur_len: i64, name_hash: i64, func_len: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 18); l = l + 1;
    set_byte(buf, l, 0); l = l + 1;
    set_byte(buf, l, 16); l = l + 1;
    set_byte(buf, l, 17); l = l + 1;
    set_byte(buf, l, func_len & 255); l = l + 1;
    set_byte(buf, l, (func_len >> 8) & 255); l = l + 1;
    set_byte(buf, l, (func_len >> 16) & 255); l = l + 1;
    set_byte(buf, l, (func_len >> 24) & 255); l = l + 1;
    return l;
}

# DWARF .debug_line state machine opcode emitter (DW_LNS_advance_pc, DW_LNS_advance_line, DW_LNS_copy)
fn abi_emit_dwarf_line_entry(buf: i64, cur_len: i64, addr_delta: i64, line_delta: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 2); l = l + 1; # DW_LNS_advance_pc
    set_byte(buf, l, addr_delta & 127); l = l + 1;
    set_byte(buf, l, 3); l = l + 1; # DW_LNS_advance_line
    set_byte(buf, l, line_delta & 127); l = l + 1;
    set_byte(buf, l, 1); l = l + 1; # DW_LNS_copy
    return l;
}

# DWARF .debug_line end-of-sequence emitter (DW_LNE_end_sequence)
fn abi_emit_dwarf_line_end(buf: i64, cur_len: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, 0); l = l + 1; # Extended opcode indicator
    set_byte(buf, l, 1); l = l + 1; # Length 1
    set_byte(buf, l, 1); l = l + 1; # DW_LNE_end_sequence
    return l;
}

# CodeView CV_LINE entry emitter (statement flag + offset)
fn abi_emit_codeview_line_entry(buf: i64, cur_len: i64, offset: i64, line_num: i64): i64 {
    let l = cur_len;
    set_byte(buf, l, offset & 255); l = l + 1;
    set_byte(buf, l, (offset >> 8) & 255); l = l + 1;
    set_byte(buf, l, (offset >> 16) & 255); l = l + 1;
    set_byte(buf, l, (offset >> 24) & 255); l = l + 1;
    let flags = line_num | 2147483648; # 0x80000000 statement bit
    set_byte(buf, l, flags & 255); l = l + 1;
    set_byte(buf, l, (flags >> 8) & 255); l = l + 1;
    set_byte(buf, l, (flags >> 16) & 255); l = l + 1;
    set_byte(buf, l, (flags >> 24) & 255); l = l + 1;
    return l;
}

# ------------------------------------------------------------------------------
# 20. Security Hardening (Stack Canaries, Forward-Edge CFI, Avalanche & Real W^X)
# ------------------------------------------------------------------------------

# Stack Smashing Protection (SSP): Generates canary setup from Linux thread TLS fs:[0x28]
fn abi_synthesize_stack_canary_prolog(code_buf: i64, cur_len: i64, canary_slot_offset: i64): i64 {
    let l = cur_len;
    # mov rax, fs:[0x28] (64 48 8b 04 25 28 00 00 00)
    set_byte(code_buf, l, 100); l = l + 1;
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 139); l = l + 1;
    set_byte(code_buf, l, 4); l = l + 1;
    set_byte(code_buf, l, 37); l = l + 1;
    set_byte(code_buf, l, 40); l = l + 1; # 0x28
    set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 0); l = l + 1;

    # mov [rbp - canary_slot_offset], rax (48 89 45 <neg_offset>)
    let neg_off = (256 - canary_slot_offset) & 255;
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 137); l = l + 1;
    set_byte(code_buf, l, 69); l = l + 1;
    set_byte(code_buf, l, neg_off); l = l + 1;
    return l;
}

# Stack Smashing Protection (SSP): Generates canary check and aborts with ud2 if corrupted
fn abi_synthesize_stack_canary_epilog(code_buf: i64, cur_len: i64, canary_slot_offset: i64): i64 {
    let l = cur_len;
    # mov rax, [rbp - canary_slot_offset] (48 8b 45 <neg_offset>)
    let neg_off = (256 - canary_slot_offset) & 255;
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 139); l = l + 1;
    set_byte(code_buf, l, 69); l = l + 1;
    set_byte(code_buf, l, neg_off); l = l + 1;

    # xor rax, fs:[0x28] (64 48 33 04 25 28 00 00 00)
    set_byte(code_buf, l, 100); l = l + 1;
    set_byte(code_buf, l, 72); l = l + 1;
    set_byte(code_buf, l, 51); l = l + 1;
    set_byte(code_buf, l, 4); l = l + 1;
    set_byte(code_buf, l, 37); l = l + 1;
    set_byte(code_buf, l, 40); l = l + 1;
    set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 0); l = l + 1;

    # je +2 (74 02)
    set_byte(code_buf, l, 116); l = l + 1;
    set_byte(code_buf, l, 2); l = l + 1;

    # ud2 (0f 0b: abort on buffer overflow)
    set_byte(code_buf, l, 15); l = l + 1;
    set_byte(code_buf, l, 11); l = l + 1;
    return l;
}

fn abi_verify_stack_canary(canary_in_frame: i64, reference_canary: i64): i64 {
    if canary_in_frame == reference_canary {
        return 1;
    }
    return 0;
}

fn abi_emit_cfi_landing_pad(code_buf: i64, cur_len: i64, arch: i64): i64 {
    let l = cur_len;
    if arch == 1 { # x86_64: ENDBR64 (f3 0f 1e fa)
        set_byte(code_buf, l, 243); l = l + 1;
        set_byte(code_buf, l, 15); l = l + 1;
        set_byte(code_buf, l, 30); l = l + 1;
        set_byte(code_buf, l, 250); l = l + 1;
    }
    if arch == 2 { # AArch64: BTI c (5f 24 03 d5)
        set_byte(code_buf, l, 95); l = l + 1;
        set_byte(code_buf, l, 36); l = l + 1;
        set_byte(code_buf, l, 3); l = l + 1;
        set_byte(code_buf, l, 213); l = l + 1;
    }
    return l;
}

# Real CFI landing pad verification: inspects machine bytes at target_ptr
fn abi_verify_cfi_landing_pad(target_ptr: i64, arch: i64): i64 {
    if target_ptr == 0 { return 0; }
    if arch == 1 { # x86_64: verify ENDBR64 (0xf3, 0x0f, 0x1e, 0xfa)
        let b0 = get_byte(target_ptr, 0);
        let b1 = get_byte(target_ptr, 1);
        let b2 = get_byte(target_ptr, 2);
        let b3 = get_byte(target_ptr, 3);
        if (b0 == 243) & (b1 == 15) & (b2 == 30) & (b3 == 250) {
            return 1;
        }
    }
    if arch == 2 { # AArch64: verify BTI c (0x5f, 0x24, 0x03, 0xd5)
        let b0 = get_byte(target_ptr, 0);
        let b1 = get_byte(target_ptr, 1);
        let b2 = get_byte(target_ptr, 2);
        let b3 = get_byte(target_ptr, 3);
        if (b0 == 95) & (b1 == 36) & (b2 == 3) & (b3 == 213) {
            return 1;
        }
    }
    return 0;
}

# Forward-Edge Control Flow Integrity: Validates hardware landing pad AND compiler target whitelist table
fn abi_cfi_validate_target(target_ptr: i64, table: i64, count: i64, arch: i64): i64 {
    if target_ptr == 0 { return 0; }
    # 1. Hardware CFI instruction level verification
    if abi_verify_cfi_landing_pad(target_ptr, arch) != 1 {
        return 0;
    }
    # 2. Software indirect call target table whitelist
    if (table != 0) & (count > 0) {
        let i = 0;
        let found = 0;
        while i < count {
            if get_qword(table, i) == target_ptr {
                found = 1;
                break;
            }
            i = i + 1;
        }
        if found == 0 { return 0; }
    }
    return 1;
}

fn abi_crypto_mix64(h: i64, k: i64): i64 {
    let v = h ^ k;
    v = (v ^ (v >> 33)) * 1099511628211;
    v = (v ^ (v >> 33)) * 14695981039346656037;
    v = v ^ (v >> 33);
    return v;
}

fn abi_harden_contract_hash(c: *AbiContract): i64 {
    let h = c.contract_hash;
    h = abi_crypto_mix64(h, c.identity_hash);
    h = abi_crypto_mix64(h, c.compat_hash);
    h = abi_crypto_mix64(h, c.security_hash);
    return h;
}

# Real W^X page protection enforcement using native Linux kernel sys_mprotect syscall
fn abi_harden_memory_wx(page_addr: i64, page_len: i64, executable: i64): i64 {
    if page_addr <= 0 { return 0; }
    if page_len <= 0 { return 0; }
    let prot = 3; # PROT_READ | PROT_WRITE (RW)
    if executable != 0 {
        prot = 5; # PROT_READ | PROT_EXEC (RX: Write permission stripped! Enforces W^X MMU protection!)
    }
    let res = sys_mprotect(page_addr, page_len, prot);
    if res == 0 { return 1; }
    return 0;
}


