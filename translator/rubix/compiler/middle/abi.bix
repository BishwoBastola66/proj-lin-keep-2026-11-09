# Pair 7: RISC-V LP64 -> Rubix Fastcall (RISC-V)
# Fastcall uses t0, t1, t2; LP64 uses a0..a7
fn abi_synthesize_adapter_riscv_to_fast(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 255); l = l + 1; # addi sp, sp, -16
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 52); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # sd ra, 8(sp)
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # sd s0, 0(sp)
    if arity >= 1 { # mv t0, a0 (addi x5, x10, 0)
        set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 130); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    }
    if arity >= 2 { # mv t1, a1 (addi x6, x11, 0)
        set_byte(code_buf, l, 147); l = l + 1; set_byte(code_buf, l, 130); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    }
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # ld ra, 8(sp)
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 52); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # ld s0, 0(sp)
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; # addi sp, sp, 16
    set_byte(code_buf, l, 103); l = l + 1; set_byte(code_buf, l, 128); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # ret
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# Pair 7 Reverse: Rubix Fastcall -> RISC-V LP64
fn abi_synthesize_adapter_fast_to_riscv(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 255); l = l + 1;
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 52); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 35); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    if arity >= 1 { # mv a0, t0 (addi x10, x5, 0)
        set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 133); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    }
    if arity >= 2 { # mv a1, t1 (addi x11, x6, 0)
        set_byte(code_buf, l, 147); l = l + 1; set_byte(code_buf, l, 133); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    }
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 52); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    set_byte(code_buf, l, 19); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1; set_byte(code_buf, l, 1); l = l + 1;
    set_byte(code_buf, l, 103); l = l + 1; set_byte(code_buf, l, 128); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

