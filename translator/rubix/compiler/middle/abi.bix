# Pair 8: SysV AMD64 -> ARM64 Standard (AAPCS64)
fn abi_synthesize_adapter_sysv_to_aapcs(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; # sub rsp, 48
    if arity >= 1 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # mov [rsp], rdi
    }
    if arity >= 2 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 116); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 8); l = l + 1; # mov [rsp + 8], rsi
    }
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 141); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; # lea rdi, [rsp]
    if target_ptr != 0 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 208); l = l + 1; # call rax
    }
    set_byte(code_buf, l, 201); l = l + 1; # leave
    set_byte(code_buf, l, 195); l = l + 1; # ret
    return l;
}

# Pair 8 Reverse: ARM64 Standard (AAPCS64) -> SysV AMD64
fn abi_synthesize_adapter_aapcs_to_sysv(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 188); l = l + 1; set_byte(code_buf, l, 169); l = l + 1; # stp x29, x30, [sp, -64]!
    set_byte(code_buf, l, 253); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1; # mov x29, sp
    if arity >= 1 {
        set_byte(code_buf, l, 224); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 249); l = l + 1; # str x0, [sp, 16]
    }
    if arity >= 2 {
        set_byte(code_buf, l, 225); l = l + 1; set_byte(code_buf, l, 11); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 249); l = l + 1; # str x1, [sp, 24]
    }
    set_byte(code_buf, l, 224); l = l + 1; set_byte(code_buf, l, 4); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 145); l = l + 1; # add x0, sp, 16
    if target_ptr != 0 {
        set_byte(code_buf, l, 80); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 88); l = l + 1;
        set_byte(code_buf, l, 0); l = l + 1; set_byte(code_buf, l, 2); l = l + 1; set_byte(code_buf, l, 63); l = l + 1; set_byte(code_buf, l, 214); l = l + 1;
    }
    set_byte(code_buf, l, 232); l = l + 1; set_byte(code_buf, l, 7); l = l + 1; set_byte(code_buf, l, 196); l = l + 1; set_byte(code_buf, l, 168); l = l + 1; # ldp x29, x30, [sp], 64
    set_byte(code_buf, l, 192); l = l + 1; set_byte(code_buf, l, 3); l = l + 1; set_byte(code_buf, l, 95); l = l + 1; set_byte(code_buf, l, 214); l = l + 1; # ret
    if target_ptr != 0 {
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
    }
    return l;
}

# Pair 9: SysV AMD64 -> Apple Darwin ARM64
fn abi_synthesize_adapter_sysv_to_darwin_arm(code_buf: i64, cur_len: i64, arity: i64, target_ptr: i64): i64 {
    let l = cur_len;
    set_byte(code_buf, l, 85); l = l + 1; # push rbp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 229); l = l + 1; # mov rbp, rsp
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 131); l = l + 1; set_byte(code_buf, l, 236); l = l + 1; set_byte(code_buf, l, 48); l = l + 1; # sub rsp, 48
    if arity >= 1 {
        set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 255); l = l + 1; # mov edi, edi
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    }
    if arity >= 2 {
        set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 246); l = l + 1; # mov esi, esi
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 137); l = l + 1; set_byte(code_buf, l, 116); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 8); l = l + 1;
    }
    set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 141); l = l + 1; set_byte(code_buf, l, 124); l = l + 1; set_byte(code_buf, l, 36); l = l + 1; set_byte(code_buf, l, 0); l = l + 1;
    if target_ptr != 0 {
        set_byte(code_buf, l, 72); l = l + 1; set_byte(code_buf, l, 184); l = l + 1;
        let bi = 0; let p = target_ptr;
        while bi < 8 { set_byte(code_buf, l, p & 255); l = l + 1; p = p >> 8; bi = bi + 1; }
        set_byte(code_buf, l, 255); l = l + 1; set_byte(code_buf, l, 208); l = l + 1;
    }
    set_byte(code_buf, l, 201); l = l + 1;
    set_byte(code_buf, l, 195); l = l + 1;
    return l;
