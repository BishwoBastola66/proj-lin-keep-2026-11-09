# ==============================================================================
# Rubix — AIR to UIR Lowering Bridge
# File: compiler/backend/air_to_uir.bix
#
# Lowers verified Affine & Resource IR (AIR) into low-level Universal IR (UIR)
# for direct native machine code synthesis via RUMS.
# ==============================================================================

let UIR_ALLOC_STACK = 40;

fn air_lower_to_uir(air_buf: i64, uir_buf: i64): i64 {
    let air_count = air_get_count(air_buf);
    let uir_emitted = 0;
    let i = 0;

    while i < air_count {
        let op = air_get_op(air_buf, i);
        let dst = air_get_dst(air_buf, i);
        let s1 = air_get_src1(air_buf, i);
        let s2 = air_get_src2(air_buf, i);
        let res_id = air_get_res_id(air_buf, i);

        if op == AIR_OP_CONST {
            # Lower to UIR_CONST (1)
            uir_emit(uir_buf, UIR_CONST, SIR_TYPE_I64, 0, 0, dst, s1, 0, 0);
            uir_emitted = uir_emitted + 1;
        } else if (op == AIR_OP_MOVE) | (op == AIR_OP_BORROW) {
            # Lower to UIR_MOVE (2)
            uir_emit(uir_buf, UIR_MOVE, SIR_TYPE_I64, 0, 0, dst, s1, 0, 0);
            uir_emitted = uir_emitted + 1;
        } else if op == AIR_OP_CALL {
            # Lower to UIR_CALL (56)
            uir_emit(uir_buf, UIR_CALL, SIR_TYPE_I64, 0, 0, dst, s1, s2, 0);
            uir_emitted = uir_emitted + 1;
        } else if op == AIR_OP_STACK_PROMOTE {
            # Lower to UIR_ALLOC_STACK (40) - zero runtime heap call!
            uir_emit(uir_buf, UIR_ALLOC_STACK, SIR_TYPE_PTR, 0, 0, dst, 64, 0, 0);
            uir_emitted = uir_emitted + 1;
        } else if op == AIR_OP_ADD {
            # Lower to UIR_ADD (10)
            uir_emit(uir_buf, UIR_ADD, SIR_TYPE_I64, 0, 0, dst, s1, s2, 0);
            uir_emitted = uir_emitted + 1;
        } else if op == AIR_OP_SUB {
            # Lower to UIR_SUB (11)
            uir_emit(uir_buf, UIR_SUB, SIR_TYPE_I64, 0, 0, dst, s1, s2, 0);
            uir_emitted = uir_emitted + 1;
        } else if op == AIR_OP_MUL {
            # Lower to UIR_MUL (12)
            uir_emit(uir_buf, UIR_MUL, SIR_TYPE_I64, 0, 0, dst, s1, s2, 0);
            uir_emitted = uir_emitted + 1;
        } else if op == AIR_OP_RETURN {
            # Lower to UIR_RETURN (57)
            uir_emit(uir_buf, UIR_RETURN, SIR_TYPE_I64, 0, 0, 0, s1, 0, 0);
            uir_emitted = uir_emitted + 1;
        }
        # AIR_OP_DROP on stack/region is an automatic no-op (free at return)
        i = i + 1;
    }

    return uir_emitted;
}
