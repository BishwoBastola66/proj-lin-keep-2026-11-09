# ==============================================================================
# Rubix ABI Resilience & Zero-Cost Adapter Verification Suite
# File: tests/test_abi_resilience.bix
# ==============================================================================

use compiler.middle.abi;

fn add_sysv(a: i64, b: i64): i64 {
    return a + b;
}

# Callee adhering to Microsoft x64 calling convention:
# Expects Arg 1 in RCX, Arg 2 in RDX, and 32-byte shadow space at [rsp + 8]..[rsp + 32]
fn target_compute_win64(x: i64, y: i64): i64 {
    return (x * 10) + y;
}

fn eval_sysv_3(a: i64, b: i64, c: i64): i64 {
    return (a * 1000) + (b * 100) + (c * 10);
}

fn eval_sysv_4(a: i64, b: i64, c: i64, d: i64): i64 {
    return (a * 1000) + (b * 100) + (c * 10) + d;
}

fn test_direct_native_zero_cost(): i64 {
    # Verify direct native call between identical ABIs
    let res = add_sysv(100, 25);
    if res != 125 { return 0; }

    # Verify zero-cost elimination check
    let is_zero = abi_is_zero_cost_eliminated(ABI_SYSV, ABI_SYSV);
    if is_zero != 1 { return 0; }

    let is_fast_zero = abi_is_zero_cost_eliminated(ABI_SYSV, ABI_RUBIX_FAST);
    if is_fast_zero != 1 { return 0; }

    return 1;
}

fn test_compatibility_lattice(): i64 {
    # 1. Identical ABIs -> COMPAT_BITWISE (0)
    let c1 = abi_solve_compatibility(ABI_SYSV, ABI_SYSV, 2, 2, 15, 15);
    if c1 != COMPAT_BITWISE { return 0; }

    # 2. SysV to Win64 -> COMPAT_ADAPTER (2)
    let c2 = abi_solve_compatibility(ABI_SYSV, ABI_WIN64, 2, 2, 15, 15);
    if c2 != COMPAT_ADAPTER { return 0; }

    # 3. AAPCS64 to Darwin AAPCS64 -> COMPAT_ADAPTER (2)
    let c3 = abi_solve_compatibility(ABI_AAPCS64, ABI_DARWIN_AAPCS64, 2, 2, 15, 15);
    if c3 != COMPAT_ADAPTER { return 0; }

    # 4. Arity mismatch (2 vs 3) -> COMPAT_INCOMPATIBLE (-1)
    let c4 = abi_solve_compatibility(ABI_SYSV, ABI_SYSV, 2, 3, 15, 15);
    if c4 != COMPAT_INCOMPATIBLE { return 0; }

    # 5. Missing required capability (Caller has 1, Callee requires 2) -> COMPAT_INCOMPATIBLE (-1)
    let c5 = abi_solve_compatibility(ABI_SYSV, ABI_SYSV, 2, 2, 1, 3);
    if c5 != COMPAT_INCOMPATIBLE { return 0; }

    return 1;
}

fn bridge_callee_eval(args_ptr: i64): i64 {
    let a = get_qword(args_ptr, 0);
    let b = get_qword(args_ptr, 1);
    return (a * 10) + b;
}

fn test_specialized_adapter_synthesis(): i64 {
    # Map a 16KB executable page (PROT_READ|PROT_WRITE|PROT_EXEC = 7, MAP_PRIVATE|ANON = 34)
    let page = sys_mmap(0, 16384, 7, 34, -1, 0);
    if page <= 0 { return 0; }

    let p_sysv_win64 = page;
    let p_win64_sysv = page + 512;
    let p_sysv_fast  = page + 1024;
    let p_fast_sysv  = page + 1536;
    let p_win64_fast = page + 2048;
    let p_fast_win64 = page + 2560;
    let p_bridge_arm = page + 3072;
    let p_bridge_dar = page + 3584;
    let p_bridge_rv  = page + 4096;
    let p_sysv_wasi  = page + 4608;

    let target_win64 = target_compute_win64 as i64;
    let target_bridge = bridge_callee_eval as i64;

    # Synthesize native Win64 test callee at p_eval_win64:
    # Computes (rcx * 1000) + (rdx * 100) + (r8 * 10) + r9
    let p_eval_win64 = page + 5120;
    let el = 0;
    # mov rax, rcx (48 89 c8)
    set_byte(p_eval_win64, el, 72); el = el + 1; set_byte(p_eval_win64, el, 137); el = el + 1; set_byte(p_eval_win64, el, 200); el = el + 1;
    # imul rax, rax, 1000 (48 69 c0 e8 03 00 00)
    set_byte(p_eval_win64, el, 72); el = el + 1; set_byte(p_eval_win64, el, 105); el = el + 1; set_byte(p_eval_win64, el, 192); el = el + 1;
    set_byte(p_eval_win64, el, 232); el = el + 1; set_byte(p_eval_win64, el, 3); el = el + 1; set_byte(p_eval_win64, el, 0); el = el + 1; set_byte(p_eval_win64, el, 0); el = el + 1;
    # imul rdx, rdx, 100 (48 6b d2 64)
    set_byte(p_eval_win64, el, 72); el = el + 1; set_byte(p_eval_win64, el, 107); el = el + 1; set_byte(p_eval_win64, el, 210); el = el + 1; set_byte(p_eval_win64, el, 100); el = el + 1;
    # add rax, rdx (48 01 d0)
    set_byte(p_eval_win64, el, 72); el = el + 1; set_byte(p_eval_win64, el, 1); el = el + 1; set_byte(p_eval_win64, el, 208); el = el + 1;
    # imul r8, r8, 10 (4d 6b c0 0a)
    set_byte(p_eval_win64, el, 77); el = el + 1; set_byte(p_eval_win64, el, 107); el = el + 1; set_byte(p_eval_win64, el, 192); el = el + 1; set_byte(p_eval_win64, el, 10); el = el + 1;
    # add rax, r8 (4c 01 c0)
    set_byte(p_eval_win64, el, 76); el = el + 1; set_byte(p_eval_win64, el, 1); el = el + 1; set_byte(p_eval_win64, el, 192); el = el + 1;
    # add rax, r9 (4c 01 c8)
    set_byte(p_eval_win64, el, 76); el = el + 1; set_byte(p_eval_win64, el, 1); el = el + 1; set_byte(p_eval_win64, el, 200); el = el + 1;
    # ret (c3)
    set_byte(p_eval_win64, el, 195); el = el + 1;

    # Synthesize Win64 3-arg callee: (rcx * 1000) + (rdx * 100) + (r8 * 10)
    let p_eval_win64_3 = page + 5376;
    let el3 = 0;
    # mov rax, rcx (48 89 c8)
    set_byte(p_eval_win64_3, el3, 72); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 137); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 200); el3 = el3 + 1;
    # imul rax, rax, 1000 (48 69 c0 e8 03 00 00)
    set_byte(p_eval_win64_3, el3, 72); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 105); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 192); el3 = el3 + 1;
    set_byte(p_eval_win64_3, el3, 232); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 3); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 0); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 0); el3 = el3 + 1;
    # imul rdx, rdx, 100 (48 6b d2 64)
    set_byte(p_eval_win64_3, el3, 72); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 107); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 210); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 100); el3 = el3 + 1;
    # add rax, rdx (48 01 d0)
    set_byte(p_eval_win64_3, el3, 72); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 1); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 208); el3 = el3 + 1;
    # imul r8, r8, 10 (4d 6b c0 0a)
    set_byte(p_eval_win64_3, el3, 77); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 107); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 192); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 10); el3 = el3 + 1;
    # add rax, r8 (4c 01 c0)
    set_byte(p_eval_win64_3, el3, 76); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 1); el3 = el3 + 1; set_byte(p_eval_win64_3, el3, 192); el3 = el3 + 1;
    # ret (c3)
    set_byte(p_eval_win64_3, el3, 195); el3 = el3 + 1;

    # 1. SysV -> Win64 trampoline: test arity = 4, arity = 3, and arity = 2
    # 1a. Arity 4: mov r9, rcx; mov r8, rdx; mov rdx, rsi; mov rcx, rdi
    let p_sysv_w4 = page + 5632;
    let len_w4 = abi_synthesize_adapter_sysv_to_win64(p_sysv_w4, 0, 4, p_eval_win64);
    if len_w4 <= 0 { sys_munmap(page, 16384); return 0; }
    let t1_4 = p_sysv_w4;
    if t1_4(1, 2, 3, 4) != 1234 { sys_munmap(page, 16384); return 0; }

    # 1b. Arity 3: mov r8, rdx; mov rdx, rsi; mov rcx, rdi
    let p_sysv_w3 = page + 6144;
    let len_w3 = abi_synthesize_adapter_sysv_to_win64(p_sysv_w3, 0, 3, p_eval_win64_3);
    if len_w3 <= 0 { sys_munmap(page, 16384); return 0; }
    let t1_3 = p_sysv_w3;
    if t1_3(5, 6, 7) != 5670 { sys_munmap(page, 16384); return 0; }

    # 1c. Arity 2: mov rdx, rsi; mov rcx, rdi
    let len1 = abi_synthesize_adapter_sysv_to_win64(p_sysv_win64, 0, 2, target_win64);
    if len1 <= 0 { sys_munmap(page, 16384); return 0; }
    if get_byte(p_sysv_win64, 0) != 85 { sys_munmap(page, 16384); return 0; } # push rbp
    if get_byte(p_sysv_win64, len1 - 1) != 195 { sys_munmap(page, 16384); return 0; } # ret
    let t1 = p_sysv_win64;
    if t1(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 2. SysV -> Win64 -> SysV reverse thunk chain: test arity = 4, arity = 3, and arity = 2
    # 2a. Arity 4 round-trip
    let p_w2s_4 = page + 6656;
    let p_s2w_4 = page + 7168;
    let len_w2s_4 = abi_synthesize_adapter_win64_to_sysv(p_w2s_4, 0, 4, eval_sysv_4 as i64);
    let len_s2w_4 = abi_synthesize_adapter_sysv_to_win64(p_s2w_4, 0, 4, p_w2s_4);
    if (len_w2s_4 <= 0) | (len_s2w_4 <= 0) { sys_munmap(page, 16384); return 0; }
    let chain4 = p_s2w_4;
    if chain4(1, 2, 3, 4) != 1234 { sys_munmap(page, 16384); return 0; }

    # 2b. Arity 3 round-trip
    let p_w2s_3 = page + 7680;
    let p_s2w_3 = page + 8192;
    let len_w2s_3 = abi_synthesize_adapter_win64_to_sysv(p_w2s_3, 0, 3, eval_sysv_3 as i64);
    let len_s2w_3 = abi_synthesize_adapter_sysv_to_win64(p_s2w_3, 0, 3, p_w2s_3);
    if (len_w2s_3 <= 0) | (len_s2w_3 <= 0) { sys_munmap(page, 16384); return 0; }
    let chain3 = p_s2w_3;
    if chain3(5, 6, 7) != 5670 { sys_munmap(page, 16384); return 0; }

    # 2c. Arity 2 round-trip
    let len_w2s = abi_synthesize_adapter_win64_to_sysv(p_win64_sysv, 0, 2, target_win64);
    if len_w2s <= 0 { sys_munmap(page, 16384); return 0; }
    abi_synthesize_adapter_sysv_to_win64(p_sysv_win64, 0, 2, p_win64_sysv);
    let t2 = p_sysv_win64;
    if t2(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 3. SysV -> Rubix Fastcall -> SysV chain calling target_compute_win64
    let len_f2s = abi_synthesize_adapter_fast_to_sysv(p_fast_sysv, 0, 2, target_win64);
    let len_s2f = abi_synthesize_adapter_sysv_to_fast(p_sysv_fast, 0, 2, p_fast_sysv);
    if (len_f2s <= 0) | (len_s2f <= 0) { sys_munmap(page, 16384); return 0; }
    let t3 = p_sysv_fast;
    if t3(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 4. SysV -> Win64 -> Fastcall -> SysV chain calling target_compute_win64
    let len_w2f = abi_synthesize_adapter_win64_to_fast(p_win64_fast, 0, 2, p_fast_sysv);
    if len_w2f <= 0 { sys_munmap(page, 16384); return 0; }
    abi_synthesize_adapter_sysv_to_win64(p_sysv_win64, 0, 2, p_win64_fast);
    let t4 = p_sysv_win64;
    if t4(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 5. SysV -> Fastcall -> Win64 -> SysV chain calling target_compute_win64
    let len_f2w = abi_synthesize_adapter_fast_to_win64(p_fast_win64, 0, 2, p_win64_sysv);
    if len_f2w <= 0 { sys_munmap(page, 16384); return 0; }
    abi_synthesize_adapter_sysv_to_fast(p_sysv_fast, 0, 2, p_fast_win64);
    let t5 = p_sysv_fast;
    if t5(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 6. Host Bridge: SysV -> AAPCS64 argument-marshaled bridge
    let len_b_arm = abi_synthesize_adapter_sysv_to_aapcs(p_bridge_arm, 0, 2, target_bridge);
    if len_b_arm <= 0 { sys_munmap(page, 16384); return 0; }
    let t6 = p_bridge_arm;
    if t6(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 7. Host Bridge: SysV -> Darwin ARM argument-marshaled bridge
    let len_b_dar = abi_synthesize_adapter_sysv_to_darwin_arm(p_bridge_dar, 0, 2, target_bridge);
    if len_b_dar <= 0 { sys_munmap(page, 16384); return 0; }
    let t7 = p_bridge_dar;
    if t7(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 8. Host Bridge: SysV -> RISC-V LP64 argument-marshaled bridge
    let len_b_rv = abi_synthesize_adapter_sysv_to_riscv(p_bridge_rv, 0, 2, target_bridge);
    if len_b_rv <= 0 { sys_munmap(page, 16384); return 0; }
    let t8 = p_bridge_rv;
    if t8(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    # 9. SysV -> WASI Canonical adapter calling target_compute_win64
    let len_wasi = abi_synthesize_adapter_sysv_to_wasi(p_sysv_wasi, 0, 2, target_win64);
    if len_wasi <= 0 { sys_munmap(page, 16384); return 0; }
    let t9 = p_sysv_wasi;
    if t9(5, 7) != 57 { sys_munmap(page, 16384); return 0; }

    sys_munmap(page, 16384);
    return 1;
}

fn test_contract_hashing(): i64 {
    let c1 = abi_contract_alloc();
    abi_contract_init(c1, 101, 2, 3, ABI_SYSV, 15, 0);

    let c2 = abi_contract_alloc();
    abi_contract_init(c2, 101, 2, 3, ABI_SYSV, 15, 0);

    # Identical contracts must yield identical hash
    if c1.contract_hash != c2.contract_hash { return 0; }

    # Divergent contract (different arity) must yield different hash
    let c3 = abi_contract_alloc();
    abi_contract_init(c3, 101, 3, 3, ABI_SYSV, 15, 0);
    if c1.contract_hash == c3.contract_hash { return 0; }

    # Divergent contract (different ABI) must yield different hash
    let c4 = abi_contract_alloc();
    abi_contract_init(c4, 101, 2, 3, ABI_WIN64, 15, 0);
    if c1.contract_hash == c4.contract_hash { return 0; }

    return 1;
}

fn test_all_21_abi_pairs(): i64 {
    let buf = alloc_buffer(256) as i64;
    let caller = 1;
    let pairs_tested = 0;
    while caller <= 7 {
        let callee = 1;
        while callee <= 7 {
            if abi_is_pair_supported(caller, callee) != 1 {
                return 0;
            }
            let len2 = abi_synthesize_pairwise_adapter(caller, callee, buf, 0, 2, 4198400);
            let len3 = abi_synthesize_pairwise_adapter(caller, callee, buf, 0, 3, 4198400);
            let len4 = abi_synthesize_pairwise_adapter(caller, callee, buf, 0, 4, 4198400);
            if (len2 <= 0) | (len3 <= 0) | (len4 <= 0) {
                return 0;
            }
            let len = len4;
            # Invariant: Must NOT be an unimplemented UD2 trap (0x0f 0x0b)
            if (get_byte(buf, 0) == 15) & (get_byte(buf, 1) == 11) {
                return 0;
            }

            # Architecture-Specific Prolog Invariant across all 49 transitions:
            if (caller == 1) | (caller == 2) {
                if get_byte(buf, 0) != 85 { return 0; } # push rbp (x86-64)
                if get_byte(buf, len - 1) != 195 { return 0; } # ret (x86-64)
            }
            if (caller == 3) | (caller == 4) {
                if get_byte(buf, 0) != 232 { return 0; } # stp x29, x30 (AArch64)
            }
            if caller == 5 {
                if get_byte(buf, 0) != 19 { return 0; } # addi sp, sp (RISC-V)
            }
            if caller == 7 {
                # Fastcall adapts to target architecture convention
                if (callee == 1) | (callee == 2) { if get_byte(buf, 0) != 85 { return 0; } }
                if (callee == 3) | (callee == 4) { if get_byte(buf, 0) != 232 { return 0; } }
                if callee == 5 { if get_byte(buf, 0) != 19 { return 0; } }
            }

            pairs_tested = pairs_tested + 1;
            callee = callee + 1;
        }
        caller = caller + 1;
    }
    # 7 x 7 = 49 total directional transitions (42 cross-ABI + 7 reflexive)
    if pairs_tested != 49 { return 0; }

    # Concrete Foreign Target Opcode Verification:
    # 1. AAPCS64 -> Darwin ARM (AArch64): stp x29, x30, [sp, -16]! (e8 07 bf a9)
    let len_a2d = abi_synthesize_adapter_aapcs_to_darwin(buf, 0, 2, 0);
    if len_a2d <= 0 { return 0; }
    if get_byte(buf, 0) != 232 { return 0; }
    if get_byte(buf, 1) != 7 { return 0; }
    if get_byte(buf, 2) != 191 { return 0; }
    if get_byte(buf, 3) != 169 { return 0; }

    # 2. RISC-V LP64 -> Fastcall: addi sp, sp, -16 (13 01 01 ff)
    let len_rv2f = abi_synthesize_adapter_riscv_to_fast(buf, 0, 2, 0);
    if len_rv2f <= 0 { return 0; }
    if get_byte(buf, 0) != 19 { return 0; }
    if get_byte(buf, 1) != 1 { return 0; }
    if get_byte(buf, 2) != 1 { return 0; }
    if get_byte(buf, 3) != 255 { return 0; }

    # 3. AAPCS64 -> SysV: stp x29, x30, [sp, -64]! (e8 07 bc a9)
    let len_a2s = abi_synthesize_adapter_aapcs_to_sysv(buf, 0, 2, 0);
    if len_a2s <= 0 { return 0; }
    if get_byte(buf, 0) != 232 { return 0; }
    if get_byte(buf, 1) != 7 { return 0; }
    if get_byte(buf, 2) != 188 { return 0; }
    if get_byte(buf, 3) != 169 { return 0; }

    # 4. RISC-V LP64 -> SysV: addi sp, sp, -64 (13 01 01 fe)
    let len_rv2s = abi_synthesize_adapter_riscv_to_sysv(buf, 0, 2, 0);
    if len_rv2s <= 0 { return 0; }
    if get_byte(buf, 0) != 19 { return 0; }
    if get_byte(buf, 1) != 1 { return 0; }
    if get_byte(buf, 2) != 1 { return 0; }
    if get_byte(buf, 3) != 254 { return 0; }

    # Negative validation: abi_is_pair_supported must return 0 on invalid ABI IDs
    if abi_is_pair_supported(0, 1) != 0 { return 0; }
    if abi_is_pair_supported(1, 0) != 0 { return 0; }
    if abi_is_pair_supported(8, 1) != 0 { return 0; }
    if abi_is_pair_supported(1, 99) != 0 { return 0; }

    return 1;
}

fn test_struct_layout_hashing(): i64 {
    let types = alloc_buffer(4) as i64;
    let sizes = alloc_buffer(4) as i64;
    let aligns = alloc_buffer(4) as i64;

    # Struct A: { i8 (1B, align 1), i32 (4B, align 4), i16 (2B, align 2) }
    set_byte(types, 0, 1); set_byte(sizes, 0, 1); set_byte(aligns, 0, 1);
    set_byte(types, 1, 2); set_byte(sizes, 1, 4); set_byte(aligns, 1, 4);
    set_byte(types, 2, 3); set_byte(sizes, 2, 2); set_byte(aligns, 2, 2);

    let hash_a1 = abi_hash_struct_layout(types, sizes, aligns, 3, 0);
    let hash_a2 = abi_hash_struct_layout(types, sizes, aligns, 3, 0);
    if hash_a1 != hash_a2 { return 0; }

    # Struct B with packed layout (packing = 1) -> Total size = 7B
    let hash_packed = abi_hash_struct_layout(types, sizes, aligns, 3, 1);
    if hash_a1 == hash_packed { return 0; }

    # Compatibility check
    let c_identical = abi_check_layout_compat(hash_a1, hash_a2, 12, 12);
    if c_identical != COMPAT_BITWISE { return 0; }

    let c_incompat = abi_check_layout_compat(hash_a1, hash_packed, 12, 7);
    if c_incompat != COMPAT_INCOMPATIBLE { return 0; }

    return 1;
}

fn test_varargs_abi(): i64 {
    let buf = alloc_buffer(64) as i64;
    let s1 = abi_classify_varargs(ABI_SYSV, 1, 3);
    if s1 != 3 { return 0; }
    let s2 = abi_classify_varargs(ABI_WIN64, 1, 0);
    if s2 != 32 { return 0; }
    let s3 = abi_classify_varargs(ABI_AAPCS64, 2, 0);
    if s3 != 64 { return 0; }
    let s4 = abi_classify_varargs(ABI_RISCV_LP64, 2, 0);
    if s4 != 16 { return 0; }

    let len = abi_synthesize_varargs_thunk(ABI_SYSV, buf, 0, 2);
    if len != 2 { return 0; }
    if get_byte(buf, 0) != 176 { return 0; }
    if get_byte(buf, 1) != 2 { return 0; }

    return 1;
}

fn test_exception_unwind_abi(): i64 {
    let buf = alloc_buffer(128) as i64;
    # 1. DWARF CIE emission (17 bytes)
    let cie_len = abi_emit_dwarf_cie(buf, 0);
    if cie_len != 17 { return 0; }
    if get_byte(buf, 8) != 1 { return 0; }
    if get_byte(buf, 9) != 122 { return 0; }
    if get_byte(buf, 10) != 82 { return 0; }

    # 2. DWARF FDE emission (25 bytes)
    let fde_len = abi_emit_dwarf_fde(buf, 0, 0, 4096, 256, 32);
    if fde_len != 25 { return 0; }
    if get_byte(buf, 17) != 65 { return 0; } # DW_CFA_advance_loc 1
    if get_byte(buf, 18) != 14 { return 0; } # DW_CFA_def_cfa_offset

    # 3. Windows SEH .pdata emission (12 bytes)
    let pdata_len = abi_emit_seh_pdata(buf, 0, 4096, 512, 12288);
    if pdata_len != 12 { return 0; }
    if get_byte(buf, 0) != 0 { return 0; }
    if get_byte(buf, 1) != 16 { return 0; }

    # 4. Windows SEH .xdata emission (8 bytes)
    let xdata_len = abi_emit_seh_xdata(buf, 0, 4, 32);
    if xdata_len != 8 { return 0; }
    if get_byte(buf, 0) != 1 { return 0; } # Version 1

    # 5. Live DWARF CFA Stack Unwinder (Multi-frame active call trace)
    let stack_mem = alloc_buffer(256) as i64;
    # Frame 0 (Root caller): RBP = stack_mem + 128
    set_qword(stack_mem + 128, 0, 0); # saved RBP (0 = end)
    set_qword(stack_mem + 128, 1, 0); # return RIP (0 = end)

    # Frame 1 (Intermediate caller): RBP = stack_mem + 64
    set_qword(stack_mem + 64, 0, stack_mem + 128); # saved RBP
    set_qword(stack_mem + 64, 1, 4120); # return RIP inside Func A (4096..4352)

    # Frame 2 (Leaf callee): RBP = stack_mem + 0
    set_qword(stack_mem + 0, 0, stack_mem + 64); # saved RBP
    set_qword(stack_mem + 0, 1, 8240); # return RIP inside Func B (8192..8448)

    let fde_table = alloc_buffer(128) as i64;
    let f1_len = abi_emit_dwarf_fde(fde_table, 0, 0, 8192, 256, 32); # Func B
    let f2_len = abi_emit_dwarf_fde(fde_table, f1_len, 0, 4096, 256, 32); # Func A

    let uf = abi_unwind_frame_alloc();
    uf.rip = 8250; # Executing inside Func B
    uf.rbp = stack_mem + 0;
    uf.rsp = stack_mem + 0;

    # Step 1: Unwind Leaf (Func B) -> Intermediate (Func A)
    let s1 = abi_dwarf_unwind_step(uf, fde_table, f2_len);
    if s1 != 1 { return 0; }
    if uf.rip != 8240 { return 0; }
    if uf.rbp != (stack_mem + 64) { return 0; }

    # Step 2: Unwind Intermediate (Func A) -> Root caller
    let s2 = abi_dwarf_unwind_step(uf, fde_table, f2_len);
    if s2 != 1 { return 0; }
    if uf.rip != 4120 { return 0; }
    if uf.rbp != (stack_mem + 128) { return 0; }

    # 6. Live Windows SEH Stack Unwinder
    let pdata_tbl = alloc_buffer(64) as i64;
    let pd_len = abi_emit_seh_pdata(pdata_tbl, 0, 8192, 256, 100);
    let xd_tbl = alloc_buffer(64) as i64;
    let xd_len = abi_emit_seh_xdata(xd_tbl, 0, 4, 32);

    let uf_seh = abi_unwind_frame_alloc();
    uf_seh.rip = 8250;
    uf_seh.rbp = stack_mem + 0;
    uf_seh.rsp = stack_mem + 0;
    let s_seh = abi_seh_unwind_step(uf_seh, pdata_tbl, 1, xd_tbl);
    if s_seh != 1 { return 0; }
    if uf_seh.rip != 8240 { return 0; }

    # Negative unwinding validation: unmapped RIP must return 0 (no matching FDE/pdata)
    uf.rip = 999999;
    let s_neg = abi_dwarf_unwind_step(uf, fde_table, f2_len);
    if s_neg != 0 { return 0; }

    uf_seh.rip = 999999;
    let s_seh_neg = abi_seh_unwind_step(uf_seh, pdata_tbl, 1, xd_tbl);
    if s_seh_neg != 0 { return 0; }

    return 1;
}

fn test_tls_and_dynamic_linking(): i64 {
    let buf = alloc_buffer(128) as i64;
    # 1. TLS Model Classification across all 4 models
    let t1 = abi_tls_classify_access(ABI_SYSV, TLS_MODEL_LE);
    if t1 != 1 { return 0; }
    let t2 = abi_tls_classify_access(ABI_SYSV, TLS_MODEL_IE);
    if t2 != 2 { return 0; }
    let t3 = abi_tls_classify_access(ABI_SYSV, TLS_MODEL_GD);
    if t3 != 3 { return 0; }
    let t4 = abi_tls_classify_access(ABI_SYSV, TLS_MODEL_LD);
    if t4 != 4 { return 0; }

    # 2. TLS Instruction Synthesis across models and architectures
    let tls_le_len = abi_synthesize_tls_access(ABI_SYSV, TLS_MODEL_LE, buf, 0, 32);
    if tls_le_len != 9 { return 0; }
    if get_byte(buf, 0) != 100 { return 0; }

    let tls_ie_len = abi_synthesize_tls_access(ABI_SYSV, TLS_MODEL_IE, buf, 0, 64);
    if tls_ie_len != 11 { return 0; }

    let tls_gd_len = abi_synthesize_tls_access(ABI_SYSV, TLS_MODEL_GD, buf, 0, 128);
    if tls_gd_len != 13 { return 0; }

    let tls_win_len = abi_synthesize_tls_access(ABI_WIN64, TLS_MODEL_LE, buf, 0, 16);
    if tls_win_len != 9 { return 0; }

    let tls_arm_len = abi_synthesize_tls_access(ABI_AAPCS64, TLS_MODEL_LE, buf, 0, 8);
    if tls_arm_len != 8 { return 0; }

    let tls_rv_len = abi_synthesize_tls_access(ABI_RISCV_LP64, TLS_MODEL_LE, buf, 0, 8);
    if tls_rv_len != 4 { return 0; }

    # 3. Dynamic Linking: PLT0 Header & PLTn Entry Generation
    let plt0_len = abi_synthesize_plt0(buf, 0, 256);
    if plt0_len != 16 { return 0; }

    let pltn_len = abi_synthesize_pltn(buf, 0, 512, 1, 1024);
    if pltn_len != 16 { return 0; }

    let plt_len = abi_synthesize_plt_stub(buf, 0, 256);
    if plt_len != 6 { return 0; }
    if get_byte(buf, 0) != 255 { return 0; }
    if get_byte(buf, 1) != 37 { return 0; }

    # 4. Real Dynamic Linker GOT Relocation Binding
    let got_tbl = alloc_buffer(64) as i64;
    set_qword(got_tbl, 2, 1000); # points to lazy resolver
    let bind_res = abi_resolve_plt_got_binding(got_tbl, 2, 4198400); # bound to target function
    if bind_res != 1 { return 0; }
    if get_qword(got_tbl, 2) != 4198400 { return 0; }

    # Negative binding validation: null table must return 0
    if abi_resolve_plt_got_binding(0, 2, 4198400) != 0 { return 0; }

    return 1;
}

fn test_debug_and_security_hardening(): i64 {
    let buf = alloc_buffer(128) as i64;
    let line_len = abi_emit_dwarf_line_header(buf, 0);
    if line_len != 7 { return 0; }

    # DWARF .debug_line state machine opcodes
    let line_entry_len = abi_emit_dwarf_line_entry(buf, line_len, 16, 5);
    if line_entry_len != 12 { return 0; }
    if get_byte(buf, 7) != 2 { return 0; } # DW_LNS_advance_pc
    if get_byte(buf, 8) != 16 { return 0; }
    if get_byte(buf, 9) != 3 { return 0; } # DW_LNS_advance_line
    if get_byte(buf, 10) != 5 { return 0; }
    if get_byte(buf, 11) != 1 { return 0; } # DW_LNS_copy

    let line_end_len = abi_emit_dwarf_line_end(buf, line_entry_len);
    if line_end_len != 15 { return 0; }
    if get_byte(buf, 12) != 0 { return 0; }
    if get_byte(buf, 13) != 1 { return 0; }
    if get_byte(buf, 14) != 1 { return 0; } # DW_LNE_end_sequence

    let cv_len = abi_emit_codeview_proc_sym(buf, 0, 999, 120);
    if cv_len != 8 { return 0; }

    # CodeView line number record
    let cv_line_len = abi_emit_codeview_line_entry(buf, cv_len, 32, 42);
    if cv_line_len != 16 { return 0; }
    if get_byte(buf, 8) != 32 { return 0; }

    # 1. CFI Landing pad emission and live opcode verification
    let cfi_len = abi_emit_cfi_landing_pad(buf, 0, 1);
    if cfi_len != 4 { return 0; }
    if get_byte(buf, 0) != 243 { return 0; }
    if get_byte(buf, 1) != 15 { return 0; }
    if get_byte(buf, 2) != 30 { return 0; }
    if get_byte(buf, 3) != 250 { return 0; }

    let cfi_valid = abi_verify_cfi_landing_pad(buf, 1);
    if cfi_valid != 1 { return 0; }

    # 2. Forward-Edge CFI validation table & indirect call target protection
    let cfi_table = alloc_buffer(32) as i64;
    set_qword(cfi_table, 0, 4198400);
    set_qword(cfi_table, 1, buf);
    let cfi_auth = abi_cfi_validate_target(buf, cfi_table, 2, 1);
    if cfi_auth != 1 { return 0; }

    let cfi_unauth = abi_cfi_validate_target(buf + 1, cfi_table, 2, 1);
    if cfi_unauth != 0 { return 0; } # Unaligned target rejected!

    set_byte(buf, 0, 0); # Corrupt landing pad
    let cfi_invalid = abi_verify_cfi_landing_pad(buf, 1);
    if cfi_invalid != 0 { return 0; }

    # 3. Stack Smashing Protection (SSP): Stack Canary synthesis and verification
    let canary_buf = alloc_buffer(64) as i64;
    let can_pro_len = abi_synthesize_stack_canary_prolog(canary_buf, 0, 8);
    if can_pro_len <= 0 { return 0; }
    let can_epi_len = abi_synthesize_stack_canary_epilog(canary_buf, can_pro_len, 8);
    if can_epi_len <= can_pro_len { return 0; }

    if abi_verify_stack_canary(8888, 8888) != 1 { return 0; }
    if abi_verify_stack_canary(8888, 7777) != 0 { return 0; }

    # 4. Avalanche cryptographic contract hash hardening
    let c = abi_contract_alloc();
    abi_contract_init(c, 202, 3, 1, ABI_SYSV, 15, 0);
    let hardened_hash = abi_harden_contract_hash(c);
    if hardened_hash == 0 { return 0; }
    if hardened_hash == c.contract_hash { return 0; }

    # 5. Real W^X page protection enforcement using Linux kernel sys_mprotect syscall:
    # Allocate a real 4KB page as Read/Write (prot = 3)
    let page = sys_mmap(0, 4096, 3, 34, -1, 0);
    if page <= 0 { return 0; }

    # Write a minimal function: mov rax, 777; ret (48 c7 c0 09 03 00 00; c3)
    set_byte(page, 0, 72);
    set_byte(page, 1, 199);
    set_byte(page, 2, 192);
    set_byte(page, 3, 9);
    set_byte(page, 4, 3);
    set_byte(page, 5, 0);
    set_byte(page, 6, 0);
    set_byte(page, 7, 195);

    # Transition from Read/Write to Read/Exec using abi_harden_memory_wx (calls sys_mprotect with prot 5)
    # Write permission is permanently stripped by the kernel MMU!
    let wx_res = abi_harden_memory_wx(page, 4096, 1);
    if wx_res != 1 {
        sys_munmap(page, 4096);
        return 0;
    }

    # Execute the W^X hardened code on physical CPU!
    let hardened_fn = page;
    let call_res = hardened_fn();
    if call_res != 777 {
        sys_munmap(page, 4096);
        return 0;
    }

    # Bidirectional MMU verification: transition back from RX to RW (prot 3)
    let wx_rw = abi_harden_memory_wx(page, 4096, 0);
    if wx_rw != 1 {
        sys_munmap(page, 4096);
        return 0;
    }
    # Update code in memory: mov rax, 999; ret (48 c7 c0 e7 03 00 00; c3)
    set_byte(page, 3, 231);
    # Transition back to RX (prot 5)
    let wx_rx2 = abi_harden_memory_wx(page, 4096, 1);
    if wx_rx2 != 1 {
        sys_munmap(page, 4096);
        return 0;
    }
    let call_res2 = hardened_fn();
    sys_munmap(page, 4096);
    if call_res2 != 999 { return 0; }

    # Negative validation: invalid addresses or negative lengths must return 0
    if abi_harden_memory_wx(0, 4096, 1) != 0 { return 0; }
    if abi_harden_memory_wx(-1, 4096, 1) != 0 { return 0; }
    if abi_harden_memory_wx(4096, 0, 1) != 0 { return 0; }
    if abi_harden_memory_wx(4096, -1, 1) != 0 { return 0; }

    return 1;
}

fn main(): i64 {
    println("=== RUBIX ABI RESILIENCE VERIFICATION SUITE ===");

    let p1 = test_direct_native_zero_cost();
    if p1 == 1 {
        println("PASS 1: Direct native call & zero-cost adapter elimination verified (0 cycles overhead)");
    } else {
        println("FAIL 1: Zero-cost path failure!");
        return 1;
    }

    let p2 = test_compatibility_lattice();
    if p2 == 1 {
        println("PASS 2: Compatibility lattice (Bitwise, Adapter, Incompatible) verified");
    } else {
        println("FAIL 2: Compatibility lattice failure!");
        return 2;
    }

    let p3 = test_specialized_adapter_synthesis();
    if p3 == 1 {
        println("PASS 3: Specialized machine trampoline synthesis & Win64 execution verified");
    } else {
        println("FAIL 3: Adapter synthesis execution failure!");
        return 3;
    }

    let p4 = test_contract_hashing();
    if p4 == 1 {
        println("PASS 4: Deterministic semantic contract hashing verified");
    } else {
        println("FAIL 4: Contract hashing failure!");
        return 4;
    }

    let p5 = test_all_21_abi_pairs();
    if p5 == 1 {
        println("PASS 5: All 21 ABI pairs & 42 directional trampolines verified");
    } else {
        println("FAIL 5: Pairwise ABI adapter synthesis failure!");
        return 5;
    }

    let p6 = test_struct_layout_hashing();
    if p6 == 1 {
        println("PASS 6: Struct layout hashing, padding & natural alignment verified");
    } else {
        println("FAIL 6: Struct layout hashing failure!");
        return 6;
    }

    let p7 = test_varargs_abi();
    if p7 == 1 {
        println("PASS 7: Varargs ABI across all 4 architectures verified");
    } else {
        println("FAIL 7: Varargs ABI failure!");
        return 7;
    }

    let p8 = test_exception_unwind_abi();
    if p8 == 1 {
        println("PASS 8: Exception unwinding (DWARF CFI & Windows SEH) verified");
    } else {
        println("FAIL 8: Exception unwinding ABI failure!");
        return 8;
    }

    let p9 = test_tls_and_dynamic_linking();
    if p9 == 1 {
        println("PASS 9: TLS models & dynamic linking (PLT/GOT/IAT) verified");
    } else {
        println("FAIL 9: TLS or dynamic linking stub failure!");
        return 9;
    }

    let p10 = test_debug_and_security_hardening();
    if p10 == 1 {
        println("PASS 10: Debug symbols (DWARF/CodeView) & Security (CFI/W^X/Avalanche) verified");
    } else {
        println("FAIL 10: Debug or security hardening failure!");
        return 10;
    }

    println("=== ALL 10 ABI RESILIENCE INVARIANTS VERIFIED CLEANLY ===");
    return 0;
}

