# C5 Small Module Benchmark (Single-function edit: test_pipeline adds + 10)

fn compute_sum(n: i64): i64 {
    let mut sum = 0;
    let mut i = 0;
    while i <= n {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

fn compute_fact(n: i64): i64 {
    if n <= 1 {
        return 1;
    }
    return n * compute_fact(n - 1);
}

fn is_even(n: i64): i64 {
    if (n % 2) == 0 {
        return 1;
    }
    return 0;
}

fn clamp_val(v: i64, lo: i64, hi: i64): i64 {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn test_pipeline(val: i64): i64 {
    let s = compute_sum(val);
    let f = compute_fact(clamp_val(val, 1, 5));
    let e = is_even(s);
    return s + f + e + 10; # Single-function 1-line mutation
}

fn main(): i64 {
    let res = test_pipeline(5);
    return res;
}
