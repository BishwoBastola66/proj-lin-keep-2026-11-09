# ==============================================================================
# Rix — Lockfile Engine & Integrity Verifier (src/lockfile.bix)
# ==============================================================================

# Compute 16-bit safe deterministic integrity hash
fn lockfile_compute_hash(content: String): String {
    let len = string_length(content)
    mut h = 5381
    mut i = 0
    loop i < len {
        let b = byte_at(content, i)
        let next_h = (h + b * 31) % 65536
        h := next_h
        i := i + 1
    }
    "rix-" + int_to_string(h)
}

# Generate lockfile representation for package and resolved dependencies
fn lockfile_generate(pkg_name: String, version: String, deps_resolved: String): String {
    let raw = pkg_name + version + deps_resolved
    let hash = lockfile_compute_hash(raw)
    
    "# Rix Lockfile — Auto-generated by Rix Package Manager. DO NOT EDIT DIRECTLY.\n" +
    "version = 1\n\n" +
    "[root]\n" +
    "name = \"" + pkg_name + "\"\n" +
    "version = \"" + version + "\"\n" +
    "hash = \"" + hash + "\"\n\n" +
    "[packages]\n" +
    deps_resolved
}

# Verify lockfile checksum integrity
# Returns: 1 if checksum matches, 0 if mismatch or corrupted
fn lockfile_verify_hash(actual_hash: String, expected_hash: String): Integer {
    if actual_hash == expected_hash {
        return 1
    }
    0
}
