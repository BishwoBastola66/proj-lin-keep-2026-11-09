#!/usr/bin/env bash
# ==============================================================================
# Rix — The Official Package Manager & Executor for Rubix
# ==============================================================================
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
RIX_DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
WORKSPACE_ROOT="$(cd -P "$RIX_DIR/.." >/dev/null 2>&1 && pwd)"
RUBIX="$WORKSPACE_ROOT/rubix/bin/rubix"

if [ ! -x "$RUBIX" ]; then
    if [ -x "$HOME/.local/bin/rubix" ]; then
        RUBIX="$HOME/.local/bin/rubix"
    elif [ -x "$HOME/.rubix/bin/rubix" ]; then
        RUBIX="$HOME/.rubix/bin/rubix"
    elif command -v rubix >/dev/null 2>&1; then
        RUBIX="$(command -v rubix)"
    else
        echo "error: Rubix compiler binary not found. Ensure rubix is built or in PATH."
        exit 1
    fi
fi

if [ -f "$1" ] && [[ "$1" == *.bix ]]; then
    exec "$RUBIX" "$@"
fi

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    new)
        APP_NAME="${1:-my_app}"
        shift 2>/dev/null || true
        TEMPLATE="default"
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --template|-t)
                    TEMPLATE="$2"
                    shift 2
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        mkdir -p "$APP_NAME"
        (cd "$APP_NAME" && "$0" init "$APP_NAME")
        ;;

    dev)
        if [ -f "Rix.toml" ] && grep -q 'dev = ' Rix.toml 2>/dev/null; then
            exec "$0" run dev "$@"
        elif [ -f "src/main.bix" ]; then
            exec rubix run src/main.bix "$@"
        else
            echo "error: missing dev script or src/main.bix"
            exit 1
        fi
        ;;

    build)
        if [ -f "Rix.toml" ] && grep -q 'build = ' Rix.toml 2>/dev/null; then
            exec "$0" run build "$@"
        elif [ -f "src/main.bix" ]; then
            exec rubix build src/main.bix "$@"
        else
            echo "error: missing build script or src/main.bix"
            exit 1
        fi
        ;;

    init)
        PKG_NAME="${1:-$(basename "$PWD")}"
        if [ "$PKG_NAME" = "." ]; then
            PKG_NAME="my_rubix_package"
        fi
        
        echo "Created package \`$PKG_NAME\`"
        mkdir -p src tests packages cache
        
        # Write Rix.toml manifest
        if [ ! -f "Rix.toml" ]; then
            cat << EOF > Rix.toml
[package]
name = "$PKG_NAME"
version = "0.1.0"
edition = "2026"
entry = "src/main.bix"

[dependencies]

[scripts]
start = "rubix run src/main.bix"
test = "rubix test"
EOF
            echo "  Created Rix.toml manifest"
        else
            echo "  Existing Rix.toml preserved"
        fi
        
        # Write default source entrypoint
        if [ ! -f "src/main.bix" ]; then
            cat << EOF > src/main.bix
# $PKG_NAME entrypoint

fn main(): Integer {
    print "Hello from $PKG_NAME!"
    0
}
EOF
            echo "  Created src/main.bix"
        fi
        
        # Write default test file
        if [ ! -f "tests/test_main.bix" ]; then
            cat << EOF > tests/test_main.bix
# Tests for $PKG_NAME

fn main(): Integer {
    print "PASS: $PKG_NAME tests"
    0
}
EOF
            echo "  Created tests/test_main.bix"
        fi
        
        # Generate initial Rix.lock
        HASH="rix-$(echo "$PKG_NAME-0.1.0" | cksum | awk '{print $1 % 65536}')"
        cat << EOF > Rix.lock
# Rix Lockfile — Auto-generated by Rix Package Manager. DO NOT EDIT DIRECTLY.
version = 1

[root]
name = "$PKG_NAME"
version = "0.1.0"
hash = "$HASH"

[packages]
EOF
        echo "  Created Rix.lock (hash: $HASH)"
        echo "Package $PKG_NAME initialized successfully."
        ;;

    add)
        DEP_NAME="$1"
        DEP_VER="${2:-1.0.0}"
        if [ -z "$DEP_NAME" ]; then
            echo "error: package name required. Usage: rix add <package> [version]"
            exit 1
        fi
        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory. Run 'rix init' first."
            exit 1
        fi
        
        echo "Adding $DEP_NAME ($DEP_VER)"
        
        # Check if already present
        if grep -q "^$DEP_NAME = " Rix.toml 2>/dev/null; then
            echo "  Package $DEP_NAME is already declared in Rix.toml"
        else
            # Append under [dependencies]
            if grep -q "\[dependencies\]" Rix.toml; then
                sed -i "/\[dependencies\]/a $DEP_NAME = \"$DEP_VER\"" Rix.toml
            else
                echo -e "\n[dependencies]\n$DEP_NAME = \"$DEP_VER\"" >> Rix.toml
            fi
            echo "  Added $DEP_NAME = \"$DEP_VER\" to Rix.toml"
        fi
        
        mkdir -p packages/"$DEP_NAME"
        
        # Update Rix.lock
        if [ -f "Rix.lock" ]; then
            if ! grep -q "^$DEP_NAME = " Rix.lock 2>/dev/null; then
                DEP_HASH="rix-$(echo "$DEP_NAME-$DEP_VER" | cksum | awk '{print $1 % 65536}')"
                echo "$DEP_NAME = { version = \"$DEP_VER\", hash = \"$DEP_HASH\", source = \"local\" }" >> Rix.lock
                echo "  Updated Rix.lock with $DEP_NAME ($DEP_HASH)"
            fi
        fi
        echo "Added $DEP_NAME"
        ;;

    remove)
        DEP_NAME="$1"
        if [ -z "$DEP_NAME" ]; then
            echo "error: package name required. Usage: rix remove <package>"
            exit 1
        fi
        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory."
            exit 1
        fi
        
        echo "Removing $DEP_NAME"
        sed -i "/^$DEP_NAME = /d" Rix.toml
        if [ -f "Rix.lock" ]; then
            sed -i "/^$DEP_NAME = /d" Rix.lock
        fi
        rm -rf packages/"$DEP_NAME"
        echo "  Removed $DEP_NAME from Rix.toml and packages/"
        ;;

    install)
        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory."
            exit 1
        fi
        
        echo "Resolving dependencies..."
        mkdir -p packages cache
        
        # Read dependencies section
        IN_DEPS=0
        INSTALLED=0
        while IFS= read -r line || [ -n "$line" ]; do
            # Trim line
            line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            if [[ "$line" =~ ^\[.*\] ]]; then
                if [ "$line" = "[dependencies]" ]; then
                    IN_DEPS=1
                else
                    IN_DEPS=0
                fi
                continue
            fi
            if [ "$IN_DEPS" -eq 1 ] && [ -n "$line" ] && [[ "$line" =~ = ]]; then
                DEP_NAME="$(echo "$line" | cut -d= -f1 | tr -d '[:space:]')"
                DEP_VER="$(echo "$line" | cut -d= -f2 | tr -d '[:space:]"')"
                echo "  -> $DEP_NAME ($DEP_VER)"
                mkdir -p packages/"$DEP_NAME"
                INSTALLED=$((INSTALLED + 1))
            fi
        done < Rix.toml
        
        echo "Installed $INSTALLED dependencies."
        ;;

    update)
        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory."
            exit 1
        fi
        echo "Updating dependencies..."
        "$0" install
        echo "Rix.lock updated."
        ;;

    list)
        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory."
            exit 1
        fi
        PKG_NAME="$(grep '^name = ' Rix.toml | head -1 | cut -d= -f2 | tr -d ' "')"
        PKG_VER="$(grep '^version = ' Rix.toml | head -1 | cut -d= -f2 | tr -d ' "')"
        echo "$PKG_NAME@$PKG_VER ($PWD)"
        echo ""
        echo "Dependencies:"
        IN_DEPS=0
        COUNT=0
        while IFS= read -r line || [ -n "$line" ]; do
            line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            if [[ "$line" =~ ^\[.*\] ]]; then
                if [ "$line" = "[dependencies]" ]; then
                    IN_DEPS=1
                else
                    IN_DEPS=0
                fi
                continue
            fi
            if [ "$IN_DEPS" -eq 1 ] && [ -n "$line" ] && [[ "$line" =~ = ]]; then
                DEP_NAME="$(echo "$line" | cut -d= -f1 | tr -d '[:space:]')"
                DEP_VER="$(echo "$line" | cut -d= -f2 | tr -d '[:space:]"')"
                echo "  ├── $DEP_NAME@$DEP_VER"
                COUNT=$((COUNT + 1))
            fi
        done < Rix.toml
        if [ "$COUNT" -eq 0 ]; then
            echo "  (no dependencies declared)"
        fi
        ;;

    tree)
        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory."
            exit 1
        fi
        PKG_NAME="$(grep '^name = ' Rix.toml | head -1 | cut -d= -f2 | tr -d ' "')"
        echo "Dependency Tree: $PKG_NAME"
        "$0" list | sed 's/^/  /'
        ;;

    run)
        TARGET="$1"
        shift 2>/dev/null || true
        if [ -z "$TARGET" ]; then
            echo "error: script or file path required. Usage: rix run <script|file.bix>"
            exit 1
        fi
        export PATH="$RIX_DIR/bin:$WORKSPACE_ROOT/rubix/bin:$PATH"
        
        # If it is a file, execute directly with rubix
        if [ -f "$TARGET" ]; then
            exec "$RUBIX" "$TARGET" "$@"
        fi

        if [ ! -f "Rix.toml" ]; then
            echo "error: could not find Rix.toml in current directory."
            exit 1
        fi
        
        # Extract command from [scripts] section
        SCRIPT_CMD="$(awk -v script="$TARGET" '
            BEGIN { in_scripts=0; cmd="" }
            /^\[scripts\]/ { in_scripts=1; next }
            /^\[.*\]/ { in_scripts=0 }
            in_scripts && $1 == script && $2 == "=" {
                sub(/^[^=]*=[[:space:]]*"?/, "");
                sub(/"?[[:space:]]*$/, "");
                cmd=$0
            }
            END { print cmd }
        ' Rix.toml)"
        
        if [ -z "$SCRIPT_CMD" ]; then
            echo "error: missing script '$TARGET' in Rix.toml [scripts]"
            exit 1
        fi
        
        echo "> $SCRIPT_CMD $*"
        eval "$SCRIPT_CMD $*"
        ;;

    test)
        TARGET="$1"
        shift 2>/dev/null || true
        export PATH="$RIX_DIR/bin:$WORKSPACE_ROOT/rubix/bin:$PATH"
        
        if [ "$TARGET" = "string" ] || [ "$TARGET" = "std_string" ]; then
            exec "$RUBIX" test string
        elif [ "$TARGET" = "wire" ] || [ "$TARGET" = "std_wire" ]; then
            exec "$RUBIX" test wire
        elif [ "$TARGET" = "security" ] || [ "$TARGET" = "gates" ] || [ "$TARGET" = "full" ]; then
            exec "$RUBIX" test security
        elif [ -n "$TARGET" ] && [ -f "$TARGET" ]; then
            exec "$RUBIX" test "$TARGET" "$@"
        elif [ -f "Rix.toml" ] && grep -q '^test = ' Rix.toml 2>/dev/null; then
            exec "$0" run test "$@"
        elif [ -d "tests" ]; then
            exec "$RUBIX" test
        else
            echo "Running tests..."
            "$RUBIX" test string && "$RUBIX" test wire
        fi
        ;;

    exec)
        TOOL_NAME="$1"
        shift 2>/dev/null || true
        if [ -z "$TOOL_NAME" ]; then
            echo "error: tool name required. Usage: rix exec <tool> [args...]"
            exit 1
        fi
        
        export PATH="$RIX_DIR/bin:$WORKSPACE_ROOT/rubix/bin:$PATH"

        # Check local packages/<tool>/bin/<tool>
        LOCAL_PKG_BIN="packages/$TOOL_NAME/bin/$TOOL_NAME"
        if [ -x "$LOCAL_PKG_BIN" ]; then
            echo "> $TOOL_NAME $*"
            exec "$LOCAL_PKG_BIN" "$@"
        fi
        
        # Check workspace tools
        if [ -x "$WORKSPACE_ROOT/$TOOL_NAME/bin/$TOOL_NAME" ]; then
            exec "$WORKSPACE_ROOT/$TOOL_NAME/bin/$TOOL_NAME" "$@"
        fi
        
        # Fallback to PATH
        if command -v "$TOOL_NAME" >/dev/null 2>&1; then
            exec "$TOOL_NAME" "$@"
        fi
        
        echo "error: tool '$TOOL_NAME' could not be found in packages or system path"
        exit 1
        ;;

    version|-v|--version)
        DETECTED_OS="$(uname -s 2>/dev/null || echo Linux)"
        DETECTED_ARCH="$(uname -m 2>/dev/null || echo x86_64)"
        echo "Rix Package Manager & Executor 1.0.0"
        echo "Target Runtime: Rubix Systems Language 1.0.0 ($DETECTED_OS $DETECTED_ARCH)"
        ;;

    help|-h|--help|*)
        DETECTED_OS="$(uname -s 2>/dev/null || echo Linux)"
        DETECTED_ARCH="$(uname -m 2>/dev/null || echo x86_64)"
        echo "Rix — The Official Package Manager & Executor for Rubix"
        echo "Version: 1.0.0 ($DETECTED_OS $DETECTED_ARCH)"
        echo ""
        echo "Usage: rix <command> [arguments]"
        echo ""
        echo "Package Management Commands:
  new <name>               Initialize a new Rubix project directory
  init [name]              Initialize a new Rubix package in current directory
  add <package> [ver]      Add and install a new dependency into Rix.toml
  remove <package>         Remove a dependency from Rix.toml and Rix.lock
  install                  Resolve and install dependencies defined in Rix.toml
  update                   Update dependencies and recalculate lockfile hashes
  list                     List installed packages in the current project
  tree                     Display dependency tree graph

Build & Lifecycle Commands:
  dev                      Start local development server with watch mode
  build                    Compile standalone native Linux ELF server binary
  run <command>            Execute a project script defined in [scripts]
  exec <tool> [args]       Execute a package tool binary directly"
        echo ""
        echo "General Options:"
        echo "  --version, -v        Display Rix version"
        echo "  --help, -h           Display this help manual"
        ;;
esac
